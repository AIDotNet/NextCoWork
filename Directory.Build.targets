<Project>
  <!--
    把 NativeAOT 编译器和运行时包固定到已修补的服务版本:GHSA-p3jp-9v83-76w9 / CVE-2026-111497(.NET Brotli 解码越界写)
    在 10.0.14 修复,而本机 SDK(10.0.401)只认得 10.0.12。不固定的话 AOT 发布会因 NU1903 失败(警告即错误)。
    做法同 Jaunt 的 Directory.Build.targets。SDK 升级到带 10.0.14+ 的版本后可以去掉。
  -->
  <PropertyGroup>
    <NcwPatchedRuntime10>10.0.15</NcwPatchedRuntime10>
  </PropertyGroup>
  <Target Name="NcwPinServicingPacks" BeforeTargets="ProcessFrameworkReferences;_ComputeToolPackInputsToProcessFrameworkReferences">
    <ItemGroup>
      <KnownILCompilerPack Update="Microsoft.DotNet.ILCompiler" Condition="'%(TargetFramework)' == 'net10.0'" ILCompilerPackVersion="$(NcwPatchedRuntime10)" />
      <KnownFrameworkReference Update="Microsoft.NETCore.App" Condition="'%(TargetFramework)' == 'net10.0'" LatestRuntimeFrameworkVersion="$(NcwPatchedRuntime10)" />
      <KnownRuntimePack Update="Microsoft.NETCore.App" Condition="'%(TargetFramework)' == 'net10.0'" LatestRuntimeFrameworkVersion="$(NcwPatchedRuntime10)" />
    </ItemGroup>
  </Target>
</Project>
