{
  "publisher": "ncw",
  "name": "sheets",
  "displayName": "表格",
  "description": "Excel 表格编辑器:与 Agent 编辑同一份活动文档。需要先安装文档引擎 ncw.office-runtime:到 https://github.com/AIDotNet/ncw-office-runtime/releases/latest 下载对应系统的 ZIP,再在扩展 → 安装插件里选它。",
  "version": "0.1.1",
  "license": "Apache-2.0",
  "icon": "assets/icon.png",
  "categories": ["编辑器"],
  "keywords": ["xlsx", "excel", "spreadsheet", "office"],
  "engines": { "nextcowork": "^0.3.3" },
  "main": "./dist/extension.js",
  "source": "src/extension.ts",
  "l10n": "./l10n",
  "activationEvents": ["onCustomEditor:ncw.sheets.xlsx"],
  "dependencies": { "ncw.office-runtime": "^0.1.0" },
  "permissions": [],
  "optionalPermissions": [],
  "hostPermissions": [],
  "views": {
    "view/editor.tsx": "dist/view/editor.js"
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "ncw.sheets.xlsx",
        "displayName": "%sheets.editorName%",
        "selector": [{ "filenamePattern": "*.xlsx" }, { "filenamePattern": "*.xlsm" }],
        "priority": "default",
        "viewId": "ncw.sheets.view",
        "documentEngine": "ncw.office-runtime/office"
      }
    ],
    "views": [
      {
        "id": "ncw.sheets.view",
        "title": "%sheets.editorName%",
        "icon": "table",
        "path": "dist/view/editor.html",
        "location": "editor"
      }
    ]
  },
  "scripts": {
    "build": "node build.mjs"
  }
}
