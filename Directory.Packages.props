<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Arc 1.1.0 按 Avalonia 12.1.5 构建:所有 Avalonia 包必须保持在同一个版本。 -->
    <!-- 远程连接:TLS 1.3 双向认证 + SRP-6a 配对(纯托管,各平台同一实现,见 docs/design/09 §4) -->
    <PackageVersion Include="BouncyCastle.Cryptography" Version="2.6.2" />
    <PackageVersion Include="Avalonia" Version="12.1.5" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.5" />
    <PackageVersion Include="Avalonia.Skia" Version="12.1.5" />
    <PackageVersion Include="Avalonia.Headless" Version="12.1.5" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="12.1.5" />
    <PackageVersion Include="TKCode.Arc" Version="1.1.0" />
    <PackageVersion Include="TKCode.Arc.Blocks" Version="1.1.0" />
    <PackageVersion Include="TKCode.Arc.Fonts" Version="1.1.0" />
    <PackageVersion Include="TKCode.Arc.Icons.Lucide" Version="1.1.0" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- 设备协议的编解码:PolyType 源生成,NativeAOT 零警告(MessagePack-CSharp 3.x 在 AOT 下有警告且多态帧不可用,已实测排除)。 -->
    <PackageVersion Include="Nerdbank.MessagePack" Version="1.4.104" />
    <!-- 10.0.15 依赖 SQLitePCLRaw 2.1.13;10.0.0 带的 2.1.11 有已知漏洞(GHSA-2m69-gcr7-jv3q)。NativeAOT 下实测零警告。 -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.15" />
    <!-- 测试 -->
    <!-- Avalonia.Headless.XUnit 12.1.5 基于 xunit v3(extensibility 3.2.x),测试统一用 xunit v3 3.2.x。 -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>
