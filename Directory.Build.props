<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Ncw.* 全部要能裁剪、能 NativeAOT(AGENTS.md §2)。库项目开启分析器,发布时零裁剪警告。 -->
    <IsAotCompatible Condition="'$(IsTestProject)' != 'true'">true</IsAotCompatible>
    <InvariantGlobalization>false</InvariantGlobalization>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <!-- .NET 11 SDK 的优化 AOT 发布会丢掉 Avalonia 预编译的 XAML("No precompiled XAML found")。 -->
    <UseOptimizedPublish>false</UseOptimizedPublish>
    <Company>NextCoWork</Company>
    <Product>NextCoWork</Product>
    <Version>3.0.1</Version>
  </PropertyGroup>
</Project>
