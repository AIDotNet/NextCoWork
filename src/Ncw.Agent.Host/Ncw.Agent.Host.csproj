  <PropertyGroup>
    <!-- LibraryImport(realpath)需要;生成的封送代码是安全的,本项目手写代码里没有 unsafe 块。 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Ncw.Core/Ncw.Core.csproj" />
    <ProjectReference Include="../Ncw.Protocol/Ncw.Protocol.csproj" />
    <ProjectReference Include="../Ncw.Agent.Storage/Ncw.Agent.Storage.csproj" />
  </ItemGroup>
</Project>
