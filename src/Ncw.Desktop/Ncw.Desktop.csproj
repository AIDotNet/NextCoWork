<Project Sdk="Microsoft.NET.Sdk">
  <!-- 桌面宿主:窗口、sidecar(本机 Agent)管理;托盘、Velopack 更新在后续里程碑。 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>NextCoWork</AssemblyName>
    <!-- 钥匙串 / DPAPI 的 LibraryImport 封送代码需要 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Ncw.UI/Ncw.UI.csproj" />
    <!--
      只为了构建顺序和打包 sidecar:不引用 Agent 的代码(ReferenceOutputAssembly=false),
      客户端与 Agent 之间只通过设备协议通信(AGENTS.md §5)。
    -->
    <ProjectReference Include="../Ncw.Agent/Ncw.Agent.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <!-- 开发构建:把 ncw-agent 的输出整目录复制到 <输出>/agent/,和桌面端的依赖互不干扰。发布包里换成 NativeAOT 产物(可执行文件 + e_sqlite3 原生库)。 -->
  <Target Name="CopyAgentSidecar" AfterTargets="Build">
    <ItemGroup>
      <_NcwAgentFiles Include="$(MSBuildThisFileDirectory)../Ncw.Agent/bin/$(Configuration)/$(TargetFramework)/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_NcwAgentFiles)" DestinationFolder="$(OutDir)agent/%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
