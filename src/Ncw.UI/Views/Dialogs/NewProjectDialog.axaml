<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Ncw.UI.Localization"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:ui="using:Ncw.UI.Controls"
             xmlns:cv="using:Ncw.UI.Converters"
             xmlns:vm="using:Ncw.Client.ViewModels"
             x:Class="Ncw.UI.Views.Dialogs.NewProjectDialog"
             x:DataType="vm:NewProjectViewModel">
  <!--
    「新建项目」窗口的内容(docs/design/03 §1「栏 1」;标题、按钮由 NcwDialogService 的 Arc Dialog 提供):
    设备(已连接、能添加项目的)→ 那台设备上的文件夹路径(本机可以「浏览…」,其他设备手填绝对路径)→ 可选的名字。出错不关窗口,原因显示在下面。
  -->
  <StackPanel Spacing="14" Margin="0,4,0,0">
    <!-- 没有可用的设备 -->
    <Border Classes="card" IsVisible="{Binding !HasDevices}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <lucide:LucideIcon Kind="WifiOff" Size="14" VerticalAlignment="Center" Foreground="{arc:ArcDesignTokenResource TextMuted}" />
        <TextBlock Classes="hint" TextWrapping="Wrap" Text="{l:NcwText NewProjectNoDevice}" />
      </StackPanel>
    </Border>

    <ui:NcwSelect x:Name="DeviceSelect" HorizontalAlignment="Stretch" IsVisible="{Binding HasDevices}"
                  Label="{l:NcwText NewProjectDevice}"
                  ItemsSource="{Binding Devices}" SelectedValue="{Binding DeviceId, Mode=TwoWay}"
                  AutomationProperties.Name="{l:NcwText NewProjectDevice}" />

    <StackPanel Spacing="6" IsVisible="{Binding HasDevices}">
      <DockPanel>
        <ui:NcwButton DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Bottom" Variant="Secondary"
                      IsVisible="{Binding CanBrowse}" Command="{Binding BrowseCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <lucide:LucideIcon Kind="FolderOpen" Size="14" VerticalAlignment="Center" />
            <TextBlock Text="{l:NcwText NewProjectBrowse}" VerticalAlignment="Center" />
          </StackPanel>
        </ui:NcwButton>
        <ui:NcwInput x:Name="PathInput" Label="{l:NcwText NewProjectPath}" Text="{Binding Path, Mode=TwoWay}"
                     Placeholder="{l:NcwText NewProjectPathPlaceholder}" />
      </DockPanel>
      <TextBlock Classes="hint" TextWrapping="Wrap" IsVisible="{Binding IsRemoteDevice}" Text="{l:NcwText NewProjectRemotePathHint}" />
    </StackPanel>

    <ui:NcwInput IsVisible="{Binding HasDevices}" Label="{l:NcwText NewProjectName}" Text="{Binding Name, Mode=TwoWay}"
                 Placeholder="{l:NcwText NewProjectNamePlaceholder}" />

    <!-- 出错:按原因出文字(设备给的英文诊断只进日志,不直接给用户看) -->
    <TextBlock TextWrapping="Wrap" Foreground="{arc:ArcDesignTokenResource Danger}" IsVisible="{Binding HasError}"
               Text="{Binding Error, Converter={x:Static cv:KeyTextConverter.Instance}, ConverterParameter=NewProjectError}" />
  </StackPanel>
</UserControl>
