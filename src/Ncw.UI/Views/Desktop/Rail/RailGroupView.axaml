<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:ui="using:Ncw.UI.Controls"
             xmlns:cv="using:Ncw.UI.Converters"
             xmlns:vm="using:Ncw.Client.ViewModels"
             xmlns:rail="using:Ncw.UI.Views.Desktop.Rail"
             x:Class="Ncw.UI.Views.Desktop.Rail.RailGroupView"
             x:DataType="vm:RailGroupViewModel">
  <!-- 项目组:展开时是一块带底色的胶囊,收起时是 2×2 迷你网格 -->
  <Border Margin="8,4"
          Padding="0,4"
          CornerRadius="16"
          Background="{Binding Color, Converter={x:Static cv:HexBrushConverter.Instance}, ConverterParameter=0.22}">
    <StackPanel>
      <!-- 展开状态 -->
      <StackPanel IsVisible="{Binding !IsCollapsed}">
        <ui:PlainButton Height="22"
                        Margin="6,0"
                        Command="{Binding ToggleCommand}"
                        AutomationProperties.Name="{Binding Name}">
          <lucide:LucideIcon Kind="FolderOpen"
                             Size="13"
                             HorizontalAlignment="Center"
                             Foreground="{Binding Color, Converter={x:Static cv:HexBrushConverter.Instance}}" />
        </ui:PlainButton>
        <ItemsControl ItemsSource="{Binding Members}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:RailProjectViewModel">
              <rail:RailProjectTile />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
      <!-- 收起状态 -->
      <Grid Height="54" IsVisible="{Binding IsCollapsed}">
        <ui:PlainButton Classes="tile"
                        Width="40"
                        Height="40"
                        HorizontalAlignment="Center"
                        Command="{Binding ToggleCommand}"
                        AutomationProperties.Name="{Binding Name}">
          <Panel>
            <Border CornerRadius="12" Background="{arc:ArcDesignTokenResource SurfaceRaised}" Padding="5">
              <ItemsControl ItemsSource="{Binding Preview}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="2" Rows="2" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:RailProjectViewModel">
                    <Border Margin="1"
                            CornerRadius="4"
                            Background="{Binding Color, Converter={x:Static cv:HexBrushConverter.Instance}}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
            <Border MinWidth="16"
                    Height="16"
                    Padding="4,0"
                    CornerRadius="8"
                    Margin="0,-5,-6,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="{arc:ArcDesignTokenResource Danger}"
                    IsVisible="{Binding HasPending}">
              <TextBlock Text="{Binding PendingCount, Converter={x:Static cv:CountConverter.Instance}}"
                         FontSize="10"
                         FontWeight="SemiBold"
                         Foreground="White"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </Border>
          </Panel>
        </ui:PlainButton>
      </Grid>
    </StackPanel>
  </Border>
</UserControl>
