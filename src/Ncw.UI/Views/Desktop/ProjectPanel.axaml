<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Ncw.UI.Localization"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:ui="using:Ncw.UI.Controls"
             xmlns:cv="using:Ncw.UI.Converters"
             xmlns:vm="using:Ncw.Client.ViewModels"
             xmlns:conv="using:Ncw.UI.Views.Desktop.Conversation"
             x:Class="Ncw.UI.Views.Desktop.ProjectPanel"
             x:DataType="vm:ProjectPanelViewModel">
  <!-- 栏 2:项目面板(docs/design/03 §1) -->
  <UserControl.Styles>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
      <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
    </Style>
  </UserControl.Styles>

  <Panel>
  <!-- 没有项目时的空状态:与项目栏的「+」是同一个动作 -->
  <StackPanel IsVisible="{Binding !HasProject}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" Margin="24">
    <lucide:LucideIcon Kind="FolderPlus" Size="28" HorizontalAlignment="Center" Foreground="{arc:ArcDesignTokenResource TextMuted}" />
    <TextBlock Text="{l:NcwText NoProjectsTitle}" HorizontalAlignment="Center" FontWeight="SemiBold" />
    <TextBlock Classes="muted" Text="{l:NcwText NoProjectsHint}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
    <ui:NcwButton HorizontalAlignment="Center" Variant="Primary" Command="{Binding AddProjectCommand}" Content="{l:NcwText AddFolder}" />
  </StackPanel>
  <Grid RowDefinitions="Auto,Auto,*" IsVisible="{Binding HasProject}">
    <!-- 头部:项目名、路径、所在设备与执行环境、分支 -->
    <StackPanel Grid.Row="0" Margin="16,14,16,10" Spacing="4">
      <ui:PlainButton Padding="4,2" Margin="-4,0" HorizontalAlignment="Left">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="{Binding Name}"
                     FontSize="{arc:ArcDesignTokenResource TypeLG}"
                     FontWeight="SemiBold" />
          <lucide:LucideIcon Kind="ChevronDown" Size="14" VerticalAlignment="Center" />
        </StackPanel>
      </ui:PlainButton>
      <TextBlock Classes="muted"
                 Text="{Binding Path}"
                 FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                 TextTrimming="CharacterEllipsis" />
      <WrapPanel Orientation="Horizontal" Margin="0,2,0,0">
        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,10,0">
          <lucide:LucideIcon Kind="Monitor" Size="12" VerticalAlignment="Center" Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
          <TextBlock Classes="muted" Text="{Binding DeviceName}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,10,0" IsVisible="{Binding IsSsh}">
          <lucide:LucideIcon Kind="Link" Size="12" VerticalAlignment="Center" Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
          <TextBlock Classes="muted" Text="{Binding EnvironmentName}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding Branch, Converter={x:Static ObjectConverters.IsNotNull}}">
          <lucide:LucideIcon Kind="GitBranch" Size="12" VerticalAlignment="Center" Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
          <TextBlock Classes="muted" Text="{Binding Branch}" />
          <lucide:LucideIcon Kind="Check" Size="12" VerticalAlignment="Center"
                             Foreground="{arc:ArcDesignTokenResource Success}"
                             IsVisible="{Binding WorkingTreeClean}" />
          <Border Width="7" Height="7" CornerRadius="4" VerticalAlignment="Center"
                  Background="{arc:ArcDesignTokenResource Warning}"
                  IsVisible="{Binding !WorkingTreeClean}" />
        </StackPanel>
      </WrapPanel>
    </StackPanel>

    <!-- 搜索 -->
    <ui:NcwSearchField Grid.Row="1" Margin="12,0,12,8" Text="{Binding SearchText}" PlaceholderText="{l:NcwText SearchInProject}" />

    <ScrollViewer Grid.Row="2">
      <StackPanel Margin="8,4,8,12" Spacing="2">
        <!-- 会话:sessions.list 的镜像;运行状态点来自 activeRuns 的权威广播(Core 的 SessionActivityView),设备断开时是「未知」 -->
        <!-- 分区可以折叠(设计 03 §1「栏 2」;NcwSection,展开状态是纯 UI 状态) -->
        <ui:NcwSection Margin="0,2,0,0">
          <ui:NcwSection.Header><TextBlock Classes="section" Text="{l:NcwText Sessions}" /></ui:NcwSection.Header>
          <ui:NcwSection.Trailing>
            <StackPanel Orientation="Horizontal" Margin="0,0,4,0">
              <ui:PlainButton Width="24" Height="24" Command="{Binding ToggleArchivedCommand}" Classes.active="{Binding ShowArchived}"
                              AutomationProperties.Name="{l:NcwText ShowArchived}" arc:Tooltip.Tip="{l:NcwText ShowArchived}">
                <lucide:LucideIcon Kind="Archive" Size="13" HorizontalAlignment="Center" />
              </ui:PlainButton>
              <ui:PlainButton Width="24" Height="24" Command="{Binding NewSessionCommand}" AutomationProperties.Name="{l:NcwText NewSession}" arc:Tooltip.Tip="{l:NcwText NewSession}">
                <lucide:LucideIcon Kind="Plus" Size="14" HorizontalAlignment="Center" />
              </ui:PlainButton>
            </StackPanel>
          </ui:NcwSection.Trailing>
          <StackPanel>
            <TextBlock Classes="muted" Margin="8,2" TextWrapping="Wrap" IsVisible="{Binding ShowsEmptyHint}" Text="{l:NcwText NoSessionsHint}" />
            <TextBlock Classes="muted" Margin="8,2" TextWrapping="Wrap" IsVisible="{Binding ShowsNoMatch}" Text="{l:NcwText NoMatchingSessions}" />
            <ItemsControl ItemsSource="{Binding Sessions}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:SessionItemViewModel">
                  <conv:SessionRow />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ui:NcwSection>

        <!-- 终端和智能体 -->
        <ui:NcwSection Margin="0,10,0,0">
          <ui:NcwSection.Header><TextBlock Classes="section" Text="{l:NcwText TerminalsAndAgents}" /></ui:NcwSection.Header>
          <ui:NcwSection.Trailing>
            <ui:PlainButton Width="24" Height="24" Margin="0,0,4,0" AutomationProperties.Name="{l:NcwText NewTerminal}" arc:Tooltip.Tip="{l:NcwText NewTerminal}">
              <lucide:LucideIcon Kind="Plus" Size="14" HorizontalAlignment="Center" />
            </ui:PlainButton>
          </ui:NcwSection.Trailing>
          <ItemsControl ItemsSource="{Binding Terminals}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:TerminalItemViewModel">
                <ui:PlainButton Padding="8,7">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Panel Width="14">
                      <lucide:LucideIcon Kind="Bot" Size="14" IsVisible="{Binding IsExternalAgent}"
                                         Foreground="{arc:ArcDesignTokenResource Accent}" />
                      <lucide:LucideIcon Kind="SquareTerminal" Size="14" IsVisible="{Binding !IsExternalAgent}" />
                    </Panel>
                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                  </StackPanel>
                </ui:PlainButton>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ui:NcwSection>

        <!-- 其他入口 -->
        <TextBlock Classes="section" Text="{l:NcwText ProjectSection}" Margin="8,14,4,4" />
        <ui:PlainButton Padding="8,7">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <lucide:LucideIcon Kind="Folder" Size="14" />
            <TextBlock Text="{l:NcwText TabFiles}" />
          </StackPanel>
        </ui:PlainButton>
        <ui:PlainButton Padding="8,7">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <lucide:LucideIcon Kind="GitCompare" Size="14" />
            <TextBlock Text="{l:NcwText GitChanges}" />
          </StackPanel>
        </ui:PlainButton>
        <ui:PlainButton Padding="8,7" Command="{Binding OpenScheduledTasksCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <lucide:LucideIcon Kind="CalendarClock" Size="14" />
            <TextBlock Text="{l:NcwText ScheduledTasks}" />
          </StackPanel>
        </ui:PlainButton>
      </StackPanel>
    </ScrollViewer>
  </Grid>
  </Panel>
</UserControl>
