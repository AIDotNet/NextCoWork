<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Ncw.UI.Localization"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:ui="using:Ncw.UI.Controls"
             xmlns:vm="using:Ncw.Client.ViewModels"
             x:Class="Ncw.UI.Views.Desktop.WorkspaceArea"
             x:DataType="vm:ShellViewModel">
  <!-- 栏 3:主工作区。标签栏 + 内容 + 输入框(会话内容在 M4 接入)。 -->
  <Grid RowDefinitions="40,*,Auto">
    <!-- 标签栏 = 窗口顶部这一行(空白处拖动窗口)。左右留白由外壳按左侧区域、检查器的显隐设置。 -->
    <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}">
      <Grid x:Name="TabRow" ColumnDefinitions="*,Auto" Margin="8,0">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <ItemsControl ItemsSource="{Binding Workspace.Tabs}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="4" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:WorkspaceTabViewModel">
                <ui:PlainButton Height="30" Padding="10,0,6,0" VerticalAlignment="Center"
                                Classes.active="{Binding IsActive}"
                                Command="{Binding $parent[ItemsControl].((vm:ShellViewModel)DataContext).Workspace.ActivateCommand}"
                                CommandParameter="{Binding}">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <Panel Width="14" VerticalAlignment="Center">
                      <lucide:LucideIcon Kind="MessageSquare" Size="13" IsVisible="{Binding IsSession}" />
                      <lucide:LucideIcon Kind="SquareTerminal" Size="13" IsVisible="{Binding IsTerminal}" />
                    </Panel>
                    <TextBlock Text="{Binding Title}" MaxWidth="200" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <ui:PlainButton Width="18" Height="18" CornerRadius="5"
                                    Command="{Binding $parent[ItemsControl].((vm:ShellViewModel)DataContext).Workspace.CloseCommand}"
                                    CommandParameter="{Binding}"
                                    AutomationProperties.Name="{l:NcwText CloseTab}">
                      <lucide:LucideIcon Kind="X" Size="11" HorizontalAlignment="Center" />
                    </ui:PlainButton>
                  </StackPanel>
                </ui:PlainButton>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ui:NcwButton Classes="icon" Variant="Ghost" AutomationProperties.Name="{l:NcwText NewTab}" arc:Tooltip.Tip="{l:NcwText NewTab}">
            <lucide:LucideIcon Kind="Plus" Size="15" />
          </ui:NcwButton>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
          <ui:NcwButton Classes="icon" Variant="Ghost" AutomationProperties.Name="{l:NcwText More}" arc:Tooltip.Tip="{l:NcwText More}">
            <lucide:LucideIcon Kind="Ellipsis" Size="16" />
          </ui:NcwButton>
          <StackPanel Orientation="Horizontal" Spacing="5" Margin="8,0" VerticalAlignment="Center"
                      arc:Tooltip.Tip="{l:NcwText ContextUsage}">
            <lucide:LucideIcon Kind="LoaderCircle" Size="14" Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
            <TextBlock Classes="caption">
              <Run Text="{Binding Workspace.ContextPercent}" /><Run Text="%" />
            </TextBlock>
          </StackPanel>
          <ui:NcwButton Classes="icon" Variant="Ghost" AutomationProperties.Name="{l:NcwText SplitRight}" arc:Tooltip.Tip="{l:NcwText SplitRight}">
            <lucide:LucideIcon Kind="Columns2" Size="16" />
          </ui:NcwButton>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 内容:M1 占位 -->
    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="520">
      <lucide:LucideIcon Kind="Sparkles" Size="28" HorizontalAlignment="Center" Foreground="{arc:ArcDesignTokenResource TextMuted}" />
      <TextBlock HorizontalAlignment="Center"
                 FontSize="{arc:ArcDesignTokenResource TypeLG}"
                 FontWeight="SemiBold"
                 Text="{Binding Workspace.ActiveTab.Title}"
                 TextWrapping="Wrap"
                 TextAlignment="Center" />
      <TextBlock HorizontalAlignment="Center"
                 Foreground="{arc:ArcDesignTokenResource TextMuted}"
                 Text="{l:NcwText SessionContentPlaceholder}" />
    </StackPanel>

    <!-- 输入框 -->
    <Border Grid.Row="2"
            Margin="16,0,16,16"
            Padding="12,10"
            CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
            BorderThickness="1"
            BorderBrush="{arc:ArcDesignTokenResource Border}"
            Background="{arc:ArcDesignTokenResource Surface}"
            MaxWidth="{arc:ArcDesignTokenResource ContentMaxWidthLG}">
      <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
        <ui:NcwTextArea Text="{Binding Workspace.Draft}" PlaceholderText="{l:NcwText ComposerPlaceholder}" FrameMinHeight="56" IsResizable="False" />
        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="6">
          <ui:PlainButton Width="30" Height="30" AutomationProperties.Name="{l:NcwText AddAttachment}" arc:Tooltip.Tip="{l:NcwText AddAttachment}">
            <lucide:LucideIcon Kind="Paperclip" Size="15" HorizontalAlignment="Center" />
          </ui:PlainButton>
          <ui:PlainButton Grid.Column="1" Height="30" Padding="8,0">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Text="claude-opus-5-5" FontSize="{arc:ArcDesignTokenResource TypeXS}" VerticalAlignment="Center" />
              <lucide:LucideIcon Kind="ChevronDown" Size="12" VerticalAlignment="Center" />
            </StackPanel>
          </ui:PlainButton>
          <ui:NcwButton Grid.Column="3" Variant="Primary" Width="34" Height="34" Padding="0" AutomationProperties.Name="{l:NcwText Send}" arc:Tooltip.Tip="{l:NcwText Send}">
            <lucide:LucideIcon Kind="ArrowUp" Size="16" />
          </ui:NcwButton>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
