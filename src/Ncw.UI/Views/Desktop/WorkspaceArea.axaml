<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Ncw.UI.Localization"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:ui="using:Ncw.UI.Controls"
             xmlns:vm="using:Ncw.Client.ViewModels"
             xmlns:conv="using:Ncw.UI.Views.Desktop.Conversation"
             xmlns:mgmt="using:Ncw.UI.Views.Desktop.Management"
             xmlns:desk="using:Ncw.UI.Views.Desktop"
             x:Class="Ncw.UI.Views.Desktop.WorkspaceArea"
             x:DataType="vm:ShellViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.preview">
      <Setter Property="FontStyle" Value="Italic" />
    </Style>
  </UserControl.Styles>
  <!-- 栏 3:主工作区。标签栏 + SSH 连接状态条(仅 SSH 异常 / 重连中显示) + 会话内容(转录、待办、目标条、输入框)。 -->
  <Grid RowDefinitions="40,Auto,*,Auto">
    <!-- 标签栏 = 窗口顶部这一行(空白处拖动窗口)。左右留白由外壳按左侧区域、检查器的显隐设置。 -->
    <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}">
      <Grid x:Name="TabRow" ColumnDefinitions="*,Auto" Margin="8,0">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <ItemsControl x:Name="TabStrip" ItemsSource="{Binding Workspace.Tabs}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="4" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:WorkspaceTabViewModel">
                <ui:PlainButton Height="30" Padding="10,0,6,0" VerticalAlignment="Center"
                                Classes.active="{Binding IsActive}" DoubleTapped="OnTabDoubleTapped"
                                Command="{Binding $parent[ItemsControl].((vm:ShellViewModel)DataContext).Workspace.ActivateCommand}"
                                CommandParameter="{Binding}">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <!-- 会话标签:运行中(权威广播)/ 设备断开时未知 / 空闲时是会话图标;文件标签:文件图标 -->
                    <Panel Width="14" VerticalAlignment="Center">
                      <lucide:LucideIcon Kind="MessageSquare" Size="13" IsVisible="{Binding IsSession}" />
                      <ui:NcwFileIcon Path="{Binding Path}" Width="14" Height="14" IsVisible="{Binding IsFile}" />
                      <Border Width="8" Height="8" CornerRadius="4" HorizontalAlignment="Center" Background="{arc:ArcDesignTokenResource Accent}" IsVisible="{Binding IsRunning}" ui:NcwMotion.Busy="Breathe" />
                    </Panel>
                    <TextBlock Classes.preview="{Binding File.IsPreview}" Text="{Binding Title}" MaxWidth="200" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <lucide:LucideIcon Kind="Pin" Size="11" VerticalAlignment="Center" IsVisible="{Binding IsFavorite}" Foreground="{arc:ArcDesignTokenResource Warning}" />
                    <!-- 文件标签:有未保存的修改 -->
                    <Border Width="7" Height="7" CornerRadius="4" VerticalAlignment="Center" Background="{arc:ArcDesignTokenResource TextMuted}"
                            IsVisible="{Binding File.IsDirty}" ui:NcwMotion.ShowMotion="Fade" ui:NcwMotion.ShowTier="Fast" arc:Tooltip.Tip="{l:NcwText FileUnsaved}" />
                    <ui:PlainButton Width="18" Height="18" CornerRadius="5"
                                    Command="{Binding $parent[ItemsControl].((vm:ShellViewModel)DataContext).Workspace.CloseCommand}"
                                    CommandParameter="{Binding}"
                                    AutomationProperties.Name="{l:NcwText CloseTab}">
                      <lucide:LucideIcon Kind="X" Size="11" HorizontalAlignment="Center" />
                    </ui:PlainButton>
                  </StackPanel>
                </ui:PlainButton>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ui:NcwDropdownMenu x:Name="NewMenu">
            <ui:NcwDropdownMenu.Trigger>
              <ui:NcwButton Classes="icon" Variant="Ghost" AutomationProperties.Name="{l:NcwText NewSession}" arc:Tooltip.Tip="{l:NcwText NewSession}">
                <lucide:LucideIcon Kind="Plus" Size="15" />
              </ui:NcwButton>
            </ui:NcwDropdownMenu.Trigger>
          </ui:NcwDropdownMenu>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
          <!-- 更多菜单:当前会话的操作(和会话行右键菜单同一组意图)+ 几个全局命令;条目在 code-behind 里随当前会话 / 快捷键重建 -->
          <ui:NcwDropdownMenu x:Name="MoreMenu">
            <ui:NcwDropdownMenu.Trigger>
              <ui:NcwButton Classes="icon" Variant="Ghost" AutomationProperties.Name="{l:NcwText More}" arc:Tooltip.Tip="{l:NcwText More}">
                <lucide:LucideIcon Kind="Ellipsis" Size="16" />
              </ui:NcwButton>
            </ui:NcwDropdownMenu.Trigger>
          </ui:NcwDropdownMenu>
          <!-- 上下文占用环在输入框的工具行里(docs/design/03 §6「输入框版式」),这里不再重复 -->
        </StackPanel>
      </Grid>
    </Border>

    <!-- SSH 连接状态条(连接中 / 重连中 / 失败 / 未知时自动出现) -->
    <desk:SshStatusBar Grid.Row="1" DataContext="{Binding SshStatusBar}" />

    <!-- 内容:当前会话;没有打开的会话时是空状态(与项目面板的「+」是同一个意图:新建会话) -->
    <conv:ConversationView Grid.Row="2" Grid.RowSpan="2" DataContext="{Binding Conversation}" IsVisible="{Binding HasSession}" ui:NcwMotion.ShowMotion="Fade" />
    <StackPanel Grid.Row="2" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="520" Margin="24"
                IsVisible="{Binding !Conversation.HasSession}" ui:NcwMotion.ShowMotion="Fade">
      <lucide:LucideIcon Kind="MessageSquare" Size="28" HorizontalAlignment="Center" Foreground="{arc:ArcDesignTokenResource TextMuted}" />
      <TextBlock HorizontalAlignment="Center" FontSize="{arc:ArcDesignTokenResource TypeLG}" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"
                 Text="{l:NcwText OpenASession}" />
      <ui:NcwButton HorizontalAlignment="Center" Variant="Primary" Command="{Binding Panel.NewSessionCommand}" IsVisible="{Binding Panel.HasProject}" Content="{l:NcwText NewSession}" />
    </StackPanel>
    <!-- 文件标签页:盖在会话上(当前标签是文件时) -->
    <desk:FileTabView Grid.Row="2" Grid.RowSpan="2" DataContext="{Binding Workspace.ActiveFile}"
                      IsVisible="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).Workspace.ActiveFile, Converter={x:Static ObjectConverters.IsNotNull}}"
                      ui:NcwMotion.ShowMotion="Fade" />
    <!-- 侧栏「定时任务」页:盖在内容区上(选了别的会话就让位) -->
    <mgmt:SchedulesPage Grid.Row="2" Grid.RowSpan="2" DataContext="{Binding ScheduledTasks}" IsVisible="{Binding IsOpen}" ui:NcwMotion.ShowMotion="Fade" />
  </Grid>
</UserControl>
