<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Ncw.UI.Localization"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:ui="using:Ncw.UI.Controls"
             xmlns:cv="using:Ncw.UI.Converters"
             xmlns:desktop="using:Ncw.UI.Views.Desktop"
             xmlns:models="using:Ncw.UI.Views.Desktop.Models"
             xmlns:m="using:Ncw.UI.Views.Desktop.Management"
             xmlns:vm="using:Ncw.Client.ViewModels"
             x:Class="Ncw.UI.Views.Desktop.SettingsOverlay"
             x:DataType="vm:SettingsViewModel"
             ui:NcwMotion.IsPresent="{Binding IsOpen}" ui:NcwMotion.PresenceKind="Fade">
  <!--
    设置页(docs/design/07 §3,方案 D「三栏主从」):整窗覆盖。导航(220)→ 列表栏(240,只有带子分区的导航项和「模型与供应商」才有)→ 内容。
    导航 11 项分三组:本应用(账户、外观、快捷键、通知、关于)、设备(通用、模型与供应商、扩展、连接、数据;组标题下是唯一一份设备切换器)、项目(项目设置;组标题下是项目切换器)。
    一次只显示一个分区:当前分区的真源是 ViewModel 的 Section,导航高亮、列表栏、内容都从它派生(不再有长滚动和导航 / 滚动位置的双向同步)。
    数据按需加载:分区第一次成为当前分区时由 SettingsViewModel.Activate 去读。顶部 40px 留给拖动窗口和 macOS 红绿灯。
    窄屏(< 760)导航收成 56px 的图标栏(文字、分组、切换器、搜索藏起来,图标上有提示);< 1000 列表栏收窄到 200。Esc 关闭。
  -->
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CloseCommand}" />
  </UserControl.KeyBindings>
  <UserControl.Styles>
    <!-- 导航 / 列表栏里的分组标题:小字、次要色 -->
    <Style Selector="TextBlock.group, TextBlock.listGroup">
      <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
    </Style>
    <!-- 导航项 / 列表项:悬停比底色亮一档,选中用强调色的浅底 + 强调色文字 -->
    <Style Selector="ui|PlainButton.navItem">
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusControl}" />
      <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
    </Style>
    <Style Selector="ui|PlainButton.listItem">
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusControl}" />
    </Style>
    <Style Selector="ui|PlainButton.navItem:pointerover, ui|PlainButton.listItem:pointerover">
      <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceRaised}" />
    </Style>
    <Style Selector="ui|PlainButton.navItem.active, ui|PlainButton.listItem.active">
      <Setter Property="Background" Value="{arc:ArcDesignTokenResource AccentSubtle}" />
      <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Accent}" />
    </Style>
    <Style Selector="ui|PlainButton.navItem.active TextBlock.navText, ui|PlainButton.listItem.active TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- 内容区各分区:撑满内容区,内容区最宽 760(Arc 的 ContentMaxWidthMD)、贴着列表栏(主从布局里详情从左边开始,不悬在中间) -->
    <Style Selector="ui|NcwDeferred.page">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <!-- 各页页头不再各带一份设备 / 项目切换器(导航「设备」「项目」分组下各放一份) -->
    <Style Selector="m|PageHeader"><Setter Property="ShowSwitchers" Value="False" /></Style>
    <!-- 窄屏:导航只留图标(切换器外面包一层 Panel 来藏:它自己的 IsVisible 是绑定,样式盖不过) -->
    <Style Selector="Grid.compact TextBlock.navText"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="Grid.compact :is(Control).navHead"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="Grid.compact ui|PlainButton.navItem"><Setter Property="HorizontalContentAlignment" Value="Center" /></Style>
  </UserControl.Styles>

  <Grid x:Name="Layout" ColumnDefinitions="220,Auto,*" Background="{arc:ArcDesignTokenResource Background}">
    <!-- ───── 导航 ───── -->
    <Border x:Name="NavColumn" Background="{arc:ArcDesignTokenResource SurfaceMuted}" BorderThickness="0,0,1,0" BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}">
      <DockPanel Margin="0,40,0,0">
        <StackPanel DockPanel.Dock="Top" Margin="12,0,8,10" Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="navHead" Margin="4,0,0,0" VerticalAlignment="Center" Text="{l:NcwText Settings}" FontWeight="SemiBold" FontSize="{arc:ArcDesignTokenResource TypeLG}" />
            <ui:NcwButton Grid.Column="1" Classes="icon" Variant="Ghost" Command="{Binding CloseCommand}"
                          AutomationProperties.Name="{l:NcwText CloseSettings}" arc:Tooltip.Tip="{l:NcwText CloseSettings}">
              <lucide:LucideIcon Kind="X" Size="16" />
            </ui:NcwButton>
          </Grid>
          <!-- 搜索设置(03 §11.6):在每个分区的全部文字(名字和说明)里找,结果浮在导航上,点一个跳过去 -->
          <ui:NcwSearchField x:Name="SearchBox" Classes="navHead" Text="{Binding SearchQuery, Mode=TwoWay}" PlaceholderText="{l:NcwText SettingsSearch}"
                             AutomationProperties.Name="{l:NcwText SettingsSearch}" />
        </StackPanel>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="NavItems" Margin="8,0,8,16" Spacing="1" AutomationProperties.Name="{l:NcwText Settings}">
          <TextBlock Classes="group navHead" Margin="10,6,0,4" Text="{l:NcwText SettingsAppGroup}" />
          <ui:PlainButton x:Name="NavAccount" Classes="navItem" Command="{Binding ShowPageCommand}" CommandParameter="{x:Static vm:SettingsPage.Account}"
                          Classes.active="{Binding Page, Converter={x:Static cv:SettingsPageIsConverter.Instance}, ConverterParameter={x:Static vm:SettingsPage.Account}}"
                          AutomationProperties.Name="{l:NcwText SettingsAccount}" arc:Tooltip.Tip="{l:NcwText SettingsAccount}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <lucide:LucideIcon Kind="CircleUser" Size="15" VerticalAlignment="Center" />
              <TextBlock Classes="navText" Text="{l:NcwText SettingsAccount}" VerticalAlignment="Center" />
            </StackPanel>
          </ui:PlainButton>
          <ui:PlainButton x:Name="NavAppearance" Classes="navItem" Command="{Binding ShowPageCommand}" CommandParameter="{x:Static vm:SettingsPage.Appearance}"
                          Classes.active="{Binding Page, Converter={x:Static cv:SettingsPageIsConverter.Instance}, ConverterParameter={x:Static vm:SettingsPage.Appearance}}"
                          AutomationProperties.Name="{l:NcwText SettingsAppearance}" arc:Tooltip.Tip="{l:NcwText SettingsAppearance}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <lucide:LucideIcon Kind="Palette" Size="15" VerticalAlignment="Center" />
              <TextBlock Classes="navText" Text="{l:NcwText SettingsAppearance}" VerticalAlignment="Center" />
            </StackPanel>
          </ui:PlainButton>
          <ui:PlainButton x:Name="NavShortcuts" Classes="navItem" Command="{Binding ShowPageCommand}" CommandParameter="{x:Static vm:SettingsPage.Shortcuts}"
                          Classes.active="{Binding Page, Converter={x:Static cv:SettingsPageIsConverter.Instance}, ConverterParameter={x:Static vm:SettingsPage.Shortcuts}}"
                          AutomationProperties.Name="{l:NcwText SettingsShortcuts}" arc:Tooltip.Tip="{l:NcwText SettingsShortcuts}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <lucide:LucideIcon Kind="Keyboard" Size="15" VerticalAlignment="Center" />
              <TextBlock Classes="navText" Text="{l:NcwText SettingsShortcuts}" VerticalAlignment="Center" />
            </StackPanel>
          </ui:PlainButton>
          <ui:PlainButton x:Name="NavNotifications" Classes="navItem" Command="{Binding ShowPageCommand}" CommandParameter="{x:Static vm:SettingsPage.Notifications}"
                          Classes.active="{Binding Page, Converter={x:Static cv:SettingsPageIsConverter.Instance}, ConverterParameter={x:Static vm:SettingsPage.Notifications}}"
                          AutomationProperties.Name="{l:NcwText SettingsNotifications}" arc:Tooltip.Tip="{l:NcwText SettingsNotifications}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <lucide:LucideIcon Kind="Bell" Size="15" VerticalAlignment="Center" />
              <TextBlock Classes="navText" Text="{l:NcwText SettingsNotifications}" VerticalAlignment="Center" />
            </StackPanel>
          </ui:PlainButton>
          <ui:PlainButton x:Name="AboutNav" Classes="navItem" Command="{Binding ShowPageCommand}" CommandParameter="{x:Static vm:SettingsPage.About}"
                          Classes.active="{Binding Page, Converter={x:Static cv:SettingsPageIsConverter.Instance}, ConverterParameter={x:Static vm:SettingsPage.About}}"
                          AutomationProperties.Name="{l:NcwText SettingsAbout}" arc:Tooltip.Tip="{l:NcwText SettingsAbout}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <lucide:LucideIcon Kind="Info" Size="15" VerticalAlignment="Center" />
              <TextBlock Classes="navText" Text="{l:NcwText SettingsAbout}" VerticalAlignment="Center" />
            </StackPanel>
          </ui:PlainButton>
          <TextBlock Classes="group navHead" Margin="10,16,0,4" Text="{l:NcwText SettingsDeviceGroup}" />
          <!-- 设备切换器只有这一份:「设备」分组下各页都按它读数据(模型页的设备跟随它) -->
          <Panel Classes="navHead"><ui:NcwSelect x:Name="ScopeDevice" Margin="2,0,2,6" HorizontalAlignment="Stretch" ItemsSource="{Binding Pages.Scope.DeviceChoices}" SelectedValue="{Binding Pages.Scope.DeviceId, Mode=TwoWay}"
                        IsVisible="{Binding Pages.Scope.ShowsDeviceSwitcher}" AutomationProperties.Name="{l:NcwText SettingsDeviceSwitcher}" /></Panel>
          <ui:PlainButton x:Name="NavGeneral" Classes="navItem" Command="{Binding ShowPageCommand}" CommandParameter="{x:Static vm:SettingsPage.General}"
                          Classes.active="{Binding Page, Converter={x:Static cv:SettingsPageIsConverter.Instance}, ConverterParameter={x:Static vm:SettingsPage.General}}"
                          AutomationProperties.Name="{l:NcwText SettingsGeneral}" arc:Tooltip.Tip="{l:NcwText SettingsGeneral}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <lucide:LucideIcon Kind="SlidersHorizontal" Size="15" VerticalAlignment="Center" />
              <TextBlock Classes="navText" Text="{l:NcwText SettingsGeneral}" VerticalAlignment="Center" />
            </StackPanel>
          </ui:PlainButton>
          <ui:PlainButton x:Name="NavModels" Classes="navItem" Command="{Binding ShowPageCommand}" CommandParameter="{x:Static vm:SettingsPage.Models}"
                          Classes.active="{Binding Page, Converter={x:Static cv:SettingsPageIsConverter.Instance}, ConverterParameter={x:Static vm:SettingsPage.Models}}"
                          AutomationProperties.Name="{l:NcwText SettingsModels}" arc:Tooltip.Tip="{l:NcwText SettingsModels}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <lucide:LucideIcon Kind="Cpu" Size="15" VerticalAlignment="Center" />
              <TextBlock Classes="navText" Text="{l:NcwText SettingsModels}" VerticalAlignment="Center" />
            </StackPanel>
          </ui:PlainButton>
          <ui:PlainButton x:Name="NavExtensions" Classes="navItem" Command="{Binding ShowPageCommand}" CommandParameter="{x:Static vm:SettingsPage.Extensions}"
                          Classes.active="{Binding Page, Converter={x:Static cv:SettingsPageIsConverter.Instance}, ConverterParameter={x:Static vm:SettingsPage.Extensions}}"
                          AutomationProperties.Name="{l:NcwText SettingsExtensions}" arc:Tooltip.Tip="{l:NcwText SettingsExtensions}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <lucide:LucideIcon Kind="Puzzle" Size="15" VerticalAlignment="Center" />
              <TextBlock Classes="navText" Text="{l:NcwText SettingsExtensions}" VerticalAlignment="Center" />
            </StackPanel>
          </ui:PlainButton>
          <ui:PlainButton x:Name="NavConnection" Classes="navItem" Command="{Binding ShowPageCommand}" CommandParameter="{x:Static vm:SettingsPage.Connection}"
                          Classes.active="{Binding Page, Converter={x:Static cv:SettingsPageIsConverter.Instance}, ConverterParameter={x:Static vm:SettingsPage.Connection}}"
                          AutomationProperties.Name="{l:NcwText SettingsConnection}" arc:Tooltip.Tip="{l:NcwText SettingsConnection}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <lucide:LucideIcon Kind="Wifi" Size="15" VerticalAlignment="Center" />
              <TextBlock Classes="navText" Text="{l:NcwText SettingsConnection}" VerticalAlignment="Center" />
            </StackPanel>
          </ui:PlainButton>
          <ui:PlainButton x:Name="NavData" Classes="navItem" Command="{Binding ShowPageCommand}" CommandParameter="{x:Static vm:SettingsPage.Data}"
                          Classes.active="{Binding Page, Converter={x:Static cv:SettingsPageIsConverter.Instance}, ConverterParameter={x:Static vm:SettingsPage.Data}}"
                          AutomationProperties.Name="{l:NcwText SettingsData}" arc:Tooltip.Tip="{l:NcwText SettingsData}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <lucide:LucideIcon Kind="Database" Size="15" VerticalAlignment="Center" />
              <TextBlock Classes="navText" Text="{l:NcwText SettingsData}" VerticalAlignment="Center" />
            </StackPanel>
          </ui:PlainButton>
          <TextBlock Classes="group navHead" Margin="10,16,0,4" Text="{l:NcwText SettingsProjectGroup}" />
          <Panel Classes="navHead"><ui:NcwSelect x:Name="ScopeProject" Margin="2,0,2,6" HorizontalAlignment="Stretch" ItemsSource="{Binding Pages.Scope.ProjectChoices}" SelectedValue="{Binding Pages.Scope.WorkspaceId, Mode=TwoWay}"
                        IsVisible="{Binding Pages.Scope.HasProjects}" AutomationProperties.Name="{l:NcwText SettingsProjectSwitcher}" /></Panel>
          <ui:PlainButton x:Name="NavProject" Classes="navItem" Command="{Binding ShowPageCommand}" CommandParameter="{x:Static vm:SettingsPage.Project}"
                          Classes.active="{Binding Page, Converter={x:Static cv:SettingsPageIsConverter.Instance}, ConverterParameter={x:Static vm:SettingsPage.Project}}"
                          AutomationProperties.Name="{l:NcwText SettingsProject}" arc:Tooltip.Tip="{l:NcwText SettingsProject}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <lucide:LucideIcon Kind="FolderCog" Size="15" VerticalAlignment="Center" />
              <TextBlock Classes="navText" Text="{l:NcwText SettingsProject}" VerticalAlignment="Center" />
            </StackPanel>
          </ui:PlainButton>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- ───── 列表栏:子分区,或模型与供应商的供应商列表 ───── -->
    <Border x:Name="ListColumn" Grid.Column="1" Width="240" IsVisible="{Binding ShowsList}"
            BorderThickness="0,0,1,0" BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}">
      <DockPanel Margin="0,40,0,0">
        <TextBlock DockPanel.Dock="Top" Margin="18,6,12,12" FontWeight="SemiBold" FontSize="{arc:ArcDesignTokenResource TypeLG}" TextTrimming="CharacterEllipsis"
                   Text="{Binding Page, Converter={x:Static cv:SettingsPageTitleConverter.Instance}}" />
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="8,0,8,16">
            <ItemsControl x:Name="SubList" ItemsSource="{Binding SubSections}" IsVisible="{Binding ShowsSubSections}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="2" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SettingsSubItem">
                  <ui:PlainButton Classes="listItem" Classes.active="{Binding IsCurrent}" Click="OnSubSectionClick"
                                  arc:Tooltip.Tip="{Binding Section, Converter={x:Static cv:SettingsSectionTitleConverter.Instance}}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <lucide:LucideIcon Kind="{Binding Section, Converter={x:Static cv:SettingsSectionIconConverter.Instance}}" Size="15" VerticalAlignment="Center" />
                      <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Section, Converter={x:Static cv:SettingsSectionTitleConverter.Instance}}" />
                    </StackPanel>
                  </ui:PlainButton>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Panel IsVisible="{Binding ShowsProviderList}">
              <models:ModelsProviderList x:Name="ProviderList" DataContext="{Binding Models}" Tag="{x:Static vm:SettingsSection.Models}" />
            </Panel>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!--
      ───── 内容:只显示当前分区(切换时淡入,滚回顶部) ─────
      各分区按需创建(docs/design/03 §12):第一次显示时才建出页面;搜索时一次建出全部(要收集文字);设置页关掉后全部释放。
    -->
    <ScrollViewer x:Name="ContentScroll" Grid.Column="2" Margin="0,40,0,0" HorizontalScrollBarVisibility="Disabled">
      <Grid x:Name="SectionPages" Margin="32,8,32,48">
        <!-- 一列:撑满到 760 为止,多出来的留在右边 -->
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="760" /></Grid.ColumnDefinitions>
        <ui:NcwDeferred Classes="page" Tag="{x:Static vm:SettingsSection.Account}" ui:NcwMotion.ShowMotion="Fade"
             IsVisible="{Binding $parent[desktop:SettingsOverlay].((vm:SettingsViewModel)DataContext).Section, Converter={x:Static cv:SettingsSectionIsConverter.Instance}, ConverterParameter={x:Static vm:SettingsSection.Account}}">
          <DataTemplate x:DataType="vm:SettingsViewModel"><desktop:AccountSettingsPage DataContext="{Binding Account}" /></DataTemplate>
        </ui:NcwDeferred>
        <ui:NcwDeferred Classes="page" Tag="{x:Static vm:SettingsSection.Appearance}" ui:NcwMotion.ShowMotion="Fade"
             IsVisible="{Binding $parent[desktop:SettingsOverlay].((vm:SettingsViewModel)DataContext).Section, Converter={x:Static cv:SettingsSectionIsConverter.Instance}, ConverterParameter={x:Static vm:SettingsSection.Appearance}}">
          <DataTemplate x:DataType="vm:SettingsViewModel"><desktop:AppearanceSettingsPage DataContext="{Binding Appearance}" /></DataTemplate>
        </ui:NcwDeferred>
        <ui:NcwDeferred Classes="page" Tag="{x:Static vm:SettingsSection.Shortcuts}" ui:NcwMotion.ShowMotion="Fade"
             IsVisible="{Binding $parent[desktop:SettingsOverlay].((vm:SettingsViewModel)DataContext).Section, Converter={x:Static cv:SettingsSectionIsConverter.Instance}, ConverterParameter={x:Static vm:SettingsSection.Shortcuts}}">
          <DataTemplate x:DataType="vm:SettingsViewModel"><desktop:ShortcutsSettingsPage DataContext="{Binding Shortcuts}" /></DataTemplate>
        </ui:NcwDeferred>
        <ui:NcwDeferred Classes="page" Tag="{x:Static vm:SettingsSection.Notifications}" ui:NcwMotion.ShowMotion="Fade"
             IsVisible="{Binding $parent[desktop:SettingsOverlay].((vm:SettingsViewModel)DataContext).Section, Converter={x:Static cv:SettingsSectionIsConverter.Instance}, ConverterParameter={x:Static vm:SettingsSection.Notifications}}">
          <DataTemplate x:DataType="vm:SettingsViewModel"><desktop:NotificationsSettingsPage DataContext="{Binding Notifications}" /></DataTemplate>
        </ui:NcwDeferred>
        <ui:NcwDeferred Classes="page" Tag="{x:Static vm:SettingsSection.About}" ui:NcwMotion.ShowMotion="Fade"
             IsVisible="{Binding $parent[desktop:SettingsOverlay].((vm:SettingsViewModel)DataContext).Section, Converter={x:Static cv:SettingsSectionIsConverter.Instance}, ConverterParameter={x:Static vm:SettingsSection.About}}">
          <DataTemplate x:DataType="vm:SettingsViewModel"><desktop:AboutSettingsPage DataContext="{Binding About}" /></DataTemplate>
        </ui:NcwDeferred>
        <ui:NcwDeferred Classes="page" Tag="{x:Static vm:SettingsSection.General}" ui:NcwMotion.ShowMotion="Fade"
             IsVisible="{Binding $parent[desktop:SettingsOverlay].((vm:SettingsViewModel)DataContext).Section, Converter={x:Static cv:SettingsSectionIsConverter.Instance}, ConverterParameter={x:Static vm:SettingsSection.General}}">
          <DataTemplate x:DataType="vm:SettingsViewModel"><m:GeneralSettingsPage DataContext="{Binding Pages.General}" /></DataTemplate>
        </ui:NcwDeferred>
        <ui:NcwDeferred Classes="page" Tag="{x:Static vm:SettingsSection.Models}" ui:NcwMotion.ShowMotion="Fade"
             IsVisible="{Binding $parent[desktop:SettingsOverlay].((vm:SettingsViewModel)DataContext).Section, Converter={x:Static cv:SettingsSectionIsConverter.Instance}, ConverterParameter={x:Static vm:SettingsSection.Models}}">
          <DataTemplate x:DataType="vm:SettingsViewModel"><models:ModelsDetail DataContext="{Binding Models}" /></DataTemplate>
        </ui:NcwDeferred>
        <ui:NcwDeferred Classes="page" Tag="{x:Static vm:SettingsSection.Skills}" ui:NcwMotion.ShowMotion="Fade"
             IsVisible="{Binding $parent[desktop:SettingsOverlay].((vm:SettingsViewModel)DataContext).Section, Converter={x:Static cv:SettingsSectionIsConverter.Instance}, ConverterParameter={x:Static vm:SettingsSection.Skills}}">
          <DataTemplate x:DataType="vm:SettingsViewModel"><m:SkillsPage DataContext="{Binding Pages.Skills}" /></DataTemplate>
        </ui:NcwDeferred>
        <ui:NcwDeferred Classes="page" Tag="{x:Static vm:SettingsSection.Commands}" ui:NcwMotion.ShowMotion="Fade"
             IsVisible="{Binding $parent[desktop:SettingsOverlay].((vm:SettingsViewModel)DataContext).Section, Converter={x:Static cv:SettingsSectionIsConverter.Instance}, ConverterParameter={x:Static vm:SettingsSection.Commands}}">
          <DataTemplate x:DataType="vm:SettingsViewModel"><m:CommandsPage DataContext="{Binding Pages.Commands}" /></DataTemplate>
        </ui:NcwDeferred>
        <ui:NcwDeferred Classes="page" Tag="{x:Static vm:SettingsSection.Hooks}" ui:NcwMotion.ShowMotion="Fade"
             IsVisible="{Binding $parent[desktop:SettingsOverlay].((vm:SettingsViewModel)DataContext).Section, Converter={x:Static cv:SettingsSectionIsConverter.Instance}, ConverterParameter={x:Static vm:SettingsSection.Hooks}}">
          <DataTemplate x:DataType="vm:SettingsViewModel"><m:HooksPage DataContext="{Binding Pages.Hooks}" /></DataTemplate>
        </ui:NcwDeferred>
        <ui:NcwDeferred Classes="page" Tag="{x:Static vm:SettingsSection.Mcp}" ui:NcwMotion.ShowMotion="Fade"
             IsVisible="{Binding $parent[desktop:SettingsOverlay].((vm:SettingsViewModel)DataContext).Section, Converter={x:Static cv:SettingsSectionIsConverter.Instance}, ConverterParameter={x:Static vm:SettingsSection.Mcp}}">
          <DataTemplate x:DataType="vm:SettingsViewModel"><m:McpPage DataContext="{Binding Pages.Mcp}" /></DataTemplate>
        </ui:NcwDeferred>
        <ui:NcwDeferred Classes="page" Tag="{x:Static vm:SettingsSection.Plugins}" ui:NcwMotion.ShowMotion="Fade"
             IsVisible="{Binding $parent[desktop:SettingsOverlay].((vm:SettingsViewModel)DataContext).Section, Converter={x:Static cv:SettingsSectionIsConverter.Instance}, ConverterParameter={x:Static vm:SettingsSection.Plugins}}">
          <DataTemplate x:DataType="vm:SettingsViewModel"><m:PluginsPage DataContext="{Binding Pages.Plugins}" /></DataTemplate>
        </ui:NcwDeferred>
        <ui:NcwDeferred Classes="page" Tag="{x:Static vm:SettingsSection.Remote}" ui:NcwMotion.ShowMotion="Fade"
             IsVisible="{Binding $parent[desktop:SettingsOverlay].((vm:SettingsViewModel)DataContext).Section, Converter={x:Static cv:SettingsSectionIsConverter.Instance}, ConverterParameter={x:Static vm:SettingsSection.Remote}}">
          <DataTemplate x:DataType="vm:SettingsViewModel"><desktop:RemoteSettingsPage DataContext="{Binding Remote}" /></DataTemplate>
        </ui:NcwDeferred>
        <ui:NcwDeferred Classes="page" Tag="{x:Static vm:SettingsSection.Gateway}" ui:NcwMotion.ShowMotion="Fade"
             IsVisible="{Binding $parent[desktop:SettingsOverlay].((vm:SettingsViewModel)DataContext).Section, Converter={x:Static cv:SettingsSectionIsConverter.Instance}, ConverterParameter={x:Static vm:SettingsSection.Gateway}}">
          <DataTemplate x:DataType="vm:SettingsViewModel"><m:GatewayPage DataContext="{Binding Pages.Gateway}" /></DataTemplate>
        </ui:NcwDeferred>
        <ui:NcwDeferred Classes="page" Tag="{x:Static vm:SettingsSection.Devices}" ui:NcwMotion.ShowMotion="Fade"
             IsVisible="{Binding $parent[desktop:SettingsOverlay].((vm:SettingsViewModel)DataContext).Section, Converter={x:Static cv:SettingsSectionIsConverter.Instance}, ConverterParameter={x:Static vm:SettingsSection.Devices}}">
          <DataTemplate x:DataType="vm:SettingsViewModel"><desktop:DevicesSettingsPage DataContext="{Binding Devices}" /></DataTemplate>
        </ui:NcwDeferred>
        <ui:NcwDeferred Classes="page" Tag="{x:Static vm:SettingsSection.Usage}" ui:NcwMotion.ShowMotion="Fade"
             IsVisible="{Binding $parent[desktop:SettingsOverlay].((vm:SettingsViewModel)DataContext).Section, Converter={x:Static cv:SettingsSectionIsConverter.Instance}, ConverterParameter={x:Static vm:SettingsSection.Usage}}">
          <DataTemplate x:DataType="vm:SettingsViewModel"><m:UsagePage DataContext="{Binding Pages.Usage}" /></DataTemplate>
        </ui:NcwDeferred>
        <ui:NcwDeferred Classes="page" Tag="{x:Static vm:SettingsSection.Storage}" ui:NcwMotion.ShowMotion="Fade"
             IsVisible="{Binding $parent[desktop:SettingsOverlay].((vm:SettingsViewModel)DataContext).Section, Converter={x:Static cv:SettingsSectionIsConverter.Instance}, ConverterParameter={x:Static vm:SettingsSection.Storage}}">
          <DataTemplate x:DataType="vm:SettingsViewModel"><m:StoragePage DataContext="{Binding Pages.Storage}" /></DataTemplate>
        </ui:NcwDeferred>
        <ui:NcwDeferred Classes="page" Tag="{x:Static vm:SettingsSection.Project}" ui:NcwMotion.ShowMotion="Fade"
             IsVisible="{Binding $parent[desktop:SettingsOverlay].((vm:SettingsViewModel)DataContext).Section, Converter={x:Static cv:SettingsSectionIsConverter.Instance}, ConverterParameter={x:Static vm:SettingsSection.Project}}">
          <DataTemplate x:DataType="vm:SettingsViewModel"><m:ProjectSettingsPage DataContext="{Binding Pages.Project}" /></DataTemplate>
        </ui:NcwDeferred>
      </Grid>
    </ScrollViewer>

    <!-- 搜索结果:盖在导航上(和导航同宽再宽一点),每条是「分区名 + 命中的那一句」 -->
    <Border Grid.ColumnSpan="3" ZIndex="20" Width="340" Margin="8,128,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
            IsVisible="{Binding IsSearching}" Padding="6" CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}" BorderThickness="1"
            BorderBrush="{arc:ArcDesignTokenResource Border}" Background="{arc:ArcDesignTokenResource SurfaceRaised}" BoxShadow="{arc:ArcDesignTokenResource ShadowFloating}">
      <StackPanel Spacing="2">
        <TextBlock Classes="hint" Margin="8,6" IsVisible="{Binding ShowsNoSearchHits}" Text="{l:NcwText SettingsSearchNoMatch}" />
        <ItemsControl ItemsSource="{Binding SearchHits}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SettingsHit">
              <ui:PlainButton Padding="8,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Click="OnHitClick">
                <StackPanel Spacing="1">
                  <TextBlock FontWeight="SemiBold" Text="{Binding Section, Converter={x:Static cv:SettingsSectionTitleConverter.Instance}}" />
                  <TextBlock Classes="hint" Text="{Binding Snippet}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </ui:PlainButton>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
