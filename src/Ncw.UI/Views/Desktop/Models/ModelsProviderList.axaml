<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Ncw.UI.Localization"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:ui="using:Ncw.UI.Controls"
             xmlns:cv="using:Ncw.UI.Converters"
             xmlns:vm="using:Ncw.Client.ViewModels"
             x:Class="Ncw.UI.Views.Desktop.Models.ModelsProviderList"
             x:DataType="vm:ModelsSettingsViewModel">
  <!--
    设置页「模型与供应商」的列表栏(docs/design/07 §3,方案 D):第一项「模型目录」,下面是供应商(状态点 + 名字 + 一行摘要)。
    选中项是纯 UI 状态 SelectedProviderId(null = 模型目录);详情在内容区(ModelsDetail)。
  -->
  <StackPanel Spacing="2">
    <ui:PlainButton x:Name="CatalogItem" Classes="listItem" Classes.active="{Binding ShowsCatalog}" Command="{Binding SelectCatalogCommand}">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
        <lucide:LucideIcon Kind="Library" Size="15" VerticalAlignment="Center" Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
        <StackPanel Grid.Column="1" Spacing="1">
          <TextBlock Text="{l:NcwText CatalogTitle}" TextTrimming="CharacterEllipsis" />
          <TextBlock Classes="hint" TextTrimming="CharacterEllipsis" Text="{l:NcwText SettingsProvidersCatalogHint}" />
        </StackPanel>
      </Grid>
    </ui:PlainButton>

    <!-- 从其他应用导入:设备支持、能写才有;还有能导入的就带个数 -->
    <ui:PlainButton x:Name="DiscoveryItem" Classes="listItem" Classes.active="{Binding ShowsDiscovery}" Command="{Binding SelectDiscoveryCommand}"
                    IsVisible="{Binding ShowsDiscoveryEntry}">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
        <lucide:LucideIcon Kind="Import" Size="15" VerticalAlignment="Center" Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{l:NcwText DiscoveryTitle}" TextTrimming="CharacterEllipsis" />
        <Border Grid.Column="2" Classes="chip" VerticalAlignment="Center" IsVisible="{Binding Discovery.HasImportable}">
          <TextBlock Classes="hint" Text="{Binding Discovery.ImportableCount}" />
        </Border>
      </Grid>
    </ui:PlainButton>

    <Grid ColumnDefinitions="*,Auto" Margin="10,12,4,2">
      <TextBlock Classes="listGroup" Text="{l:NcwText ProvidersTitle}" VerticalAlignment="Center" />
      <ui:NcwButton x:Name="AddProviderButton" Grid.Column="1" Classes="icon" Variant="Ghost" Command="{Binding NewProviderCommand}" IsVisible="{Binding CanEdit}"
                    AutomationProperties.Name="{l:NcwText AddProvider}" arc:Tooltip.Tip="{l:NcwText AddProvider}">
        <lucide:LucideIcon Kind="Plus" Size="14" />
      </ui:NcwButton>
    </Grid>
    <ui:NcwSegmented x:Name="KindFilter" Margin="4,2,4,6" HorizontalAlignment="Stretch" SelectedValue="{Binding SelectedKind, Mode=TwoWay}">
      <ui:NcwSegmentedOption Value="text" Label="{l:NcwText ProviderKindShortText}" />
      <ui:NcwSegmentedOption Value="image" Label="{l:NcwText ProviderKindShortImage}" />
      <ui:NcwSegmentedOption Value="video" Label="{l:NcwText ProviderKindShortVideo}" />
      <ui:NcwSegmentedOption Value="audio" Label="{l:NcwText ProviderKindShortAudio}" />
    </ui:NcwSegmented>
    <TextBlock Classes="hint" Margin="10,4" TextWrapping="Wrap" Text="{l:NcwText NoProvidersForKind}" IsVisible="{Binding !HasFilteredProviders}" />
    <ItemsControl x:Name="ProviderItems" ItemsSource="{Binding FilteredProviders}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Spacing="2" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:ProviderItemViewModel">
          <ui:PlainButton Classes="listItem" Classes.active="{Binding IsSelected}" Command="{Binding SelectCommand}" arc:Tooltip.Tip="{Binding Name}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <!-- logo,右下角是启用状态点(实心 = 启用,空心 = 停用) -->
              <Panel Width="26" Height="26" VerticalAlignment="Center">
                <ui:NcwProviderLogo Classes="tile" Width="26" Height="26" Service="{Binding Logo}" FallbackText="{Binding Name}" Classes.off="{Binding !IsEnabled}" />
                <Border Width="10" Height="10" CornerRadius="5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-3"
                        BorderThickness="2" BorderBrush="{arc:ArcDesignTokenResource Background}" Background="{arc:ArcDesignTokenResource Success}" IsVisible="{Binding IsEnabled}" />
                <Border Width="10" Height="10" CornerRadius="5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-3"
                        BorderThickness="2" BorderBrush="{arc:ArcDesignTokenResource BorderStrong}" Background="{arc:ArcDesignTokenResource Background}" IsVisible="{Binding !IsEnabled}" />
              </Panel>
              <StackPanel Grid.Column="1" Spacing="1">
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="hint" TextTrimming="CharacterEllipsis" IsVisible="{Binding IsEnabled}"
                           Text="{Binding ModelCount, Converter={x:Static cv:TextFormatConverter.Instance}, ConverterParameter=ProviderModelCount}" />
                <TextBlock Classes="hint" IsVisible="{Binding !IsEnabled}" Text="{l:NcwText ProviderDisabledShort}" />
              </StackPanel>
            </Grid>
          </ui:PlainButton>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
