<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Ncw.UI.Localization"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:ui="using:Ncw.UI.Controls"
             xmlns:desktop="using:Ncw.UI.Views.Desktop"
             xmlns:vm="using:Ncw.Client.ViewModels"
             x:Class="Ncw.UI.Views.Desktop.SshInteractionOverlay"
             x:DataType="vm:SshInteractionsViewModel"
             ui:NcwMotion.IsPresent="{Binding ShowsGlobalOverlay}" ui:NcwMotion.PresenceKind="Fade">
  <!-- 桌面全局 SSH 指纹 / 凭据浮层:盖在工作区、首次启动与设置页之上;Esc 取消当前提问。 -->
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding Current.CancelCommand}" />
  </UserControl.KeyBindings>
  <Border Background="{arc:ArcDesignTokenResource Scrim}" Padding="24">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel MaxWidth="480" HorizontalAlignment="Stretch" VerticalAlignment="Center" Spacing="8">
        <desktop:SshInteractionCard DataContext="{Binding Current}" />
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
