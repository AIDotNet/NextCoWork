<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Ncw.UI.Localization"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:ui="using:Ncw.UI.Controls"
             xmlns:vm="using:Ncw.Client.ViewModels"
             xmlns:models="using:Ncw.UI.Views.Desktop.Models"
             x:Class="Ncw.UI.Views.Desktop.ModelsSettingsPage"
             x:DataType="vm:ModelsSettingsViewModel">
  <!--
    设置 · 设备 · 模型与供应商的整页形式(手机设置的导航栈里用;桌面设置页是「列表栏 + 详情」,见 Models/ModelsProviderList、Models/ModelsDetail,docs/design/07 §3)。
    供应商一张卡片,展开看操作和模型别名;作用域是「设备」:顶部有设备切换器;设备断开时这一页只读。改动立即生效(经设备,结果经主题回到这里)。
  -->
  <StackPanel Spacing="6">
    <StackPanel Spacing="2">
      <TextBlock Text="{l:NcwText SettingsModels}" FontSize="{arc:ArcDesignTokenResource TypeLG}" FontWeight="SemiBold" />
      <TextBlock Classes="hint" Text="{l:NcwText SettingsModelsHint}" />
    </StackPanel>
    <!-- 设备作用域:设备切换器(窄屏下也放在标题下面,不挤标题) -->
    <ui:NcwSelect x:Name="DeviceSelect" HorizontalAlignment="Left" MinWidth="200" Margin="0,8,0,0" ItemsSource="{Binding DeviceChoices}"
                  SelectedValue="{Binding DeviceId, Mode=TwoWay}" IsVisible="{Binding ShowsDeviceSwitcher}"
                  AutomationProperties.Name="{l:NcwText SettingsDeviceSwitcher}" />

    <TextBlock Classes="hint" Margin="0,8,0,0" Text="{l:NcwText ModelsUnavailable}" IsVisible="{Binding !IsAvailable}" />

    <StackPanel IsVisible="{Binding IsAvailable}" Spacing="8">
      <models:ModelsNotices />

      <!-- 供应商 -->
      <Grid ColumnDefinitions="*,Auto" Margin="0,12,0,0">
        <TextBlock Classes="sectionTitle" Margin="0" Text="{l:NcwText ProvidersTitle}" VerticalAlignment="Center" />
        <ui:NcwButton Grid.Column="1" Variant="Secondary" Command="{Binding NewProviderCommand}" IsVisible="{Binding CanEdit}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <lucide:LucideIcon Kind="Plus" Size="14" VerticalAlignment="Center" />
            <TextBlock Text="{l:NcwText AddProvider}" />
          </StackPanel>
        </ui:NcwButton>
      </Grid>
      <TextBlock Classes="hint" Text="{l:NcwText NoProviders}" IsVisible="{Binding !HasProviders}" ui:NcwMotion.ShowMotion="Fade" />

      <ItemsControl ItemsSource="{Binding Providers}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="8" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ProviderItemViewModel">
            <Border Classes="card" Padding="0">
              <StackPanel>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="14,12">
                  <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Top" Margin="0,7,0,0"
                          Background="{arc:ArcDesignTokenResource Success}" IsVisible="{Binding IsEnabled}" />
                  <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Top" Margin="0,7,0,0"
                          BorderThickness="1.5" BorderBrush="{arc:ArcDesignTokenResource BorderStrong}" IsVisible="{Binding !IsEnabled}" />
                  <models:ProviderSummary Grid.Column="1" />
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Top">
                    <ui:NcwSwitch Margin="0,0,6,0" VerticalAlignment="Center" IsChecked="{Binding IsEnabled, Mode=OneWay}" Command="{Binding ToggleEnabledCommand}"
                                  AutomationProperties.Name="{l:NcwText ProviderEnabled}" arc:Tooltip.Tip="{l:NcwText ProviderEnabled}" />
                    <ui:NcwButton Classes="icon" Variant="Ghost" Command="{Binding ToggleExpandedCommand}" AutomationProperties.Name="{l:NcwText ProviderModels}" arc:Tooltip.Tip="{l:NcwText ProviderModels}">
                      <lucide:LucideIcon Classes="chevronDown" Classes.open="{Binding IsExpanded}" Kind="ChevronDown" Size="15" />
                    </ui:NcwButton>
                  </StackPanel>
                </Grid>
                <!-- 展开:操作 + 模型别名 -->
                <ui:NcwCollapsible IsOpen="{Binding IsExpanded}">
                  <models:ProviderDetail Margin="14,0,14,12" />
                </ui:NcwCollapsible>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <models:ProviderProblems />

      <!-- 从其他应用导入:设备支持、能写才显示(桌面是列表栏里的一项) -->
      <Border Classes="card" IsVisible="{Binding ShowsDiscoveryEntry}">
        <models:ProviderDiscoveryPanel DataContext="{Binding Discovery}" />
      </Border>

      <models:ModelsCatalogCard />
    </StackPanel>
  </StackPanel>
</UserControl>
