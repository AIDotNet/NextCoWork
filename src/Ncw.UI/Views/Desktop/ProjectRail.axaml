<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Ncw.UI.Localization"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:ui="using:Ncw.UI.Controls"
             xmlns:cv="using:Ncw.UI.Converters"
             xmlns:vm="using:Ncw.Client.ViewModels"
             xmlns:rail="using:Ncw.UI.Views.Desktop.Rail"
             x:Class="Ncw.UI.Views.Desktop.ProjectRail"
             x:DataType="vm:RailViewModel">
  <!-- 栏 1:项目栏(64px)。项目图标 + 项目组胶囊;状态角标统一来自 ProjectActivityView(docs/design/03 §1)。 -->
  <UserControl.DataTemplates>
    <DataTemplate DataType="vm:RailProjectViewModel">
      <rail:RailProjectTile />
    </DataTemplate>
    <DataTemplate DataType="vm:RailGroupViewModel">
      <rail:RailGroupView />
    </DataTemplate>
  </UserControl.DataTemplates>

  <Panel>
  <DockPanel>
    <!-- 底部:账户、设置 -->
    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,12" Spacing="8">
      <ui:NcwAvatar HorizontalAlignment="Center" DisplayName="Token" Status="Online" />
      <ui:PlainButton Width="36" Height="36" HorizontalAlignment="Center" AutomationProperties.Name="{l:NcwText Settings}" arc:Tooltip.Tip="{l:NcwText Settings}">
        <lucide:LucideIcon Kind="Settings" Size="18" HorizontalAlignment="Center" />
      </ui:PlainButton>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Hidden">
      <StackPanel Margin="0,4,0,0">
        <ItemsControl ItemsSource="{Binding Items}" />
        <ui:PlainButton Width="40"
                        Height="40"
                        Margin="0,6,0,0"
                        HorizontalAlignment="Center"
                        AutomationProperties.Name="{l:NcwText AddProject}" arc:Tooltip.Tip="{l:NcwText AddProject}">
          <lucide:LucideIcon Kind="Plus" Size="18" HorizontalAlignment="Center" />
        </ui:PlainButton>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
  <!-- 拖放的落点提示 -->
  <Canvas x:Name="MarkLayer" IsHitTestVisible="False">
    <Border x:Name="DropLine" Width="44" Height="2" CornerRadius="1" Canvas.Left="10"
            Background="{arc:ArcDesignTokenResource Accent}" IsVisible="False" />
    <Border x:Name="DropRing" CornerRadius="14" BorderThickness="2"
            BorderBrush="{arc:ArcDesignTokenResource Accent}" IsVisible="False" />
  </Canvas>
  </Panel>
</UserControl>
