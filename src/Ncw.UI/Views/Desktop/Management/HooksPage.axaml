<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Ncw.UI.Localization"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:ui="using:Ncw.UI.Controls"
             xmlns:cv="using:Ncw.UI.Converters"
             xmlns:vm="using:Ncw.Client.ViewModels"
             xmlns:p="using:Ncw.Protocol.Methods"
             xmlns:m="using:Ncw.UI.Views.Desktop.Management"
             x:Class="Ncw.UI.Views.Desktop.Management.HooksPage"
             x:DataType="vm:HooksViewModel">
  <!--
    设置 · 设备 · Hooks:清单(全局 + 当前项目)、新建 / 编辑(事件、匹配器、命令 / 提示词、超时、环境变量)、启停、删除确认、试运行(输出由设备脱敏)、配置诊断。
    命令文本 member 起可见(viewer 不给);写入与试运行 owner,因为命令会在设备上执行。环境变量的值只写不读。
  -->
  <StackPanel Spacing="8">
    <m:PageHeader Title="{l:NcwText SettingsHooks}" Hint="{l:NcwText SettingsHooksHint}" ScopeText="{l:NcwText ScopeDevice}" ShowProject="True" />
    <m:PageStatus />

    <StackPanel Spacing="8" IsVisible="{Binding ShowsContent}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBlock Classes="hint" VerticalAlignment="Center" Text="{l:NcwText HooksRunNote}" />
        <ui:NcwButton Grid.Column="1" Variant="Secondary" Command="{Binding NewCommand}" IsEnabled="{Binding CanWrite}"
                      arc:Tooltip.Tip="{Binding WriteGate, Converter={x:Static cv:GateTextConverter.Instance}}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <lucide:LucideIcon Kind="Plus" Size="14" VerticalAlignment="Center" />
            <TextBlock Text="{l:NcwText HooksNew}" />
          </StackPanel>
        </ui:NcwButton>
      </Grid>

      <!-- 删除确认 -->
      <Border Classes="card danger" IsVisible="{Binding HasPendingDelete}">
        <StackPanel Spacing="8">
          <TextBlock FontWeight="SemiBold" Text="{Binding PendingDelete.Subject, Converter={x:Static cv:TextFormatConverter.Instance}, ConverterParameter=HooksDeleteTitle}" />
          <TextBlock Classes="hint" Text="{l:NcwText HooksDeleteHint}" />
          <WrapPanel Orientation="Horizontal">
            <ui:NcwButton Margin="0,0,8,0" Variant="Danger" Command="{Binding ConfirmDeleteCommand}" Content="{l:NcwText DeleteLabel}" />
            <ui:NcwButton Variant="Ghost" Command="{Binding CancelDeleteCommand}" Content="{l:NcwText Cancel}" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <!-- 编辑器 -->
      <Border Classes="card" IsVisible="{Binding Editor.IsOpen}">
        <StackPanel Spacing="10" DataContext="{Binding Editor}" x:DataType="vm:HookEditorViewModel">
          <TextBlock FontWeight="SemiBold" IsVisible="{Binding IsNew}" Text="{l:NcwText HooksNewTitle}" />
          <TextBlock FontWeight="SemiBold" IsVisible="{Binding !IsNew}" Text="{l:NcwText HooksEditTitle}" />
          <Grid ColumnDefinitions="*,12,*">
            <ui:NcwSelect ChoiceSet="HookEvent" SelectedValue="{Binding Event, Mode=TwoWay}" Label="{l:NcwText HooksEvent}" />
            <ui:NcwSelect Grid.Column="2" ChoiceSet="HookType" SelectedValue="{Binding Type, Mode=TwoWay}" Label="{l:NcwText HooksType}" />
          </Grid>
          <ui:NcwSelect ChoiceSet="HookScope" SelectedValue="{Binding Scope, Mode=TwoWay}" IsEnabled="{Binding IsNew}" Label="{l:NcwText HooksScope}" Description="{l:NcwText HooksScopeHint}" />
          <ui:NcwInput Text="{Binding Matcher, Mode=TwoWay}" Label="{l:NcwText HooksMatcher}" Description="{l:NcwText HooksMatcherHint}" Placeholder="Bash(git *)" />
          <ui:NcwTextArea Text="{Binding Command, Mode=TwoWay}" IsVisible="{Binding IsCommand}" Label="{l:NcwText HooksCommand}" FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}" MinHeight="72" />
          <ui:NcwTextArea Text="{Binding Prompt, Mode=TwoWay}" IsVisible="{Binding !IsCommand}" Label="{l:NcwText HooksPrompt}" Description="{l:NcwText HooksPromptHint}" MinHeight="96" />
          <Grid ColumnDefinitions="140,12,*">
            <ui:NcwNumberField Minimum="1" Maximum="600" Step="5" UseGrouping="False" Value="{Binding TimeoutSeconds, Mode=TwoWay}" Label="{l:NcwText HooksTimeout}" />
            <ui:NcwInput Grid.Column="2" Text="{Binding Description, Mode=TwoWay}" Label="{l:NcwText HooksDescription}" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock VerticalAlignment="Center" Text="{l:NcwText HooksEnabled}" />
            <ui:NcwSwitch Grid.Column="1" IsChecked="{Binding Enabled, Mode=TwoWay}" AutomationProperties.Name="{l:NcwText HooksEnabled}" />
          </Grid>

          <!-- 环境变量:值只写不读(留空 = 沿用已存的值) -->
          <StackPanel Spacing="6" IsVisible="{Binding IsCommand}">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2">
                <TextBlock FontWeight="SemiBold" Text="{l:NcwText HooksEnvTitle}" />
                <TextBlock Classes="hint" Text="{l:NcwText HooksEnvHint}" />
              </StackPanel>
              <ui:NcwButton Grid.Column="1" Variant="Ghost" Command="{Binding $parent[UserControl].((vm:HooksViewModel)DataContext).AddEnvCommand}" Content="{l:NcwText HooksEnvAdd}" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Env}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:HookEnvRowViewModel">
                  <Grid ColumnDefinitions="*,8,*,Auto">
                    <ui:NcwInput Text="{Binding Name, Mode=TwoWay}" Placeholder="NAME" />
                    <ui:NcwInput Grid.Column="2" Text="{Binding Value, Mode=TwoWay}" PasswordChar="•" Placeholder="{l:NcwText HooksEnvValuePlaceholder}" />
                    <ui:NcwButton Grid.Column="3" Classes="icon" Variant="Ghost" Command="{Binding $parent[UserControl].((vm:HooksViewModel)DataContext).RemoveEnvCommand}" CommandParameter="{Binding}"
                                  AutomationProperties.Name="{l:NcwText HooksEnvRemove}" arc:Tooltip.Tip="{l:NcwText HooksEnvRemove}">
                      <lucide:LucideIcon Kind="X" Size="13" />
                    </ui:NcwButton>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <TextBlock Classes="hint" Foreground="{arc:ArcDesignTokenResource Warning}" TextWrapping="Wrap" IsVisible="{Binding WarningKey, Converter={x:Static ObjectConverters.IsNotNull}}"
                     Text="{Binding WarningKey, Converter={x:Static cv:FailureTextConverter.Instance}}" />
          <TextBlock Classes="hint" Foreground="{arc:ArcDesignTokenResource Danger}" Text="{Binding Problems, Converter={x:Static cv:FormProblemTextConverter.Instance}}" IsVisible="{Binding !CanSave}" />
          <TextBlock Foreground="{arc:ArcDesignTokenResource Danger}" TextWrapping="Wrap" IsVisible="{Binding SaveFailure, Converter={x:Static ObjectConverters.IsNotNull}}"
                     Text="{Binding SaveFailure, Converter={x:Static cv:FailureTextConverter.Instance}}" />

          <!-- 试运行结果(设备已脱敏) -->
          <Border Classes="card" IsVisible="{Binding $parent[UserControl].((vm:HooksViewModel)DataContext).TestReport, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel Spacing="6" DataContext="{Binding $parent[UserControl].((vm:HooksViewModel)DataContext).TestReport}" x:DataType="p:HookRunReportDto">
              <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="4">
                <ui:NcwStatusDot Tone="{Binding Outcome, Converter={x:Static cv:ToneConverter.Instance}}" />
                <TextBlock FontWeight="SemiBold" Text="{Binding Outcome, Converter={x:Static cv:KeyTextConverter.Instance}, ConverterParameter=HookOutcome}" />
                <TextBlock Classes="hint" VerticalAlignment="Center" Text="{Binding DurationMs, Converter={x:Static cv:DurationTextConverter.Instance}}" />
                <TextBlock Classes="hint" VerticalAlignment="Center" IsVisible="{Binding ExitCode, Converter={x:Static ObjectConverters.IsNotNull}}"
                           Text="{Binding ExitCode, Converter={x:Static cv:TextFormatConverter.Instance}, ConverterParameter=HooksExitCode}" />
                <TextBlock Classes="hint" VerticalAlignment="Center" IsVisible="{Binding Decision, Converter={x:Static ObjectConverters.IsNotNull}}"
                           Text="{Binding Decision, Converter={x:Static cv:KeyTextConverter.Instance}, ConverterParameter=HookDecision}" />
              </WrapPanel>
              <TextBlock Classes="hint" IsVisible="{Binding Reason, Converter={x:Static ObjectConverters.IsNotNull}}" Text="{Binding Reason}" />
              <TextBlock Classes="hint" Text="{Binding PromptVerdict, Converter={x:Static cv:KeyTextConverter.Instance}, ConverterParameter=HookVerdict}" IsVisible="{Binding PromptVerdict, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <SelectableTextBlock Classes="mono" TextWrapping="Wrap" IsVisible="{Binding Preview, Converter={x:Static ObjectConverters.IsNotNull}}" Text="{Binding Preview}" />
              <TextBlock Classes="section" Text="stdout" IsVisible="{Binding Stdout, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <SelectableTextBlock Classes="mono" TextWrapping="Wrap" IsVisible="{Binding Stdout, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Text="{Binding Stdout}" />
              <TextBlock Classes="section" Text="stderr" IsVisible="{Binding Stderr, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <SelectableTextBlock Classes="mono" TextWrapping="Wrap" IsVisible="{Binding Stderr, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Text="{Binding Stderr}" Foreground="{arc:ArcDesignTokenResource Danger}" />
              <TextBlock Classes="hint" Text="{l:NcwText HooksRedacted}" />
            </StackPanel>
          </Border>

          <WrapPanel Orientation="Horizontal">
            <ui:NcwButton Margin="0,0,8,0" Variant="Primary" Command="{Binding $parent[UserControl].((vm:HooksViewModel)DataContext).SaveCommand}" IsEnabled="{Binding CanSave}" IsLoading="{Binding IsSaving}" Content="{l:NcwText Save}" />
            <ui:NcwButton Margin="0,0,8,0" Variant="Secondary" Command="{Binding $parent[UserControl].((vm:HooksViewModel)DataContext).TestCommand}" IsEnabled="{Binding CanSave}"
                          IsLoading="{Binding $parent[UserControl].((vm:HooksViewModel)DataContext).IsTesting}" Content="{l:NcwText HooksTest}" />
            <ui:NcwButton Variant="Ghost" Command="{Binding $parent[UserControl].((vm:HooksViewModel)DataContext).CloseEditorCommand}" Content="{l:NcwText Cancel}" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <Border Classes="card" IsVisible="{Binding ShowsEmpty}">
        <StackPanel Spacing="6" HorizontalAlignment="Center" Margin="0,12">
          <lucide:LucideIcon Kind="Webhook" Size="24" HorizontalAlignment="Center" Foreground="{arc:ArcDesignTokenResource TextMuted}" />
          <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="{l:NcwText HooksEmptyTitle}" />
          <TextBlock Classes="hint" HorizontalAlignment="Center" TextAlignment="Center" Text="{l:NcwText HooksEmptyHint}" />
        </StackPanel>
      </Border>

      <ItemsControl ItemsSource="{Binding Hooks}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:HookRowViewModel">
            <Border Classes="card" Padding="14,12">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="4">
                  <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="4">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Event, Converter={x:Static cv:KeyTextConverter.Instance}, ConverterParameter=HookEvent}" />
                    <Border Classes="chip"><TextBlock Classes="hint" Text="{Binding Type, Converter={x:Static cv:KeyTextConverter.Instance}, ConverterParameter=HookType}" /></Border>
                    <Border Classes="chip"><TextBlock Classes="hint" Text="{Binding Scope, Converter={x:Static cv:KeyTextConverter.Instance}, ConverterParameter=HookScope}" /></Border>
                    <Border Classes="chip" IsVisible="{Binding Matcher, Converter={x:Static ObjectConverters.IsNotNull}}"><TextBlock Classes="mono" Text="{Binding Matcher}" /></Border>
                  </WrapPanel>
                  <TextBlock Classes="hint" IsVisible="{Binding Description, Converter={x:Static ObjectConverters.IsNotNull}}" Text="{Binding Description}" />
                  <TextBlock Classes="mono" Foreground="{arc:ArcDesignTokenResource TextSecondary}" Text="{Binding Body}" MaxLines="2" TextTrimming="CharacterEllipsis" />
                  <WrapPanel Orientation="Horizontal" ItemSpacing="10">
                    <TextBlock Classes="hint" Text="{Binding TimeoutSeconds, Converter={x:Static cv:TextFormatConverter.Instance}, ConverterParameter=HooksTimeoutSeconds}" />
                    <TextBlock Classes="hint" IsVisible="{Binding HasEnv}" Text="{Binding EnvNames, Converter={x:Static cv:JoinConverter.Instance}}" />
                  </WrapPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Top">
                  <ui:NcwSwitch Margin="0,0,6,0" VerticalAlignment="Center" IsChecked="{Binding Enabled, Mode=OneWay}" Command="{Binding ToggleCommand}"
                                IsEnabled="{Binding $parent[ItemsControl].((vm:HooksViewModel)DataContext).CanWrite}" AutomationProperties.Name="{l:NcwText HooksEnabled}" />
                  <ui:NcwButton Classes="icon" Variant="Ghost" Command="{Binding EditCommand}" IsEnabled="{Binding $parent[ItemsControl].((vm:HooksViewModel)DataContext).CanWrite}"
                                AutomationProperties.Name="{l:NcwText Edit}" arc:Tooltip.Tip="{l:NcwText Edit}">
                    <lucide:LucideIcon Kind="Pencil" Size="13" />
                  </ui:NcwButton>
                  <ui:NcwButton Classes="icon" Variant="Ghost" Command="{Binding AskDeleteCommand}" IsEnabled="{Binding $parent[ItemsControl].((vm:HooksViewModel)DataContext).CanWrite}"
                                AutomationProperties.Name="{l:NcwText DeleteLabel}" arc:Tooltip.Tip="{l:NcwText DeleteLabel}">
                    <lucide:LucideIcon Kind="Trash2" Size="13" />
                  </ui:NcwButton>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <StackPanel Spacing="4" IsVisible="{Binding HasDiagnostics}">
        <TextBlock Classes="sectionTitle" Text="{l:NcwText DiagnosticsTitle}" />
        <ItemsControl ItemsSource="{Binding Diagnostics}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="p:HookDiagnosticDto">
              <StackPanel Spacing="1" Margin="0,2">
                <TextBlock Classes="hint" Foreground="{arc:ArcDesignTokenResource Warning}" Text="{Binding Key, Converter={x:Static cv:DiagnosticTextConverter.Instance}}" />
                <TextBlock Classes="mono" Foreground="{arc:ArcDesignTokenResource TextMuted}" Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </StackPanel>
  </StackPanel>
</UserControl>
