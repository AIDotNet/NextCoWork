<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Ncw.UI.Localization"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:ui="using:Ncw.UI.Controls"
             xmlns:cv="using:Ncw.UI.Converters"
             xmlns:vm="using:Ncw.Client.ViewModels"
             xmlns:p="using:Ncw.Protocol.Methods"
             xmlns:m="using:Ncw.UI.Views.Desktop.Management"
             x:Class="Ncw.UI.Views.Desktop.Management.StoragePage"
             x:DataType="vm:StorageViewModel">
  <!--
    设置 · 设备 · 存储:统计、备份、整理 / 回收附件 / 导出(owner,远程也行),以及危险区(清理 / 清空历史 / 清除数据 / 恢复备份 / 导入):
    owner + 仅本机 + 二次确认 —— 先预览得到令牌并显示将被删除 / 覆盖的数量,确认(不可撤销的要勾选)后才执行。
  -->
  <StackPanel Spacing="8">
    <m:PageHeader Title="{l:NcwText SettingsStorage}" Hint="{l:NcwText SettingsStorageHint}" ScopeText="{l:NcwText ScopeDevice}" />
    <m:PageStatus />

    <StackPanel Spacing="8" IsVisible="{Binding ShowsContent}" ui:NcwMotion.ShowMotion="Fade">
      <!-- 统计 -->
      <TextBlock Classes="sectionTitle" Text="{l:NcwText StorageStatsTitle}" />
      <Border Classes="card" DataContext="{Binding Stats}" x:DataType="p:StorageStatsDto">
        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{l:NcwText StorageDatabase}" /><TextBlock Grid.Column="1" Classes="hint" Text="{Binding DbBytes, Converter={x:Static cv:BytesTextConverter.Instance}}" /></Grid>
          <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{l:NcwText StorageConversations}" /><TextBlock Grid.Column="1" Classes="hint" Text="{Binding ConversationBytes, Converter={x:Static cv:BytesTextConverter.Instance}}" /></Grid>
          <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{l:NcwText StorageAttachments}" /><TextBlock Grid.Column="1" Classes="hint" Text="{Binding AttachmentBytes, Converter={x:Static cv:BytesTextConverter.Instance}}" /></Grid>
          <TextBlock Classes="hint">
            <Run Text="{Binding ConversationCount}" /><Run Text=" " /><Run Text="{l:NcwText StorageUnitSessions}" /><Run Text=" · " /><Run Text="{Binding MessageCount}" /><Run Text=" " /><Run Text="{l:NcwText StorageUnitMessages}" /><Run Text=" · " /><Run Text="{Binding AttachmentCount}" /><Run Text=" " /><Run Text="{l:NcwText StorageUnitAttachments}" /><Run Text=" · " /><Run Text="{Binding WorkspaceCount}" /><Run Text=" " /><Run Text="{l:NcwText StorageUnitProjects}" />
          </TextBlock>
        </StackPanel>
      </Border>

      <!-- 备份 -->
      <TextBlock Classes="sectionTitle" Text="{l:NcwText StorageBackupTitle}" />
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="hint" Text="{l:NcwText StorageBackupHint}" />
          <StackPanel Spacing="2" IsVisible="{Binding $parent[UserControl].((vm:StorageViewModel)DataContext).Backup, Converter={x:Static ObjectConverters.IsNotNull}}" DataContext="{Binding Backup}" x:DataType="p:BackupStatusDto">
            <TextBlock IsVisible="{Binding LastBackupAt, Converter={x:Static ObjectConverters.IsNotNull}}"
                       Text="{Binding LastBackupAt, Converter={x:Static cv:DateTimeTextConverter.Instance}, ConverterParameter=full}" />
            <TextBlock Classes="hint" IsVisible="{Binding LastBackupAt, Converter={x:Static ObjectConverters.IsNull}}" Text="{l:NcwText StorageNoBackupYet}" />
            <TextBlock Classes="mono" Foreground="{arc:ArcDesignTokenResource TextMuted}" IsVisible="{Binding LastBackupPath, Converter={x:Static ObjectConverters.IsNotNull}}" Text="{Binding LastBackupPath}" TextTrimming="CharacterEllipsis" />
            <TextBlock Classes="hint" Foreground="{arc:ArcDesignTokenResource Danger}" IsVisible="{Binding LastError, Converter={x:Static ObjectConverters.IsNotNull}}" Text="{Binding LastError, Converter={x:Static cv:FailureTextConverter.Instance}}" />
            <TextBlock Classes="hint" IsVisible="{Binding Running}" Text="{l:NcwText StorageBackupRunning}" />
          </StackPanel>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsEnabled="{Binding OwnerGate.Allowed}">
            <ui:NcwInput Text="{Binding BackupDirectory, Mode=TwoWay}" Label="{l:NcwText StorageBackupDirectory}" Description="{l:NcwText StorageBackupDirectoryHint}" />
            <ui:NcwButton Grid.Column="1" VerticalAlignment="Top" Margin="0,24,0,0" Variant="Secondary" Command="{Binding PickBackupDirectoryCommand}" IsVisible="{Binding Scope.IsLocalChannel}" Content="{l:NcwText StorageChooseFolder}" />
          </Grid>
          <ui:NcwSelect ChoiceSet="BackupFrequency" SelectedValue="{Binding BackupFrequency, Mode=TwoWay}" IsEnabled="{Binding OwnerGate.Allowed}" Label="{l:NcwText StorageBackupFrequency}" />
          <WrapPanel Orientation="Horizontal">
            <ui:NcwButton Margin="0,0,8,0" Variant="Secondary" Command="{Binding ApplyBackupSettingsCommand}" IsEnabled="{Binding OwnerGate.Allowed}" IsVisible="{Binding BackupDirty}" ui:NcwMotion.ShowMotion="Fade" ui:NcwMotion.ShowTier="Fast" Content="{l:NcwText Apply}" />
            <ui:NcwButton Variant="Primary" Command="{Binding CreateBackupCommand}" IsEnabled="{Binding OwnerGate.Allowed}" IsLoading="{Binding IsBusy}"
                          arc:Tooltip.Tip="{Binding OwnerGate, Converter={x:Static cv:GateTextConverter.Instance}}" Content="{l:NcwText StorageBackupNow}" />
          </WrapPanel>
          <TextBlock Classes="hint" Foreground="{arc:ArcDesignTokenResource Success}" IsVisible="{Binding BackupJustCreated}" ui:NcwMotion.ShowMotion="Rise" Text="{l:NcwText StorageBackupCreated}" />
        </StackPanel>
      </Border>

      <!-- 不会丢内容的维护 -->
      <TextBlock Classes="sectionTitle" Text="{l:NcwText StorageMaintenanceTitle}" />
      <Border Classes="card">
        <StackPanel Spacing="12" IsEnabled="{Binding OwnerGate.Allowed}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="2"><TextBlock Text="{l:NcwText StorageVacuum}" /><TextBlock Classes="hint" Text="{l:NcwText StorageVacuumHint}" /></StackPanel>
            <ui:NcwButton Grid.Column="1" Variant="Secondary" Command="{Binding VacuumCommand}" Content="{l:NcwText StorageRun}" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="2"><TextBlock Text="{l:NcwText StorageCleanAttachments}" /><TextBlock Classes="hint" Text="{l:NcwText StorageCleanAttachmentsHint}" /></StackPanel>
            <ui:NcwButton Grid.Column="1" Variant="Secondary" Command="{Binding CleanAttachmentsCommand}" Content="{l:NcwText StorageRun}" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="2"><TextBlock Text="{l:NcwText StorageExport}" /><TextBlock Classes="hint" Text="{l:NcwText StorageExportHint}" /></StackPanel>
            <ui:NcwButton Grid.Column="1" Variant="Secondary" Command="{Binding ExportCommand}" Content="{l:NcwText StorageExportAction}" />
          </Grid>
        </StackPanel>
      </Border>
      <TextBlock Classes="hint" Foreground="{arc:ArcDesignTokenResource Success}" IsVisible="{Binding Vacuumed}" ui:NcwMotion.ShowMotion="Rise" Text="{l:NcwText StorageVacuumed}" />
      <TextBlock Classes="hint" Foreground="{arc:ArcDesignTokenResource Success}" IsVisible="{Binding ExportDone}" ui:NcwMotion.ShowMotion="Rise" Text="{l:NcwText StorageExported}" />
      <TextBlock Classes="hint" Foreground="{arc:ArcDesignTokenResource Success}" IsVisible="{Binding AttachmentsResult, Converter={x:Static ObjectConverters.IsNotNull}}" ui:NcwMotion.ShowMotion="Rise"
                 Text="{Binding AttachmentsResult.Deleted, Converter={x:Static cv:TextFormatConverter.Instance}, ConverterParameter=StorageAttachmentsCleaned}" />

      <!-- ═══ 危险区 ═══ -->
      <TextBlock Classes="sectionTitle" Foreground="{arc:ArcDesignTokenResource Danger}" Text="{l:NcwText StorageDangerTitle}" />
      <Border Classes="card danger">
        <StackPanel Spacing="12">
          <TextBlock Classes="hint" Text="{l:NcwText StorageDangerHint}" />
          <Border Classes="notice" IsVisible="{Binding !DangerGate.Allowed}">
            <TextBlock Classes="hint" Foreground="{arc:ArcDesignTokenResource TextSecondary}" Text="{Binding DangerGate, Converter={x:Static cv:GateTextConverter.Instance}}" />
          </Border>

          <!-- 操作入口(没有进行中的流程时) -->
          <StackPanel Spacing="12" IsVisible="{Binding IsDangerIdle}" ui:NcwMotion.ShowMotion="Fade" IsEnabled="{Binding DangerGate.Allowed}">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <StackPanel Spacing="2"><TextBlock Text="{l:NcwText StorageCleanAge}" /><TextBlock Classes="hint" Text="{l:NcwText StorageCleanAgeHint}" /></StackPanel>
              <ui:NcwSelect Grid.Column="1" ChoiceSet="CleanupAge" MinWidth="120" SelectedValue="{Binding Age, Mode=TwoWay}" AutomationProperties.Name="{l:NcwText StorageCleanAge}" />
              <ui:NcwButton Grid.Column="2" Variant="Danger" Command="{Binding PreviewCleanupCommand}" CommandParameter="{x:Static vm:DangerKind.CleanupAge}" Content="{l:NcwText StoragePreview}" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel Spacing="2"><TextBlock Text="{l:NcwText StorageCleanHistory}" /><TextBlock Classes="hint" Text="{l:NcwText StorageCleanHistoryHint}" /></StackPanel>
              <ui:NcwButton Grid.Column="1" Variant="Danger" Command="{Binding PreviewCleanupCommand}" CommandParameter="{x:Static vm:DangerKind.CleanupHistory}" Content="{l:NcwText StoragePreview}" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel Spacing="2"><TextBlock Text="{l:NcwText StorageCleanLocal}" /><TextBlock Classes="hint" Text="{l:NcwText StorageCleanLocalHint}" /></StackPanel>
              <ui:NcwButton Grid.Column="1" Variant="Danger" Command="{Binding PreviewCleanupCommand}" CommandParameter="{x:Static vm:DangerKind.CleanupLocalData}" Content="{l:NcwText StoragePreview}" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel Spacing="2"><TextBlock Text="{l:NcwText StorageRestore}" /><TextBlock Classes="hint" Text="{l:NcwText StorageRestoreHint}" /></StackPanel>
              <ui:NcwButton Grid.Column="1" Variant="Danger" Command="{Binding PreviewCleanupCommand}" CommandParameter="{x:Static vm:DangerKind.Restore}" Content="{l:NcwText StorageChooseFile}" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel Spacing="2"><TextBlock Text="{l:NcwText StorageImport}" /><TextBlock Classes="hint" Text="{l:NcwText StorageImportHint}" /></StackPanel>
              <ui:NcwButton Grid.Column="1" Variant="Danger" Command="{Binding PreviewCleanupCommand}" CommandParameter="{x:Static vm:DangerKind.Import}" Content="{l:NcwText StorageChooseFile}" />
            </Grid>
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsWorking}" ui:NcwMotion.ShowMotion="Fade">
            <lucide:LucideIcon Classes="spin" Kind="LoaderCircle" Size="14" VerticalAlignment="Center" />
            <TextBlock Classes="hint" Text="{l:NcwText PageLoading}" />
          </StackPanel>

          <!-- 二次确认:展示预览的数字 -->
          <ui:NcwCollapsible IsOpen="{Binding IsConfirming}">
            <Border Classes="card attention">
              <StackPanel Spacing="8">
                <TextBlock FontWeight="SemiBold" Text="{Binding Kind, Converter={x:Static cv:KeyTextConverter.Instance}, ConverterParameter=DangerConfirm}" />
                <!-- 清理 -->
                <StackPanel Spacing="2" IsVisible="{Binding $parent[UserControl].((vm:StorageViewModel)DataContext).CleanupPreview, Converter={x:Static ObjectConverters.IsNotNull}}" DataContext="{Binding CleanupPreview}" x:DataType="p:CleanupPreviewDto">
                  <TextBlock Text="{Binding SessionCount, Converter={x:Static cv:TextFormatConverter.Instance}, ConverterParameter=StoragePreviewSessions}" />
                  <TextBlock Classes="hint">
                    <Run Text="{Binding MessageCount}" /><Run Text=" " /><Run Text="{l:NcwText StorageUnitMessages}" /><Run Text=" · " /><Run Text="{Binding AttachmentCount}" /><Run Text=" " /><Run Text="{l:NcwText StorageUnitAttachments}" /><Run Text=" · " /><Run Text="{Binding Bytes, Converter={x:Static cv:BytesTextConverter.Instance}}" />
                  </TextBlock>
                  <TextBlock Classes="hint" Foreground="{arc:ArcDesignTokenResource Warning}" IsVisible="{Binding $parent[UserControl].((vm:StorageViewModel)DataContext).HasUndeletable}" Text="{l:NcwText StoragePreviewUndeletable}" />
                </StackPanel>
                <!-- 恢复 -->
                <StackPanel Spacing="2" IsVisible="{Binding $parent[UserControl].((vm:StorageViewModel)DataContext).RestorePreview, Converter={x:Static ObjectConverters.IsNotNull}}" DataContext="{Binding RestorePreview}" x:DataType="p:RestorePreviewDto">
                  <TextBlock Classes="mono" Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Classes="hint">
                    <Run Text="{Binding Manifest.AppVersion}" /><Run Text=" · " /><Run Text="{Binding Manifest.SessionCount}" /><Run Text=" " /><Run Text="{l:NcwText StorageUnitSessions}" /><Run Text=" · " /><Run Text="{Binding Manifest.MessageCount}" /><Run Text=" " /><Run Text="{l:NcwText StorageUnitMessages}" />
                  </TextBlock>
                  <TextBlock Classes="hint" IsVisible="{Binding Manifest.CreatedAt, Converter={x:Static ObjectConverters.IsNotNull}}" Text="{Binding Manifest.CreatedAt, Converter={x:Static cv:DateTimeTextConverter.Instance}, ConverterParameter=full}" />
                </StackPanel>
                <!-- 导入 -->
                <StackPanel Spacing="2" IsVisible="{Binding $parent[UserControl].((vm:StorageViewModel)DataContext).ImportPreview, Converter={x:Static ObjectConverters.IsNotNull}}" DataContext="{Binding ImportPreview}" x:DataType="p:ImportPreviewDto">
                  <TextBlock Classes="hint">
                    <Run Text="{Binding Sessions}" /><Run Text=" " /><Run Text="{l:NcwText StorageUnitSessions}" /><Run Text=" · " /><Run Text="{Binding Messages}" /><Run Text=" " /><Run Text="{l:NcwText StorageUnitMessages}" />
                  </TextBlock>
                  <TextBlock Text="{Binding OverwriteCount, Converter={x:Static cv:TextFormatConverter.Instance}, ConverterParameter=StorageImportOverwrite}" />
                  <TextBlock Classes="hint" Text="{Binding NewCount, Converter={x:Static cv:TextFormatConverter.Instance}, ConverterParameter=StorageImportNew}" />
                </StackPanel>
                <ui:NcwCheckbox IsChecked="{Binding Acknowledged, Mode=TwoWay}" IsVisible="{Binding NeedsAcknowledge}" Content="{l:NcwText StorageAcknowledge}" />
                <WrapPanel Orientation="Horizontal">
                  <ui:NcwButton Margin="0,0,8,0" Variant="Danger" Command="{Binding ConfirmCommand}" IsEnabled="{Binding CanConfirm}" Content="{l:NcwText StorageConfirmExecute}" />
                  <ui:NcwButton Variant="Ghost" Command="{Binding CancelDangerCommand}" Content="{l:NcwText Cancel}" />
                </WrapPanel>
                <TextBlock Classes="hint" Text="{l:NcwText StorageTokenHint}" />
              </StackPanel>
            </Border>
          </ui:NcwCollapsible>

          <!-- 完成 -->
          <Border Classes="notice" IsVisible="{Binding IsDone}" ui:NcwMotion.ShowMotion="Rise">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding CleanupResult.Deleted, Converter={x:Static cv:TextFormatConverter.Instance}, ConverterParameter=StorageDoneDeleted}" IsVisible="{Binding CleanupResult, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <TextBlock Text="{l:NcwText StorageDoneRestored}" IsVisible="{Binding RestoreResult, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <TextBlock Text="{Binding ImportResult.Imported, Converter={x:Static cv:TextFormatConverter.Instance}, ConverterParameter=StorageDoneImported}" IsVisible="{Binding ImportResult, Converter={x:Static ObjectConverters.IsNotNull}}" />
              </StackPanel>
              <ui:NcwButton Grid.Column="1" Variant="Ghost" Command="{Binding DismissDoneCommand}" Content="{l:NcwText Dismiss}" />
            </Grid>
          </Border>

          <TextBlock Foreground="{arc:ArcDesignTokenResource Danger}" TextWrapping="Wrap" IsVisible="{Binding DangerFailure, Converter={x:Static ObjectConverters.IsNotNull}}" ui:NcwMotion.ShowMotion="Fade"
                     Text="{Binding DangerFailure, Converter={x:Static cv:FailureTextConverter.Instance}}" />
        </StackPanel>
      </Border>

      <!-- ═══ 回到 NextCoWork 2.x(docs/design/04 §5):只在本机 owner、并且这份数据确实是从 2.x 迁移来的(迁移前的备份还在)时出现 ═══ -->
      <TextBlock Classes="sectionTitle" Foreground="{arc:ArcDesignTokenResource Danger}" IsVisible="{Binding ShowsRollback}" Text="{l:NcwText StorageRollbackTitle}" />
      <Border Classes="card danger" IsVisible="{Binding ShowsRollback}">
        <StackPanel Spacing="10">
          <TextBlock Classes="hint" TextWrapping="Wrap" Text="{l:NcwText StorageRollbackHint}" />
          <ui:NcwCheckbox IsChecked="{Binding RollbackAcknowledged, Mode=TwoWay}" Content="{l:NcwText StorageRollbackAcknowledge}" />
          <WrapPanel Orientation="Horizontal">
            <ui:NcwButton Variant="Danger" Command="{Binding RollBackToLegacyCommand}" IsEnabled="{Binding CanRollBack}" Content="{l:NcwText StorageRollbackAction}" />
          </WrapPanel>
          <!-- 已经请求、还没执行(退出被取消了):可以撤回 -->
          <Border Classes="notice" IsVisible="{Binding Rollback.Pending, FallbackValue=False}" ui:NcwMotion.ShowMotion="Fade">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBlock Classes="hint" TextWrapping="Wrap" VerticalAlignment="Center" Text="{l:NcwText StorageRollbackPending}" />
              <ui:NcwButton Grid.Column="1" Variant="Ghost" Command="{Binding CancelRollbackCommand}" Content="{l:NcwText StorageRollbackCancel}" />
            </Grid>
          </Border>
          <TextBlock Foreground="{arc:ArcDesignTokenResource Danger}" TextWrapping="Wrap" IsVisible="{Binding RollbackFailure, Converter={x:Static ObjectConverters.IsNotNull}}" ui:NcwMotion.ShowMotion="Fade"
                     Text="{Binding RollbackFailure, Converter={x:Static cv:FailureTextConverter.Instance}}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </StackPanel>
</UserControl>
