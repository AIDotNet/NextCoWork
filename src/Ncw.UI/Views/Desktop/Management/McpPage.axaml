<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Ncw.UI.Localization"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:ui="using:Ncw.UI.Controls"
             xmlns:cv="using:Ncw.UI.Converters"
             xmlns:vm="using:Ncw.Client.ViewModels"
             xmlns:p="using:Ncw.Protocol.Methods"
             xmlns:m="using:Ncw.UI.Views.Desktop.Management"
             x:Class="Ncw.UI.Views.Desktop.Management.McpPage"
             x:DataType="vm:McpViewModel">
  <!--
    设置 · 设备 · MCP:服务器列表与连接状态(mcp 主题全量权威)、新建 / 编辑(stdio / HTTP)、启停、重连、测试连接、删除确认、资源与提示浏览。
    密钥只写不读(只显示键名与「已设置」)。读取 member 起,写入 owner(会在设备上起进程 / 连网)。设备断开时状态是「未知」。
  -->
  <StackPanel Spacing="8">
    <m:PageHeader Title="{l:NcwText SettingsMcp}" Hint="{l:NcwText SettingsMcpHint}" ScopeText="{l:NcwText ScopeDevice}" ShowProject="True" />
    <m:PageStatus />

    <StackPanel Spacing="8" IsVisible="{Binding ShowsContent}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBlock Classes="hint" VerticalAlignment="Center" Text="{l:NcwText McpRunNote}" />
        <ui:NcwButton Grid.Column="1" Variant="Secondary" Command="{Binding NewCommand}" IsEnabled="{Binding CanWrite}"
                      arc:Tooltip.Tip="{Binding WriteGate, Converter={x:Static cv:GateTextConverter.Instance}}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <lucide:LucideIcon Kind="Plus" Size="14" VerticalAlignment="Center" />
            <TextBlock Text="{l:NcwText McpNew}" />
          </StackPanel>
        </ui:NcwButton>
      </Grid>

      <Border Classes="card danger" IsVisible="{Binding HasPendingRemove}">
        <StackPanel Spacing="8">
          <TextBlock FontWeight="SemiBold" Text="{Binding PendingRemove.Subject, Converter={x:Static cv:TextFormatConverter.Instance}, ConverterParameter=McpRemoveTitle}" />
          <TextBlock Classes="hint" Text="{l:NcwText McpRemoveHint}" />
          <WrapPanel Orientation="Horizontal">
            <ui:NcwButton Margin="0,0,8,0" Variant="Danger" Command="{Binding ConfirmRemoveCommand}" Content="{l:NcwText DeleteLabel}" />
            <ui:NcwButton Variant="Ghost" Command="{Binding CancelRemoveCommand}" Content="{l:NcwText Cancel}" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <!-- 编辑器 -->
      <Border Classes="card" IsVisible="{Binding Editor.IsOpen}">
        <StackPanel Spacing="10" DataContext="{Binding Editor}" x:DataType="vm:McpEditorViewModel">
          <TextBlock FontWeight="SemiBold" IsVisible="{Binding IsNew}" Text="{l:NcwText McpNewTitle}" />
          <TextBlock FontWeight="SemiBold" IsVisible="{Binding !IsNew}" Text="{l:NcwText McpEditTitle}" />
          <Grid ColumnDefinitions="*,12,*">
            <ui:NcwInput Text="{Binding Name, Mode=TwoWay}" Label="{l:NcwText McpName}" />
            <ui:NcwInput Grid.Column="2" Text="{Binding Id, Mode=TwoWay}" IsEnabled="{Binding IsNew}" Label="{l:NcwText McpId}" Description="{l:NcwText McpIdHint}" />
          </Grid>
          <ui:NcwSelect ChoiceSet="McpTransport" SelectedValue="{Binding Transport, Mode=TwoWay}" Label="{l:NcwText McpTransport}" />
          <ui:NcwInput Text="{Binding Description, Mode=TwoWay}" Label="{l:NcwText McpDescription}" />
          <StackPanel Spacing="10" IsVisible="{Binding IsStdio}">
            <ui:NcwInput Text="{Binding Command, Mode=TwoWay}" Label="{l:NcwText McpCommand}" Placeholder="npx" />
            <ui:NcwTextArea Text="{Binding Args, Mode=TwoWay}" Label="{l:NcwText McpArgs}" Description="{l:NcwText McpArgsHint}" MinHeight="64" FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}" />
            <ui:NcwInput Text="{Binding Cwd, Mode=TwoWay}" Label="{l:NcwText McpCwd}" />
          </StackPanel>
          <ui:NcwInput Text="{Binding Url, Mode=TwoWay}" IsVisible="{Binding !IsStdio}" Label="{l:NcwText McpUrl}" Placeholder="https://example.com/mcp" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="2">
              <TextBlock Text="{l:NcwText McpBindProject}" />
              <TextBlock Classes="hint" Text="{l:NcwText McpBindProjectHint}" />
            </StackPanel>
            <ui:NcwSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding BindToProject, Mode=TwoWay}" AutomationProperties.Name="{l:NcwText McpBindProject}" />
          </Grid>

          <!-- 密钥:环境变量(stdio)/ 请求头(远程)。值只写不读;写密钥是整张 map 一次写完 -->
          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2">
                <TextBlock FontWeight="SemiBold" IsVisible="{Binding IsStdio}" Text="{l:NcwText McpEnvTitle}" />
                <TextBlock FontWeight="SemiBold" IsVisible="{Binding !IsStdio}" Text="{l:NcwText McpHeadersTitle}" />
                <TextBlock Classes="hint" Text="{l:NcwText McpSecretsHint}" />
              </StackPanel>
              <ui:NcwButton Grid.Column="1" Variant="Ghost" Command="{Binding $parent[UserControl].((vm:McpViewModel)DataContext).AddSecretCommand}" Content="{l:NcwText McpSecretAdd}" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Secrets}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:McpSecretRowViewModel">
                  <Grid ColumnDefinitions="*,8,*,Auto">
                    <ui:NcwInput Text="{Binding Name, Mode=TwoWay}" Placeholder="NAME" />
                    <ui:NcwInput Grid.Column="2" Text="{Binding Value, Mode=TwoWay}" PasswordChar="•" Placeholder="{l:NcwText McpSecretValuePlaceholder}" />
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="6,0,0,0">
                      <Border Classes="chip" IsVisible="{Binding IsSet}"><TextBlock Classes="hint" Foreground="{arc:ArcDesignTokenResource Success}" Text="{l:NcwText McpSecretIsSet}" /></Border>
                      <ui:NcwButton Classes="icon" Variant="Ghost" Command="{Binding $parent[UserControl].((vm:McpViewModel)DataContext).RemoveSecretCommand}" CommandParameter="{Binding}"
                                    AutomationProperties.Name="{l:NcwText HooksEnvRemove}" arc:Tooltip.Tip="{l:NcwText HooksEnvRemove}">
                        <lucide:LucideIcon Kind="X" Size="13" />
                      </ui:NcwButton>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <TextBlock Classes="hint" Foreground="{arc:ArcDesignTokenResource Danger}" TextWrapping="Wrap" IsVisible="{Binding !CanSave}" Text="{Binding Problems, Converter={x:Static cv:FormProblemTextConverter.Instance}}" />
          <TextBlock Foreground="{arc:ArcDesignTokenResource Danger}" TextWrapping="Wrap" IsVisible="{Binding SaveFailure, Converter={x:Static ObjectConverters.IsNotNull}}"
                     Text="{Binding SaveFailure, Converter={x:Static cv:FailureTextConverter.Instance}}" />
          <WrapPanel Orientation="Horizontal">
            <ui:NcwButton Margin="0,0,8,0" Variant="Primary" Command="{Binding $parent[UserControl].((vm:McpViewModel)DataContext).SaveCommand}" IsEnabled="{Binding CanSave}" IsLoading="{Binding IsSaving}" Content="{l:NcwText Save}" />
            <ui:NcwButton Margin="0,0,8,0" Variant="Secondary" Command="{Binding $parent[UserControl].((vm:McpViewModel)DataContext).TestDraftCommand}" Content="{l:NcwText McpTest}" />
            <ui:NcwButton Variant="Ghost" Command="{Binding $parent[UserControl].((vm:McpViewModel)DataContext).CloseEditorCommand}" Content="{l:NcwText Cancel}" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <!-- 测试连接结果(脱敏的英文诊断只在 owner 的这个结果里) -->
      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsTesting}">
        <lucide:LucideIcon Classes="spin" Kind="LoaderCircle" Size="14" VerticalAlignment="Center" />
        <TextBlock Classes="hint" Text="{l:NcwText McpTesting}" />
      </StackPanel>
      <Border Classes="card" IsVisible="{Binding TestResult, Converter={x:Static ObjectConverters.IsNotNull}}">
        <StackPanel Spacing="6" DataContext="{Binding TestResult}" x:DataType="p:McpTestResultDto">
          <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="4">
            <lucide:LucideIcon Kind="CircleCheck" Size="15" Foreground="{arc:ArcDesignTokenResource Success}" IsVisible="{Binding Ok}" />
            <lucide:LucideIcon Kind="CircleAlert" Size="15" Foreground="{arc:ArcDesignTokenResource Danger}" IsVisible="{Binding !Ok}" />
            <TextBlock FontWeight="SemiBold" IsVisible="{Binding Ok}" Text="{l:NcwText McpTestOk}" />
            <TextBlock FontWeight="SemiBold" IsVisible="{Binding !Ok}" Text="{Binding ErrorKey, Converter={x:Static cv:FailureTextConverter.Instance}}" />
            <TextBlock Classes="hint" VerticalAlignment="Center" Text="{Binding ElapsedMs, Converter={x:Static cv:DurationTextConverter.Instance}}" />
            <TextBlock Classes="hint" VerticalAlignment="Center" IsVisible="{Binding Ok}" Text="{Binding Tools.Length, Converter={x:Static cv:TextFormatConverter.Instance}, ConverterParameter=McpToolCount}" />
          </WrapPanel>
          <TextBlock Classes="hint" IsVisible="{Binding Ok}" Text="{Binding Tools, Converter={x:Static cv:JoinConverter.Instance}}" />
          <SelectableTextBlock Classes="mono" TextWrapping="Wrap" IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNotNull}}" Text="{Binding Detail}" Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
        </StackPanel>
      </Border>

      <Border Classes="card" IsVisible="{Binding ShowsEmpty}">
        <StackPanel Spacing="6" HorizontalAlignment="Center" Margin="0,12">
          <lucide:LucideIcon Kind="Plug" Size="24" HorizontalAlignment="Center" Foreground="{arc:ArcDesignTokenResource TextMuted}" />
          <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="{l:NcwText McpEmptyTitle}" />
          <TextBlock Classes="hint" HorizontalAlignment="Center" TextAlignment="Center" Text="{l:NcwText McpEmptyHint}" />
        </StackPanel>
      </Border>

      <ItemsControl ItemsSource="{Binding Servers}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:McpServerRowViewModel">
            <Border Classes="card" Padding="14,12">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                  <ui:NcwStatusDot VerticalAlignment="Top" Margin="0,6,0,0" Tone="{Binding Connection, Converter={x:Static cv:ToneConverter.Instance}}" />
                  <StackPanel Grid.Column="1" Spacing="3">
                    <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="4">
                      <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                      <Border Classes="chip"><TextBlock Classes="hint" Text="{Binding Transport, Converter={x:Static cv:KeyTextConverter.Instance}, ConverterParameter=McpTransport}" /></Border>
                      <Border Classes="chip" IsVisible="{Binding IsProjectBound}"><TextBlock Classes="hint" Text="{l:NcwText McpProjectBound}" /></Border>
                      <TextBlock Classes="hint" VerticalAlignment="Center" Text="{Binding Connection, Converter={x:Static cv:KeyTextConverter.Instance}, ConverterParameter=McpConn}" />
                      <TextBlock Classes="hint" VerticalAlignment="Center" IsVisible="{Binding ShowsTools}"
                                 Text="{Binding ToolCount, Converter={x:Static cv:TextFormatConverter.Instance}, ConverterParameter=McpToolCount}" />
                    </WrapPanel>
                    <TextBlock Classes="mono" Foreground="{arc:ArcDesignTokenResource TextMuted}" Text="{Binding Target}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="hint" Foreground="{arc:ArcDesignTokenResource Danger}" IsVisible="{Binding ErrorKey, Converter={x:Static ObjectConverters.IsNotNull}}"
                               Text="{Binding ErrorKey, Converter={x:Static cv:FailureTextConverter.Instance}}" />
                    <TextBlock Classes="hint" IsVisible="{Binding ServerInfo, Converter={x:Static ObjectConverters.IsNotNull}}" Text="{Binding ServerInfo}" />
                  </StackPanel>
                  <ui:NcwSwitch Grid.Column="2" VerticalAlignment="Top" IsChecked="{Binding IsEnabled, Mode=OneWay}" Command="{Binding ToggleCommand}"
                                IsEnabled="{Binding $parent[ItemsControl].((vm:McpViewModel)DataContext).CanWrite}" AutomationProperties.Name="{l:NcwText McpEnabled}" arc:Tooltip.Tip="{l:NcwText McpEnabled}" />
                </Grid>
                <!-- 一个和状态有关的主操作 + 「⋯」菜单(资源与提示 / 重连 / 测试连接 / 编辑 / 删除,删除标红放最后;03 §11.6) -->
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <ui:NcwButton Variant="Secondary" Command="{Binding ReconnectCommand}" IsVisible="{Binding PrimaryIsReconnect}"
                                IsEnabled="{Binding $parent[ItemsControl].((vm:McpViewModel)DataContext).CanWrite}" Content="{l:NcwText McpReconnect}" />
                  <ui:NcwButton Variant="Secondary" Command="{Binding BrowseCommand}" IsVisible="{Binding PrimaryIsBrowse}" Content="{l:NcwText McpBrowse}" />
                  <ui:NcwDropdownMenu DataContextChanged="OnRowMenuDataContext" IsEnabled="{Binding $parent[ItemsControl].((vm:McpViewModel)DataContext).CanWrite}">
                    <ui:NcwDropdownMenu.Trigger>
                      <ui:NcwButton Classes="icon" Variant="Ghost" AutomationProperties.Name="{l:NcwText More}" arc:Tooltip.Tip="{l:NcwText More}">
                        <lucide:LucideIcon Kind="Ellipsis" Size="16" />
                      </ui:NcwButton>
                    </ui:NcwDropdownMenu.Trigger>
                  </ui:NcwDropdownMenu>
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- 资源与提示 -->
      <Border Classes="card" IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock FontWeight="SemiBold" Text="{Binding Selected.Name, Converter={x:Static cv:TextFormatConverter.Instance}, ConverterParameter=McpBrowseTitle}" />
            <ui:NcwButton Grid.Column="1" Classes="icon" Variant="Ghost" Command="{Binding CloseBrowseCommand}" AutomationProperties.Name="{l:NcwText Close}"><lucide:LucideIcon Kind="X" Size="14" /></ui:NcwButton>
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding BrowseLoading}">
            <lucide:LucideIcon Classes="spin" Kind="LoaderCircle" Size="14" VerticalAlignment="Center" />
            <TextBlock Classes="hint" Text="{l:NcwText PageLoading}" />
          </StackPanel>
          <TextBlock Classes="hint" Foreground="{arc:ArcDesignTokenResource Warning}" IsVisible="{Binding BrowseFailure, Converter={x:Static ObjectConverters.IsNotNull}}"
                     Text="{Binding BrowseFailure, Converter={x:Static cv:FailureTextConverter.Instance}}" />
          <TextBlock Classes="section" Text="{l:NcwText McpResources}" />
          <ItemsControl ItemsSource="{Binding Resources}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="p:McpResourceDto">
                <StackPanel Spacing="1" Margin="0,2">
                  <TextBlock Text="{Binding Name}" />
                  <TextBlock Classes="mono" Foreground="{arc:ArcDesignTokenResource TextMuted}" Text="{Binding Uri}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="section" Text="{l:NcwText McpPrompts}" />
          <ItemsControl ItemsSource="{Binding Prompts}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="p:McpPromptDto">
                <StackPanel Spacing="1" Margin="0,2">
                  <TextBlock Classes="mono" Text="{Binding Name}" />
                  <TextBlock Classes="hint" IsVisible="{Binding Description, Converter={x:Static ObjectConverters.IsNotNull}}" Text="{Binding Description}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </StackPanel>
</UserControl>
