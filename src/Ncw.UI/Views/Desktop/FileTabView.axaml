<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Ncw.UI.Localization"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:ui="using:Ncw.UI.Controls"
             xmlns:cv="using:Ncw.UI.Converters"
             xmlns:vm="using:Ncw.Client.ViewModels"
             xmlns:insp="using:Ncw.UI.Views.Desktop.Inspector"
             x:Class="Ncw.UI.Views.Desktop.FileTabView"
             x:DataType="vm:FilePreviewViewModel">
  <!--
    文件标签页(主工作区,盖在会话上):路径条 + 工具(Markdown 预览 / 源码、编辑 / 保存、更多)+ 内容 + 状态栏。
    文本 ≤ 2 MiB 一次读完、可编辑(保存带修订号,冲突时不丢编辑内容);更大的文本按块只读;图片显示;二进制 / 过大只提示。
    内容在设备上,这里只是纯 UI 状态,不进 Store。
  -->
  <Border Background="{arc:ArcDesignTokenResource Background}">
    <Grid RowDefinitions="Auto,Auto,*,Auto">
      <!-- 头:文件名 + 目录 + 工具 -->
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="16,8,12,4" MinHeight="36">
        <ScrollViewer VerticalAlignment="Center" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Breadcrumbs}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:FileBreadcrumbSegment">
                <StackPanel Orientation="Horizontal" Spacing="2">
                  <ui:PlainButton Padding="4,2" arc:Tooltip.Tip="{Binding Path}"
                                  Command="{Binding $parent[ItemsControl].((vm:FilePreviewViewModel)DataContext).RevealBreadcrumbCommand}"
                                  CommandParameter="{Binding}">
                    <TextBlock Text="{Binding Name}" MaxWidth="220" TextTrimming="CharacterEllipsis" />
                  </ui:PlainButton>
                  <lucide:LucideIcon Kind="ChevronRight" Size="12" VerticalAlignment="Center" IsVisible="{Binding !IsFile}" Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <Border Classes="chip" IsVisible="{Binding Line, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Classes="hint" Text="{Binding Line, Converter={x:Static cv:LineNumberTextConverter.Instance}}" />
          </Border>
          <Border Classes="chip" IsVisible="{Binding IsChunked}"><TextBlock Classes="hint" Text="{l:NcwText FileReadOnly}" /></Border>
          <TextBlock Classes="hint" VerticalAlignment="Center" IsVisible="{Binding JustSaved}" ui:NcwMotion.ShowMotion="Fade" ui:NcwMotion.ShowTier="Fast" Text="{l:NcwText FileSaved}" />
          <ui:NcwButton Classes="icon" Variant="Ghost" Command="{Binding PinCommand}" IsVisible="{Binding IsPreview}"
                        AutomationProperties.Name="{l:NcwText FilePinTab}" arc:Tooltip.Tip="{l:NcwText FilePinTab}">
            <lucide:LucideIcon Kind="Pin" Size="14" />
          </ui:NcwButton>
          <ui:NcwButton Classes="icon" Variant="Ghost" Command="{Binding ReferenceCommand}" IsEnabled="{Binding CanReference}"
                        AutomationProperties.Name="{l:NcwText FilesReferenceInChat}" arc:Tooltip.Tip="{l:NcwText FilesReferenceInChat}">
            <lucide:LucideIcon Kind="AtSign" Size="14" />
          </ui:NcwButton>
          <!-- Markdown:渲染 / 源码 -->
          <ui:NcwButton Variant="Ghost" Command="{Binding ToggleRenderedCommand}" IsVisible="{Binding IsMarkdown}" IsEnabled="{Binding !IsEditing}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <lucide:LucideIcon Kind="Eye" Size="14" IsVisible="{Binding !ShowRendered}" ui:NcwMotion.ShowMotion="Fade" ui:NcwMotion.ShowTier="Fast" />
              <lucide:LucideIcon Kind="Code" Size="14" IsVisible="{Binding ShowRendered}" ui:NcwMotion.ShowMotion="Fade" ui:NcwMotion.ShowTier="Fast" />
              <TextBlock IsVisible="{Binding !ShowRendered}" ui:NcwMotion.ShowMotion="Fade" ui:NcwMotion.ShowTier="Fast" Text="{l:NcwText FileViewRendered}" />
              <TextBlock IsVisible="{Binding ShowRendered}" ui:NcwMotion.ShowMotion="Fade" ui:NcwMotion.ShowTier="Fast" Text="{l:NcwText FileViewSource}" />
            </StackPanel>
          </ui:NcwButton>
          <ui:NcwButton Variant="Ghost" Command="{Binding EditCommand}" IsVisible="{Binding !IsEditing}" IsEnabled="{Binding CanEdit}" ui:NcwMotion.ShowMotion="Fade" ui:NcwMotion.ShowTier="Fast" Content="{l:NcwText FileEdit}" />
          <ui:NcwButton Variant="Ghost" Command="{Binding CancelEditCommand}" IsVisible="{Binding IsEditing}" ui:NcwMotion.ShowMotion="Fade" ui:NcwMotion.ShowTier="Fast" Content="{l:NcwText Cancel}" />
          <ui:NcwButton Variant="Primary" Command="{Binding SaveCommand}" IsVisible="{Binding IsEditing}" ui:NcwMotion.ShowMotion="Fade" ui:NcwMotion.ShowTier="Fast" IsEnabled="{Binding CanSave}" Content="{l:NcwText Save}" />
          <ui:NcwDropdownMenu x:Name="MoreMenu">
            <ui:NcwDropdownMenu.Trigger>
              <ui:NcwButton Classes="icon" Variant="Ghost" AutomationProperties.Name="{l:NcwText More}" arc:Tooltip.Tip="{l:NcwText More}">
                <lucide:LucideIcon Kind="Ellipsis" Size="15" />
              </ui:NcwButton>
            </ui:NcwDropdownMenu.Trigger>
          </ui:NcwDropdownMenu>
        </StackPanel>
      </Grid>

      <StackPanel Grid.Row="1" Margin="16,0,16,6" Spacing="6">
        <insp:ProblemBar Problem="{Binding Failure}" />
        <Border Classes="notice" IsVisible="{Binding HasConflict}" ui:NcwMotion.ShowMotion="Rise">
          <StackPanel Spacing="6">
            <TextBlock TextWrapping="Wrap" FontSize="{arc:ArcDesignTokenResource TypeSM}" Text="{l:NcwText FileConflict}" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ui:NcwButton Variant="Secondary" Command="{Binding ReloadCommand}" Content="{l:NcwText FileReload}" />
              <ui:NcwButton Variant="Secondary" Command="{Binding KeepMineCommand}" Content="{l:NcwText FileKeepMine}" />
            </StackPanel>
          </StackPanel>
        </Border>
        <TextBlock Classes="hint" IsVisible="{Binding IsChunked}" Text="{l:NcwText FileChunked}" />
      </StackPanel>

      <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}">
      <Panel>
        <!-- 加载中 -->
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,32,0,0" IsVisible="{Binding IsLoading}" ui:NcwMotion.ShowMotion="Fade">
          <lucide:LucideIcon Classes="spin" Kind="LoaderCircle" Size="14" Foreground="{arc:ArcDesignTokenResource TextMuted}" />
          <TextBlock Classes="hint" Text="{l:NcwText FileLoading}" />
        </StackPanel>
        <!-- 文本:源码用无外框的代码块(铺满,横向滚动条吸附在可视底边);Markdown 渲染和编辑多一层 1100 宽的版心 -->
        <ScrollViewer IsVisible="{Binding IsText}" ui:NcwMotion.ShowMotion="Fade" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,0,0,16" Spacing="8">
            <ui:NcwCodeBlock Code="{Binding DisplayText}" Language="{Binding Language}" ShowLineNumbers="True" CopyLabel="{l:NcwText CodeCopy}"
                             IsChromeless="True" StickyScrollBar="True" IsVisible="{Binding ShowsSource}" ui:NcwMotion.ShowMotion="Fade" />
            <StackPanel Margin="16,0" Spacing="8" MaxWidth="1100" HorizontalAlignment="Stretch" IsVisible="{Binding !ShowsSource}" ui:NcwMotion.ShowMotion="Fade">
              <ui:NcwMarkdown Text="{Binding DisplayText}" IsVisible="{Binding ShowsRendered}" />
              <ui:NcwTextArea x:Name="EditBox" Text="{Binding EditText, Mode=TwoWay}" FrameMinHeight="360" IsResizable="False"
                              FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}" FontSize="{arc:ArcDesignTokenResource TypeSM}"
                              IsVisible="{Binding IsEditing}" ui:NcwMotion.ShowMotion="Fade" />
            </StackPanel>
            <ui:NcwButton HorizontalAlignment="Center" Variant="Secondary" Command="{Binding LoadMoreCommand}" IsVisible="{Binding CanLoadMore}" Content="{l:NcwText FileShowMore}" />
          </StackPanel>
        </ScrollViewer>
        <!-- 图片 -->
        <ScrollViewer IsVisible="{Binding IsImage}" ui:NcwMotion.ShowMotion="Fade" HorizontalScrollBarVisibility="Auto">
          <Image Margin="16,0,16,16" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Top"
                 Source="{Binding ImageData, Converter={x:Static cv:BytesToBitmapConverter.Instance}}" />
        </ScrollViewer>
        <!-- 二进制 / 过大 -->
        <StackPanel IsVisible="{Binding IsBinary}" ui:NcwMotion.ShowMotion="Fade" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="24,48,24,24" Spacing="8" MaxWidth="360">
          <lucide:LucideIcon Kind="FileX" Size="28" HorizontalAlignment="Center" Foreground="{arc:ArcDesignTokenResource TextMuted}" />
          <TextBlock Classes="hint" TextAlignment="Center" TextWrapping="Wrap" Text="{Binding Reason, Converter={x:Static cv:BinaryReasonTextConverter.Instance}}" />
          <TextBlock Classes="hint" TextAlignment="Center" Text="{Binding Size, Converter={x:Static cv:FileSizeConverter.Instance}}" />
        </StackPanel>
      </Panel>
      </Border>

      <!-- 状态栏:语言 · 行数 · 大小 -->
      <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}" Padding="16,4" IsVisible="{Binding !IsLoading}">
        <StackPanel Orientation="Horizontal" Spacing="14">
          <TextBlock Classes="hint" Text="{Binding Language}" IsVisible="{Binding Language, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <TextBlock Classes="hint" Text="{Binding TotalLines, Converter={x:Static cv:LineCountTextConverter.Instance}}" IsVisible="{Binding IsText}" />
          <TextBlock Classes="hint" Text="{Binding Size, Converter={x:Static cv:FileSizeConverter.Instance}}" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</UserControl>
