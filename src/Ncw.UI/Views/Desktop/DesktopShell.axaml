<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Ncw.UI.Localization"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:ui="using:Ncw.UI.Controls"
             xmlns:chrome="using:Ncw.UI.Chrome"
             xmlns:desktop="using:Ncw.UI.Views.Desktop"
             xmlns:themes="using:Ncw.UI.Themes"
             xmlns:vm="using:Ncw.Client.ViewModels"
             x:Class="Ncw.UI.Views.Desktop.DesktopShell"
             x:DataType="vm:ShellViewModel">
  <!--
    桌面外壳(docs/design/03 §1、§2)。窗口没有系统标题栏,内容铺到顶端;顶部 40px 这一行由各栏头部拼成:
      左侧区域头部(红绿灯留白 + 名称 + 收起按钮)| 工作区标签栏 | 检查器页签,再加右上角常驻的检查器开关和窗口按钮。
    这一行里没有被控件处理的按下用来拖动窗口(MainWindow)。断点和左右栏显隐由 code-behind 计算(纯 UI 状态)。
  -->
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <themes:NcwTheme />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <UserControl.Styles>
    <themes:NcwStyles />
  </UserControl.Styles>
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Meta+B" Command="{Binding ToggleSidebarCommand}" />
    <KeyBinding Gesture="Ctrl+B" Command="{Binding ToggleSidebarCommand}" />
    <KeyBinding Gesture="Meta+Alt+I" Command="{Binding ToggleInspectorCommand}" />
    <KeyBinding Gesture="Ctrl+Alt+I" Command="{Binding ToggleInspectorCommand}" />
  </UserControl.KeyBindings>

  <Grid x:Name="Root" Background="{arc:ArcDesignTokenResource SurfaceMuted}">
    <Grid x:Name="Main" ColumnDefinitions="352,4,*,4,320">
      <!-- 窄窗口下抽屉打开时的遮罩:点一下关闭抽屉 -->
      <Border x:Name="DrawerScrim" Grid.Column="0" Grid.ColumnSpan="5" ZIndex="9" IsVisible="False"
              Background="{arc:ArcDesignTokenResource Scrim}" PointerPressed="OnScrimPressed" />

      <!-- 左侧区域:头部 + 项目栏 + 项目面板。窄窗口下作为抽屉跨列覆盖在工作区上。 -->
      <Grid x:Name="LeftArea" Grid.Column="0" RowDefinitions="40,*" Background="{arc:ArcDesignTokenResource SurfaceMuted}">
        <Grid x:Name="SidebarLead" ColumnDefinitions="Auto,*,Auto" Margin="0,0,8,0">
          <Border x:Name="SidebarInset" Width="0" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="14,0,0,0" VerticalAlignment="Center">
            <Border Width="20" Height="20" CornerRadius="6" Background="{arc:ArcDesignTokenResource Foreground}">
              <lucide:LucideIcon Kind="Sparkles" Size="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Foreground="{arc:ArcDesignTokenResource Background}" />
            </Border>
            <TextBlock Text="NextCoWork" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <ui:NcwButton Grid.Column="2" Classes="icon" Variant="Ghost"
                        Command="{Binding ToggleSidebarCommand}"
                        AutomationProperties.Name="{l:NcwText CollapseSidebar}"
                        arc:Tooltip.Tip="{l:NcwText CollapseSidebarHint}">
            <lucide:LucideIcon Kind="PanelLeftClose" Size="16" />
          </ui:NcwButton>
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="64,*">
          <Border BorderThickness="0,0,1,0" BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}">
            <desktop:ProjectRail DataContext="{Binding Rail}" />
          </Border>
          <desktop:ProjectPanel Grid.Column="1" DataContext="{Binding Panel}" />
        </Grid>
      </Grid>

      <!-- 拖动调整左侧区域宽度 -->
      <GridSplitter x:Name="LeftSplitter" Grid.Column="1" Background="Transparent"
                    ResizeDirection="Columns" DragCompleted="OnSplitterDragCompleted" />

      <!-- 主工作区:标签栏就是顶部这一行 -->
      <Border Grid.Column="2"
              Background="{arc:ArcDesignTokenResource Background}"
              BorderThickness="1,0,1,0"
              BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}">
        <Panel>
          <desktop:WorkspaceArea x:Name="Workspace" />
          <!-- 左侧区域收起时:红绿灯留白、名称和展开按钮并入标签栏的最左边 -->
          <StackPanel x:Name="CollapsedLead" Orientation="Horizontal" Height="40"
                      HorizontalAlignment="Left" VerticalAlignment="Top" IsVisible="False">
            <Border x:Name="CollapsedInset" Width="0" />
            <TextBlock Text="NextCoWork" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,6,0" />
            <ui:NcwButton Classes="icon" Variant="Ghost" Margin="0,0,6,0"
                          Command="{Binding ToggleSidebarCommand}"
                          AutomationProperties.Name="{l:NcwText ExpandSidebar}"
                          arc:Tooltip.Tip="{l:NcwText ExpandSidebarHint}">
              <lucide:LucideIcon Kind="PanelLeftOpen" Size="16" />
            </ui:NcwButton>
          </StackPanel>
        </Panel>
      </Border>

      <!-- 右侧面板(默认文件管理器):自己的页签行也在顶部这一行 -->
      <!-- 拖动调整右侧面板宽度 -->
      <GridSplitter x:Name="RightSplitter" Grid.Column="3" Background="Transparent"
                    ResizeDirection="Columns" DragCompleted="OnSplitterDragCompleted" />

      <Border x:Name="InspectorColumn" Grid.Column="4">
        <desktop:InspectorPanel x:Name="Inspector" DataContext="{Binding Inspector}" />
      </Border>
    </Grid>

    <!-- 设置页:整窗覆盖(数据页优先,所以排在它前面) -->
    <desktop:SettingsOverlay DataContext="{Binding Settings}" />

    <!-- 启动时的数据页:本机数据没就绪(接管 2.x 数据中 / 被挡住)时盖住整个窗口 -->
    <desktop:DataGateOverlay DataContext="{Binding DataGate}" />

    <!-- 右上角常驻:检查器开关 + (Windows / Linux)窗口按钮 -->
    <StackPanel x:Name="TopRight" Orientation="Horizontal" Height="40" Spacing="2" Margin="0,0,8,0"
                HorizontalAlignment="Right" VerticalAlignment="Top">
      <ui:NcwButton Classes="icon" Variant="Ghost"
                    Command="{Binding ToggleInspectorCommand}"
                    AutomationProperties.Name="{l:NcwText RightPanel}"
                    arc:Tooltip.Tip="{l:NcwText RightPanelHint}">
        <ui:NcwButton.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="!DataGate.IsVisible" />
            <Binding Path="!Settings.IsOpen" />
          </MultiBinding>
        </ui:NcwButton.IsVisible>
        <lucide:LucideIcon Kind="PanelRight" Size="16" />
      </ui:NcwButton>
      <chrome:CaptionButtons x:Name="Captions" Margin="6,0,0,0" IsVisible="False" />
    </StackPanel>
  </Grid>
</UserControl>
