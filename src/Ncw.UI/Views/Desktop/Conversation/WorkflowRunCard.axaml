<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Ncw.UI.Localization"
             xmlns:cv="using:Ncw.UI.Converters"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:ui="using:Ncw.UI.Controls"
             xmlns:vm="using:Ncw.Client.ViewModels"
             x:Class="Ncw.UI.Views.Desktop.Conversation.WorkflowRunCard"
             x:DataType="vm:WorkflowRunCardViewModel">
  <!-- 对话流内联工作流卡片:单处展示 TKCode.Arc.Workflow 交互式画布(缩放、横竖切换、节点详情、停止/续跑/重试) -->
  <Border Classes="card" Margin="0,4" Padding="12,10">
    <StackPanel Spacing="8">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <ui:PlainButton Padding="2,2" Command="{Binding ToggleExpandedCommand}" AutomationProperties.Name="{l:NcwText Workflows}">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <lucide:LucideIcon Kind="Workflow" Size="15" VerticalAlignment="Center" Foreground="{arc:ArcDesignTokenResource Accent}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <Border Classes="chip" IsVisible="{Binding ProgressText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Classes="hint" Text="{Binding ProgressText}" />
              </Border>
              <Border Classes="chip" IsVisible="{Binding EnvironmentBadge, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Classes="hint" Text="{Binding EnvironmentBadge}" />
              </Border>
            </StackPanel>
            <lucide:LucideIcon Grid.Column="2" Classes="chevronDown" Classes.open="{Binding IsExpanded}" Kind="ChevronDown" Size="12" VerticalAlignment="Center"
                               Foreground="{arc:ArcDesignTokenResource TextMuted}" />
          </Grid>
        </ui:PlainButton>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <Border Classes="chip">
            <TextBlock Classes="hint" Text="{Binding DerivedStatus, Converter={x:Static cv:WorkflowStatusConverter.Instance}}" />
          </Border>
          <ui:NcwButton Classes="icon" Variant="Ghost" Command="{Binding ToggleLayoutDirectionCommand}"
                        AutomationProperties.Name="{l:NcwText WorkflowToggleDirection}" arc:Tooltip.Tip="{l:NcwText WorkflowToggleDirection}">
            <lucide:LucideIcon Kind="ArrowLeftRight" Size="12" />
          </ui:NcwButton>
          <ui:NcwButton Classes="icon" Variant="Ghost" Command="{Binding StopCommand}" IsVisible="{Binding CanStop}"
                        AutomationProperties.Name="{l:NcwText WorkflowStop}" arc:Tooltip.Tip="{l:NcwText WorkflowStop}">
            <lucide:LucideIcon Kind="Square" Size="12" />
          </ui:NcwButton>
          <ui:NcwButton Classes="icon" Variant="Ghost" Command="{Binding ResumeCommand}" IsVisible="{Binding CanResume}"
                        AutomationProperties.Name="{l:NcwText WorkflowResume}" arc:Tooltip.Tip="{l:NcwText WorkflowResume}">
            <lucide:LucideIcon Kind="Play" Size="12" />
          </ui:NcwButton>
        </StackPanel>
      </Grid>

      <ui:NcwCollapsible IsOpen="{Binding IsExpanded}">
        <Border Height="270" CornerRadius="8" ClipToBounds="True"
                BorderThickness="1" BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}">
          <ui:NcwWorkflowCanvas x:Name="WorkflowCanvas"
                                Definition="{Binding Definition}"
                                Run="{Binding Run}"
                                LayoutDirection="{Binding LayoutDirection}"
                                IsEditable="False"
                                IsPanZoomEnabled="True"
                                ShowChrome="True" />
        </Border>
      </ui:NcwCollapsible>
    </StackPanel>
  </Border>
</UserControl>
