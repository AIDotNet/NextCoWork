<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Ncw.UI.Localization"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:ui="using:Ncw.UI.Controls"
             xmlns:cv="using:Ncw.UI.Converters"
             xmlns:vm="using:Ncw.Client.ViewModels"
             x:Class="Ncw.UI.Views.Desktop.Conversation.ToolCard"
             x:DataType="vm:ToolRowViewModel">
  <!--
    一次工具调用的卡片:工具名 + 目标(命令 / 路径)+ 执行环境标识(设备 · 环境,AGENTS.md §5)+ 状态。
    展开后是摘要:Edit / Write 的 diff 行,命令的输出前几行。完整内容不在转录里画(太长),按需在以后的详情页看。
  -->
  <Border Classes="card" Padding="0" Margin="0,3"
          Classes.attention="{Binding IsWaiting}" Classes.danger="{Binding IsFailed}">
    <StackPanel>
      <ui:PlainButton Padding="12,8" CornerRadius="12" Click="OnToggle" IsEnabled="{Binding CanExpand}">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8">
          <Panel Width="16" Height="16" VerticalAlignment="Center">
            <lucide:LucideIcon Kind="Terminal" Size="15" IsVisible="{Binding IsCommand}" Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
            <lucide:LucideIcon Kind="FilePen" Size="15" IsVisible="{Binding IsEdit}" Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
            <lucide:LucideIcon Kind="FileText" Size="15" IsVisible="{Binding IsRead}" Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
            <lucide:LucideIcon Kind="Search" Size="15" IsVisible="{Binding IsSearch}" Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
            <lucide:LucideIcon Kind="Wrench" Size="15" IsVisible="{Binding IsOther}" Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
          </Panel>
          <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Classes="mono" Text="{Binding Target}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                     Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasStats}">
              <TextBlock Classes="mono" Text="{Binding AddedText}" IsVisible="{Binding HasAdded}" Foreground="{arc:ArcDesignTokenResource Success}" />
              <TextBlock Classes="mono" Text="{Binding RemovedText}" IsVisible="{Binding HasRemoved}" Foreground="{arc:ArcDesignTokenResource Danger}" />
            </StackPanel>
            <!-- 状态 -->
            <Panel Width="16" Height="16">
              <lucide:LucideIcon Classes="spin" Kind="LoaderCircle" Size="14" IsVisible="{Binding IsRunning}" Foreground="{arc:ArcDesignTokenResource Accent}" />
              <lucide:LucideIcon Kind="Check" Size="14" IsVisible="{Binding IsDone}" Foreground="{arc:ArcDesignTokenResource Success}" />
              <lucide:LucideIcon Kind="CircleX" Size="14" IsVisible="{Binding IsFailed}" Foreground="{arc:ArcDesignTokenResource Danger}" />
              <lucide:LucideIcon Kind="ShieldAlert" Size="14" IsVisible="{Binding IsWaiting}" Foreground="{arc:ArcDesignTokenResource Warning}" />
              <lucide:LucideIcon Kind="CircleSlash" Size="14" IsVisible="{Binding IsInterrupted}" Foreground="{arc:ArcDesignTokenResource TextMuted}" />
            </Panel>
            <lucide:LucideIcon Kind="ChevronRight" Size="12" VerticalAlignment="Center" IsVisible="{Binding !IsExpanded}"
                               Foreground="{arc:ArcDesignTokenResource TextMuted}" Opacity="{Binding CanExpand, Converter={x:Static cv:BoolOpacityConverter.Instance}}" />
            <lucide:LucideIcon Kind="ChevronDown" Size="12" VerticalAlignment="Center" IsVisible="{Binding IsExpanded}"
                               Foreground="{arc:ArcDesignTokenResource TextMuted}" />
          </StackPanel>
          <!-- 第二行:执行环境标识 + 状态说明 -->
          <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
            <Border Classes="chip" IsVisible="{Binding EnvLabel, Converter={x:Static ObjectConverters.IsNotNull}}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <lucide:LucideIcon Kind="Monitor" Size="11" VerticalAlignment="Center" IsVisible="{Binding !IsSsh}" Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                <lucide:LucideIcon Kind="Link" Size="11" VerticalAlignment="Center" IsVisible="{Binding IsSsh}" Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                <TextBlock Classes="hint" Text="{Binding EnvLabel}" TextWrapping="NoWrap" />
              </StackPanel>
            </Border>
            <TextBlock Classes="hint" VerticalAlignment="Center" IsVisible="{Binding IsWaiting}" Foreground="{arc:ArcDesignTokenResource Warning}" Text="{l:NcwText ToolWaitingApproval}" />
            <TextBlock Classes="hint" VerticalAlignment="Center" IsVisible="{Binding IsInterrupted}" Text="{l:NcwText ToolInterrupted}" />
            <TextBlock Classes="hint" VerticalAlignment="Center" IsVisible="{Binding IsQueued}"
                       Text="{Binding QueuedAhead, Converter={x:Static cv:TextFormatConverter.Instance}, ConverterParameter=ToolQueuedAhead}" />
          </StackPanel>
        </Grid>
      </ui:PlainButton>
      <!-- 摘要 -->
      <Border IsVisible="{Binding IsExpanded}" Padding="12,0,12,10" BorderThickness="0,1,0,0" BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}">
        <StackPanel Margin="0,8,0,0" Spacing="1">
          <ItemsControl ItemsSource="{Binding PreviewLines}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DiffLine">
                <Grid ColumnDefinitions="14,*">
                  <TextBlock Classes="mono" HorizontalAlignment="Center" Text="+" IsVisible="{Binding IsAdded}" Foreground="{arc:ArcDesignTokenResource Success}" />
                  <TextBlock Classes="mono" HorizontalAlignment="Center" Text="−" IsVisible="{Binding IsRemoved}" Foreground="{arc:ArcDesignTokenResource Danger}" />
                  <TextBlock Grid.Column="1" Classes="mono" Text="{Binding Text}" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="hint" IsVisible="{Binding HasMore}"
                     Text="{Binding MoreLines, Converter={x:Static cv:TextFormatConverter.Instance}, ConverterParameter=ToolMoreLines}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </Border>
</UserControl>
