<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Ncw.UI.Localization"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:ui="using:Ncw.UI.Controls"
             xmlns:cv="using:Ncw.UI.Converters"
             xmlns:vm="using:Ncw.Client.ViewModels"
             x:Class="Ncw.UI.Views.Desktop.Conversation.ToolCard"
             x:DataType="vm:ToolRowViewModel">
  <!--
    一次工具调用:不是卡片,是一行文字(和思考块同一档):图标 + 工具名 + 目标(命令 / 路径)+ 执行环境标识(设备 · 环境,AGENTS.md §5)+ 状态。
    结果默认不展示(失败的也是):有摘要(Edit / Write 的 diff 行、命令输出前几行)的才有展开箭头,点开才看;失败用红色标出,并在行下面一行写出输出的第一行(03 §11.5)。
    项目里的路径显示成项目相对的(完整路径在提示里)。
    完整内容不在转录里画(太长),按需在以后的详情页看。
  -->
  <StackPanel Margin="0,1">
    <Grid x:Name="ToolHeader" ColumnDefinitions="*,Auto" ColumnSpacing="2" IsVisible="{Binding !IsMedia}">
      <ui:PlainButton HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="6,3" CornerRadius="8" Click="OnToggle" IsEnabled="{Binding CanExpand}"
                      arc:Tooltip.Tip="{Binding Tip}">
      <!-- 严格单行:图标 | 工具名(至少 44、至多 160:常见的短名各行对齐,长名如 visualize_read_me / MCP 工具不被截成「visuali…」)|
           目标(只吃剩余宽度,放不下从末尾截断)| 改动量 · 状态 · 设备·环境 · 箭头(靠右)。
           目标必须是 * 列里的一个 TextBlock:放成 Auto 列时按内容宽度量,长命令会画到右侧的状态 / 环境标识上面(两段文字叠在一起)。
           TextBlock.hint 默认会换行,这里每个文字都显式 NoWrap -->
      <Grid ColumnDefinitions="14,Auto,*,Auto" ColumnSpacing="8">
        <Panel Width="14" Height="14" VerticalAlignment="Center">
          <lucide:LucideIcon Kind="Terminal" Size="13" IsVisible="{Binding IsCommand}" Foreground="{arc:ArcDesignTokenResource TextMuted}" />
          <lucide:LucideIcon Kind="FilePen" Size="13" IsVisible="{Binding IsEdit}" Foreground="{arc:ArcDesignTokenResource TextMuted}" />
          <lucide:LucideIcon Kind="FileText" Size="13" IsVisible="{Binding IsRead}" Foreground="{arc:ArcDesignTokenResource TextMuted}" />
          <lucide:LucideIcon Kind="Search" Size="13" IsVisible="{Binding IsSearch}" Foreground="{arc:ArcDesignTokenResource TextMuted}" />
          <lucide:LucideIcon Kind="Wrench" Size="13" IsVisible="{Binding IsOther}" Foreground="{arc:ArcDesignTokenResource TextMuted}" />
        </Panel>
        <TextBlock Grid.Column="1" Classes="hint toolName" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"
                   MinWidth="44" MaxWidth="160" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Classes.failed="{Binding IsFailed}" />
        <!-- 目标:路径 = 文件名 + 淡色目录;命令 / 其他 = 第一行。同一个 TextBlock 的两个 Run,整体截断 -->
        <TextBlock Grid.Column="2" Classes="hint mono toolTarget" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                   Classes.failed="{Binding IsFailed}">
          <Run Text="{Binding TargetName}" /><Run Text="{Binding TargetDirSuffix}" Foreground="{arc:ArcDesignTokenResource TextMuted}" />
        </TextBlock>
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <!-- 改动量 -->
          <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasStats}">
            <TextBlock Classes="hint mono" Text="{Binding AddedText}" TextWrapping="NoWrap" IsVisible="{Binding HasAdded}" Foreground="{arc:ArcDesignTokenResource Success}" />
            <TextBlock Classes="hint mono" Text="{Binding RemovedText}" TextWrapping="NoWrap" IsVisible="{Binding HasRemoved}" Foreground="{arc:ArcDesignTokenResource Danger}" />
          </StackPanel>
          <!-- 状态:只有「不是平常」的才出声;成功不画对勾(一行行对勾是噪音) -->
          <TextBlock Classes="hint" TextWrapping="NoWrap" IsVisible="{Binding IsWaiting}" Foreground="{arc:ArcDesignTokenResource Warning}" Text="{l:NcwText ToolWaitingApproval}" />
          <TextBlock Classes="hint" TextWrapping="NoWrap" IsVisible="{Binding IsInterrupted}" Text="{l:NcwText ToolInterrupted}" />
          <TextBlock Classes="hint" TextWrapping="NoWrap" IsVisible="{Binding IsQueued}"
                     Text="{Binding QueuedAhead, Converter={x:Static cv:TextFormatConverter.Instance}, ConverterParameter=ToolQueuedAhead}" />
          <lucide:LucideIcon Classes="spin" Kind="LoaderCircle" Size="12" IsVisible="{Binding IsRunning}" Foreground="{arc:ArcDesignTokenResource Accent}" />
          <lucide:LucideIcon Kind="CircleX" Size="12" IsVisible="{Binding IsFailed}" Foreground="{arc:ArcDesignTokenResource Danger}" />
          <lucide:LucideIcon Kind="ShieldAlert" Size="12" IsVisible="{Binding IsWaiting}" Foreground="{arc:ArcDesignTokenResource Warning}" />
          <!-- 执行环境标识:设备 · 环境(AGENTS.md §5)。默认的本机环境不画,SSH / 其他环境必画(很淡、不换行、固定在右侧);本机的在整行提示里 -->
          <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding ShowsEnv}" Opacity="0.75">
            <lucide:LucideIcon Kind="Monitor" Size="11" IsVisible="{Binding !IsSsh}" Foreground="{arc:ArcDesignTokenResource TextMuted}" />
            <lucide:LucideIcon Kind="Link" Size="11" IsVisible="{Binding IsSsh}" Foreground="{arc:ArcDesignTokenResource TextMuted}" />
            <TextBlock Classes="hint" Text="{Binding EnvLabel}" TextWrapping="NoWrap" />
          </StackPanel>
          <!-- 箭头占位:没有摘要的行也占着宽度,各行的环境标识才对得齐 -->
          <Panel Width="12">
            <lucide:LucideIcon Classes="chevron" Classes.open="{Binding IsExpanded}" Kind="ChevronRight" Size="11"
                               IsVisible="{Binding CanExpand}" Foreground="{arc:ArcDesignTokenResource TextMuted}" />
          </Panel>
        </StackPanel>
      </Grid>
      </ui:PlainButton>
      <ui:PlainButton Grid.Column="1" Width="24" Height="24" CornerRadius="6" VerticalAlignment="Center"
                      IsVisible="{Binding CanOpenFile}" Command="{Binding OpenFileCommand}"
                      AutomationProperties.Name="{l:NcwText ToolOpenFile}" arc:Tooltip.Tip="{l:NcwText ToolOpenFile}">
        <lucide:LucideIcon Kind="ExternalLink" Size="12" HorizontalAlignment="Center" Foreground="{arc:ArcDesignTokenResource TextMuted}" />
      </ui:PlainButton>
    </Grid>
    <!-- 失败的调用:输出的第一行(为什么失败),一行红字,不用点开才知道 -->
    <TextBlock Classes="hint mono failed" Margin="28,0,0,2" IsVisible="{Binding HasGenericFailureLine}" Text="{Binding FailureLine}"
               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
    <ContentControl Content="{Binding ImagePreview}" IsVisible="{Binding !!ImagePreview}" Margin="0,4,0,6"
                    HorizontalContentAlignment="Stretch">
      <ContentControl.ContentTemplate>
        <DataTemplate x:DataType="vm:ToolRowViewModel">
          <Grid HorizontalAlignment="Left">
            <ui:NcwImageReveal x:Name="GeneratedImage" Tool="{Binding}" HorizontalAlignment="Left" />
            <ui:PlainButton x:Name="MediaImageHit" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            IsVisible="{Binding !!#GeneratedImage.Source}" Click="OnViewImage"
                            AutomationProperties.Name="{l:NcwText MsgImageOpen}" arc:Tooltip.Tip="{l:NcwText MsgImageOpen}" />
            <TextBlock Classes="hint" Text="{l:NcwText MediaImageGenerating}" IsVisible="{Binding IsGeneratingImage}"
                       AutomationProperties.AccessibilityView="Raw" Margin="12,0,0,9" VerticalAlignment="Bottom"
                       Foreground="{arc:ArcDesignTokenResource TextMuted}" />
          </Grid>
        </DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>
    <StackPanel Margin="0,4,0,4" Spacing="4" IsVisible="{Binding ShowsNonImageMediaStatus}">
      <TextBlock Classes="hint" IsVisible="{Binding IsWaiting}" Text="{l:NcwText ToolWaitingApproval}" />
      <TextBlock Classes="hint" IsVisible="{Binding IsQueued}" Text="{l:NcwText MediaImageQueued}" />
      <TextBlock Classes="hint" IsVisible="{Binding IsGeneratingVideo}" Text="{l:NcwText MediaVideoGenerating}" />
      <TextBlock Classes="hint" IsVisible="{Binding IsGeneratingAudio}" Text="{l:NcwText MediaAudioGenerating}" />
      <TextBlock Classes="hint failed" IsVisible="{Binding IsVideoGenerationFailed}" Text="{l:NcwText MediaVideoGenerationFailed}" />
      <TextBlock Classes="hint failed" IsVisible="{Binding IsAudioGenerationFailed}" Text="{l:NcwText MediaAudioGenerationFailed}" />
      <TextBlock Classes="hint" IsVisible="{Binding IsInterrupted}" Text="{l:NcwText ToolInterrupted}" />
      <TextBlock Classes="hint" IsVisible="{Binding IsMediaUnknown}" Text="{l:NcwText DeviceConnecting}" />
      <TextBlock Classes="hint failed" IsVisible="{Binding HasFailureLine}" Text="{Binding FailureLine}" />
    </StackPanel>
    <ContentControl Content="{Binding VideoPreview}" IsVisible="{Binding !!VideoPreview}" Margin="0,4,0,4" HorizontalContentAlignment="Stretch">
      <ContentControl.ContentTemplate>
        <DataTemplate x:DataType="vm:ToolRowViewModel"><ui:NcwVideoPreview Row="{Binding}" /></DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>
    <StackPanel Margin="0,2,0,4" IsVisible="{Binding ShowsMediaActions}">
      <WrapPanel Orientation="Horizontal" ItemSpacing="4">
        <ui:PlainButton x:Name="MediaViewButton" Click="OnViewImage" IsVisible="{Binding CanViewMediaImage}" Padding="6,4" CornerRadius="6">
          <TextBlock Classes="hint" Text="{l:NcwText MsgImageOpen}" />
        </ui:PlainButton>
        <ui:PlainButton x:Name="MediaCopyButton" Click="OnCopyImage" IsVisible="{Binding CanViewMediaImage}" Padding="6,4" CornerRadius="6">
          <TextBlock Classes="hint" Text="{l:NcwText MediaImageCopy}" />
        </ui:PlainButton>
        <ui:PlainButton x:Name="MediaSaveButton" Click="OnSaveMedia" IsVisible="{Binding CanSaveMedia}" Padding="6,4" CornerRadius="6">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <lucide:LucideIcon Kind="Download" Size="13" />
            <TextBlock Classes="hint" Text="{l:NcwText FilesSaveAs}" />
          </StackPanel>
        </ui:PlainButton>
      </WrapPanel>
      <TextBlock x:Name="MediaFeedback" IsVisible="False" Classes="hint" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
      <TextBlock Classes="hint" IsVisible="{Binding ShowsEnv}" Text="{Binding EnvLabel}" />
    </StackPanel>
    <!-- 结果摘要:统一的展开 / 收起容器(高度弹簧 + 淡入淡出,docs/design/03 §9),缩进一档、左侧一条线,不是卡片 -->
    <ui:NcwCollapsible IsVisible="{Binding !IsMedia}" IsOpen="{Binding IsExpanded}">
      <Border Margin="12,0,0,2" Padding="12,2,0,2" BorderThickness="2,0,0,0"
              BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}">
        <StackPanel Spacing="1">
          <ItemsControl ItemsSource="{Binding PreviewLines}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DiffLine">
                <Grid ColumnDefinitions="14,*">
                  <TextBlock Classes="mono" HorizontalAlignment="Center" Text="+" IsVisible="{Binding IsAdded}" Foreground="{arc:ArcDesignTokenResource Success}" />
                  <TextBlock Classes="mono" HorizontalAlignment="Center" Text="−" IsVisible="{Binding IsRemoved}" Foreground="{arc:ArcDesignTokenResource Danger}" />
                  <TextBlock Grid.Column="1" Classes="mono" Text="{Binding Text}" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="hint" IsVisible="{Binding HasMore}"
                     Text="{Binding MoreLines, Converter={x:Static cv:TextFormatConverter.Instance}, ConverterParameter=ToolMoreLines}" />
        </StackPanel>
      </Border>
    </ui:NcwCollapsible>
  </StackPanel>
</UserControl>
