<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Ncw.UI.Localization"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:ui="using:Ncw.UI.Controls"
             xmlns:cv="using:Ncw.UI.Converters"
             xmlns:vm="using:Ncw.Client.ViewModels"
             x:Class="Ncw.UI.Views.Desktop.Conversation.WidgetCard"
             x:DataType="vm:WidgetRowViewModel">
  <!--
    内联可视化卡片(M8):标题 + 执行环境标识(设备 · 环境,AGENTS.md §5)+ 状态标记(状态未知 / 离线 / 已过期)+ 重新加载 / 复制源码,
    下面是 NcwWidgetHost(桌面是 WebView,手机 / 不可用时是静态快照)。消毒拿掉过东西时底部提示一句。
  -->
  <Border Classes="card" Padding="0" Margin="0,3" Classes.danger="{Binding IsFailed}">
    <StackPanel>
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="12,8,8,0" ColumnSpacing="8">
        <lucide:LucideIcon Kind="ChartColumn" Size="15" VerticalAlignment="Center" Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Classes="mono" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                     Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
          <Border Classes="chip" IsVisible="{Binding EnvLabel, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <lucide:LucideIcon Kind="Monitor" Size="11" VerticalAlignment="Center" IsVisible="{Binding !IsSsh}" Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
              <lucide:LucideIcon Kind="Link" Size="11" VerticalAlignment="Center" IsVisible="{Binding IsSsh}" Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
              <TextBlock Classes="hint" Text="{Binding EnvLabel}" TextWrapping="NoWrap" />
            </StackPanel>
          </Border>
          <TextBlock Classes="hint" VerticalAlignment="Center" IsVisible="{Binding ShowUnknownBadge}" Foreground="{arc:ArcDesignTokenResource Warning}" Text="{l:NcwText WidgetBadgeUnknown}" />
          <TextBlock Classes="hint" VerticalAlignment="Center" IsVisible="{Binding ShowOfflineBadge}" Foreground="{arc:ArcDesignTokenResource Warning}" Text="{l:NcwText WidgetBadgeOffline}" />
          <TextBlock Classes="hint" VerticalAlignment="Center" IsVisible="{Binding ShowExpiredBadge}" Text="{l:NcwText WidgetBadgeExpired}" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" IsVisible="{Binding HasCard}">
          <ui:NcwButton Classes="icon" Variant="Ghost" Click="OnCopySource"
                        AutomationProperties.Name="{l:NcwText WidgetCopySource}" arc:Tooltip.Tip="{l:NcwText WidgetCopySource}">
            <lucide:LucideIcon Kind="Copy" Size="13" />
          </ui:NcwButton>
          <ui:NcwButton Classes="icon" Variant="Ghost" Click="OnReload"
                        AutomationProperties.Name="{l:NcwText WidgetReload}" arc:Tooltip.Tip="{l:NcwText WidgetReload}">
            <lucide:LucideIcon Kind="RotateCw" Size="13" />
          </ui:NcwButton>
        </StackPanel>
      </Grid>
      <ui:NcwWidgetHost x:Name="Host" Margin="0,4,0,0" />
      <TextBlock Classes="hint" Margin="12,0,12,8" TextWrapping="Wrap" IsVisible="{Binding HasFindings}"
                 Text="{Binding FindingCount, Converter={x:Static cv:TextFormatConverter.Instance}, ConverterParameter=WidgetSanitized}" />
    </StackPanel>
  </Border>
</UserControl>
