<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Ncw.UI.Localization"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:ui="using:Ncw.UI.Controls"
             xmlns:cv="using:Ncw.UI.Converters"
             xmlns:vm="using:Ncw.Client.ViewModels"
             xmlns:insp="using:Ncw.UI.Views.Desktop.Inspector"
             x:Class="Ncw.UI.Views.Desktop.Inspector.FilesPane"
             x:DataType="vm:FilesPanelViewModel">
  <!-- 可折叠项目资源管理器:筛选默认收起,目录链紧凑显示;单击临时预览、双击固定标签。 -->
  <Grid RowDefinitions="Auto,*">
    <Grid ColumnDefinitions="*,Auto" Margin="6,0,4,0" MinHeight="32">
      <ui:PlainButton Command="{Binding ToggleExpandedCommand}" Padding="4,4">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <lucide:LucideIcon Kind="ChevronRight" Size="13" IsVisible="{Binding !IsExpanded}" />
          <lucide:LucideIcon Kind="ChevronDown" Size="13" IsVisible="{Binding IsExpanded}" />
          <TextBlock FontWeight="SemiBold" Text="{l:NcwText FilesSection}" />
        </StackPanel>
      </ui:PlainButton>
      <StackPanel Grid.Column="1" Orientation="Horizontal" IsVisible="{Binding IsExpanded}">
        <ui:NcwButton Classes="icon" Variant="Ghost" Command="{Binding ToggleFilterCommand}" arc:Tooltip.Tip="{l:NcwText FilesFilterToggle}" AutomationProperties.Name="{l:NcwText FilesFilterToggle}">
          <lucide:LucideIcon Kind="Search" Size="14" />
        </ui:NcwButton>
        <ui:NcwButton Classes="icon" Variant="Ghost" Command="{Binding RefreshCommand}" arc:Tooltip.Tip="{l:NcwText Refresh}" AutomationProperties.Name="{l:NcwText Refresh}">
          <lucide:LucideIcon Kind="RefreshCw" Size="14" />
        </ui:NcwButton>
        <ui:NcwDropdownMenu x:Name="MoreMenu">
          <ui:NcwDropdownMenu.Trigger>
            <ui:NcwButton Classes="icon" Variant="Ghost" AutomationProperties.Name="{l:NcwText More}" arc:Tooltip.Tip="{l:NcwText More}">
              <lucide:LucideIcon Kind="Ellipsis" Size="14" />
            </ui:NcwButton>
          </ui:NcwDropdownMenu.Trigger>
        </ui:NcwDropdownMenu>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,*" IsVisible="{Binding IsExpanded}">
      <Grid ColumnDefinitions="*,Auto" Margin="10,0,6,2" MinHeight="28">
        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding ProjectName}" arc:Tooltip.Tip="{Binding ProjectPath}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <ui:NcwButton Classes="icon" Variant="Ghost" IsEnabled="{Binding CanWrite}" Command="{Binding NewFileCommand}" CommandParameter="{Binding Selected}" arc:Tooltip.Tip="{l:NcwText FilesNewFile}" AutomationProperties.Name="{l:NcwText FilesNewFile}">
            <lucide:LucideIcon Kind="FilePlus" Size="14" />
          </ui:NcwButton>
          <ui:NcwButton Classes="icon" Variant="Ghost" IsEnabled="{Binding CanWrite}" Command="{Binding NewFolderCommand}" CommandParameter="{Binding Selected}" arc:Tooltip.Tip="{l:NcwText FilesNewFolder}" AutomationProperties.Name="{l:NcwText FilesNewFolder}">
            <lucide:LucideIcon Kind="FolderPlus" Size="14" />
          </ui:NcwButton>
          <ui:NcwButton Classes="icon" Variant="Ghost" Command="{Binding LocateActiveCommand}" arc:Tooltip.Tip="{l:NcwText FilesLocateActive}" AutomationProperties.Name="{l:NcwText FilesLocateActive}">
            <lucide:LucideIcon Kind="LocateFixed" Size="14" />
          </ui:NcwButton>
          <ui:NcwButton Classes="icon" Variant="Ghost" Command="{Binding CollapseAllCommand}" arc:Tooltip.Tip="{l:NcwText CollapseAll}" AutomationProperties.Name="{l:NcwText CollapseAll}">
            <lucide:LucideIcon Kind="ListCollapse" Size="14" />
          </ui:NcwButton>
        </StackPanel>
      </Grid>

    <!-- 搜索:文件名 / 内容 -->
    <StackPanel Grid.Row="1" Margin="10,0,10,6" Spacing="6" IsVisible="{Binding IsFilterVisible}">
      <ui:NcwSearchField x:Name="SearchBox" Text="{Binding Search.Query, Mode=TwoWay}" PlaceholderText="{l:NcwText FilesSearchPlaceholder}" />
      <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding Search.IsActive}">
        <ui:PlainButton Height="24" Padding="10,0" Click="OnNamesMode" Classes.active="{Binding Search.IsNamesMode}">
          <TextBlock Classes="hint" Classes.sel="{Binding Search.IsNamesMode}" VerticalAlignment="Center" Text="{l:NcwText FilesSearchNames}" />
        </ui:PlainButton>
        <ui:PlainButton Height="24" Padding="10,0" Click="OnContentsMode" Classes.active="{Binding Search.IsContentsMode}">
          <TextBlock Classes="hint" Classes.sel="{Binding Search.IsContentsMode}" VerticalAlignment="Center" Text="{l:NcwText FilesSearchContents}" />
        </ui:PlainButton>
      </StackPanel>
    </StackPanel>

    <insp:ProblemBar Grid.Row="2" Margin="10,0,10,6" Problem="{Binding Failure}" />

    <!-- 内容区:树 / 搜索结果 -->
    <Panel Grid.Row="3">
      <!-- 文件树 -->
      <Grid IsVisible="{Binding ShowsTree}" ui:NcwMotion.ShowMotion="Fade">
        <ui:NcwTreeView x:Name="Tree" Margin="4,0,4,6" Background="Transparent" BorderThickness="0"
                        RowHeight="25" ShowIndentGuides="True" ShowIcons="False" ItemsSource="{Binding Tree.Roots}" SelectedItem="{Binding Selected, Mode=TwoWay}">
          <ui:NcwTreeView.ItemTemplate>
            <DataTemplate x:DataType="vm:FileNodeViewModel">
              <insp:FileRow />
            </DataTemplate>
          </ui:NcwTreeView.ItemTemplate>
        </ui:NcwTreeView>
        <TextBlock Classes="hint" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0" Text="{l:NcwText FilesEmpty}">
          <TextBlock.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="Tree.IsEmpty" />
              <Binding Path="!Tree.IsLoading" />
            </MultiBinding>
          </TextBlock.IsVisible>
        </TextBlock>
      </Grid>

      <!-- 搜索结果 -->
      <ScrollViewer IsVisible="{Binding ShowsSearch}" ui:NcwMotion.ShowMotion="Fade" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="6,0,6,12" Spacing="2">
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,4" IsVisible="{Binding Search.IsSearching}" ui:NcwMotion.ShowMotion="Fade">
            <lucide:LucideIcon Classes="spin" Kind="LoaderCircle" Size="14" Foreground="{arc:ArcDesignTokenResource TextMuted}" />
            <TextBlock Classes="hint" Text="{l:NcwText FilesSearching}" />
          </StackPanel>
          <TextBlock Classes="hint" Margin="8,8" IsVisible="{Binding Search.HasNoResults}" ui:NcwMotion.ShowMotion="Fade" Text="{l:NcwText FilesNoResults}" />
          <insp:ProblemBar Margin="4,0" Problem="{Binding Search.Failure}" />
          <ItemsControl ItemsSource="{Binding Search.Results}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:FileSearchResult">
                <ui:PlainButton Padding="8,5" Click="OnResultClick">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" RowDefinitions="Auto,Auto">
                    <ui:NcwFileIcon Path="{Binding Path}" Width="16" Height="16" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" FontSize="{arc:ArcDesignTokenResource TypeSM}" TextTrimming="CharacterEllipsis">
                      <Run Text="{Binding Name}" /><Run Text="  " /><Run Text="{Binding Directory}" FontSize="{arc:ArcDesignTokenResource TypeXS}" Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                    </TextBlock>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasLine}">
                      <TextBlock Classes="lineNo" Text="{Binding Line}" />
                      <TextBlock Classes="diffText" Foreground="{arc:ArcDesignTokenResource TextSecondary}" Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Grid>
                </ui:PlainButton>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="hint" Margin="8,4" IsVisible="{Binding Search.Truncated}" ui:NcwMotion.ShowMotion="Fade" Text="{l:NcwText FilesResultsTruncated}" />
        </StackPanel>
      </ScrollViewer>
    </Panel>
    </Grid>
  </Grid>
</UserControl>
