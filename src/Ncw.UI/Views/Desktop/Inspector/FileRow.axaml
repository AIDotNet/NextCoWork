<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Ncw.UI.Localization"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:ui="using:Ncw.UI.Controls"
             xmlns:cv="using:Ncw.UI.Converters"
             xmlns:vm="using:Ncw.Client.ViewModels"
             xmlns:insp="using:Ncw.UI.Views.Desktop.Inspector"
             x:Class="Ncw.UI.Views.Desktop.Inspector.FileRow"
             x:DataType="vm:FileNodeViewModel">
  <!-- 文件树的一行:文件 / 目录(图标、名字、Git 状态字母、含变更的目录后的点)、「加载中」占位、「显示更多」。右键菜单由 code-behind 按节点类型挂上。 -->
  <UserControl.Styles>
    <Style Selector="TextBlock.added"><Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Success}" /></Style>
    <Style Selector="TextBlock.deleted"><Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Danger}" /></Style>
    <Style Selector="TextBlock.modified"><Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Warning}" /></Style>
    <Style Selector="TextBlock.renamed"><Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Accent}" /></Style>
    <Style Selector="ui|NcwButton.reference"><Setter Property="Opacity" Value="0" /></Style>
    <Style Selector="UserControl:pointerover ui|NcwButton.reference"><Setter Property="Opacity" Value="1" /></Style>
    <Style Selector="ui|NcwButton.reference:focus"><Setter Property="Opacity" Value="1" /></Style>
  </UserControl.Styles>
  <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
    <!-- 真实的行 -->
    <ui:NcwFileIcon Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"
                    Path="{Binding DisplayNode.Path}" IsDirectory="{Binding IsDirectory}"
                    IsExpanded="{Binding IsExpanded}" IsVisible="{Binding IsEntry}" />
    <TextBlock Grid.Column="1" FontSize="{arc:ArcDesignTokenResource TypeSM}" VerticalAlignment="Center"
               Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" IsVisible="{Binding ShowsLabel}"
               arc:Tooltip.Tip="{Binding Path}" Classes.dim="{Binding IsDimmed}"
               Classes.added="{Binding IsAddedChange}" Classes.deleted="{Binding IsDeletedChange}"
               Classes.modified="{Binding IsModifiedChange}" Classes.renamed="{Binding IsRenamedChange}" />
    <TextBlock Grid.Column="2" Classes="letter" Margin="8,0,6,0" Text="{Binding ChangeLetter}"
               IsVisible="{Binding HasChange}" Classes.added="{Binding IsAddedChange}" Classes.deleted="{Binding IsDeletedChange}"
               Classes.modified="{Binding IsModifiedChange}" Classes.renamed="{Binding IsRenamedChange}" />
    <Ellipse Grid.Column="3" Width="6" Height="6" Margin="8,0" VerticalAlignment="Center"
             IsVisible="{Binding HasChangedDescendant}" Fill="{arc:ArcDesignTokenResource Warning}" />
    <ui:NcwInput x:Name="NameEditor" Grid.Column="1" Text="{Binding EditName, Mode=TwoWay}"
                 IsVisible="{Binding IsEditing}" Placeholder="{l:NcwText FilesInlineName}"
                 AutomationProperties.Name="{l:NcwText FilesInlineName}" KeyDown="OnEditorKeyDown" LostFocus="OnEditorLostFocus" />
    <ui:NcwButton x:Name="ReferenceButton" Grid.Column="4" Classes="icon reference" Variant="Ghost"
                  Click="OnReferenceClick" arc:Tooltip.Tip="{l:NcwText FilesReferenceInChat}"
                  AutomationProperties.Name="{l:NcwText FilesReferenceInChat}">
      <ui:NcwButton.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.And}">
          <Binding Path="CanReference" />
          <Binding Path="$parent[insp:FilesPane].((vm:FilesPanelViewModel)DataContext).IsReferenceAvailable" />
        </MultiBinding>
      </ui:NcwButton.IsVisible>
      <lucide:LucideIcon Kind="AtSign" Size="13" />
    </ui:NcwButton>
    <!-- 加载中 -->
    <StackPanel Grid.ColumnSpan="5" Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsPlaceholder}">
      <lucide:LucideIcon Classes="spin" Kind="LoaderCircle" Size="12" Foreground="{arc:ArcDesignTokenResource TextMuted}" />
      <TextBlock Classes="hint" Text="{l:NcwText FileLoading}" />
    </StackPanel>
    <!-- 显示更多 -->
    <TextBlock Grid.ColumnSpan="5" Classes="hint" Foreground="{arc:ArcDesignTokenResource Accent}" IsVisible="{Binding IsMore}"
               Text="{Binding Remaining, Converter={x:Static cv:TextFormatConverter.Instance}, ConverterParameter=FilesShowMore}" />
  </Grid>
</UserControl>
