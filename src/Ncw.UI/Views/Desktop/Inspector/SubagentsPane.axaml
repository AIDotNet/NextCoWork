<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Ncw.UI.Localization"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:ui="using:Ncw.UI.Controls"
             xmlns:cv="using:Ncw.UI.Converters"
             xmlns:vm="using:Ncw.Client.ViewModels"
             xmlns:conv="using:Ncw.UI.Views.Desktop.Conversation"
             x:Class="Ncw.UI.Views.Desktop.Inspector.SubagentsPane"
             x:DataType="vm:InspectorViewModel">
  <!--
    子代理页签:卡片列表(状态文案、计时、能否停止都来自 Core 的 SubagentView.Of)→ 点卡片看这个子代理的只读转录(订阅子会话,子 Run 还在跑时再订阅 run/&lt;childRunId&gt;;
    和主对话同一个归约与转录派生)。只靠回执重建的旧卡片(重启后没有子会话 id)点不开:给一句明确的提示,不发请求。
  -->
  <Grid RowDefinitions="Auto,*">
    <Border Grid.Row="0" Classes="notice" Margin="10,2,10,6" IsVisible="{Binding HasNotice}" ui:NcwMotion.ShowMotion="Rise">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
        <lucide:LucideIcon Kind="Info" Size="14" VerticalAlignment="Top" Margin="0,2,0,0" Foreground="{arc:ArcDesignTokenResource Warning}" />
        <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="{arc:ArcDesignTokenResource TypeSM}" Text="{Binding Notice, Converter={x:Static cv:SubagentNoticeTextConverter.Instance}}" />
        <ui:PlainButton Grid.Column="2" Width="22" Height="22" Command="{Binding DismissNoticeCommand}" AutomationProperties.Name="{l:NcwText Dismiss}">
          <lucide:LucideIcon Kind="X" Size="11" HorizontalAlignment="Center" />
        </ui:PlainButton>
      </Grid>
    </Border>

    <Panel Grid.Row="1">
      <!-- 卡片列表 -->
      <ScrollViewer IsVisible="{Binding Transcript, Converter={x:Static ObjectConverters.IsNull}}" ui:NcwMotion.ShowMotion="Fade" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl Margin="10,4,10,12" ItemsSource="{Binding Subagents}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="8" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SubagentItemViewModel">
              <Border Classes="card">
                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" RowSpacing="4">
                  <Panel Width="10" Height="10" VerticalAlignment="Center">
                    <Border CornerRadius="5" Background="{arc:ArcDesignTokenResource Accent}" IsVisible="{Binding IsActive}" />
                    <Border CornerRadius="5" Background="{arc:ArcDesignTokenResource TextMuted}" IsVisible="{Binding IsUnknown}" />
                    <Border CornerRadius="5" Background="{arc:ArcDesignTokenResource Success}" IsVisible="{Binding IsTerminal}" />
                  </Panel>
                  <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Classes="hint" Text="{Binding View, Converter={x:Static cv:SubagentTextConverter.Status}}" VerticalAlignment="Center" IsVisible="{Binding !IsUnknown}" />
                  <TextBlock Grid.Column="2" Classes="hint" Text="{l:NcwText DeviceConnecting}" VerticalAlignment="Center" IsVisible="{Binding IsUnknown}" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Classes="hint" Text="{Binding View, Converter={x:Static cv:SubagentTextConverter.Detail}}" VerticalAlignment="Center" />
                  <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Spacing="2">
                    <ui:NcwButton Classes="icon" Variant="Ghost" Width="26" Height="26"
                                  Command="{Binding $parent[ItemsControl].((vm:InspectorViewModel)DataContext).OpenSubagentCommand}" CommandParameter="{Binding}"
                                  AutomationProperties.Name="{l:NcwText OpenSubagent}" arc:Tooltip.Tip="{l:NcwText OpenSubagent}">
                      <lucide:LucideIcon Kind="PanelRightOpen" Size="13" />
                    </ui:NcwButton>
                    <ui:NcwButton Classes="icon" Variant="Ghost" Width="26" Height="26" IsVisible="{Binding CanStop}"
                                  Command="{Binding $parent[ItemsControl].((vm:InspectorViewModel)DataContext).StopSubagentCommand}" CommandParameter="{Binding}"
                                  AutomationProperties.Name="{l:NcwText StopSubagent}" arc:Tooltip.Tip="{l:NcwText StopSubagent}">
                      <lucide:LucideIcon Kind="Square" Size="12" />
                    </ui:NcwButton>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- 转录 -->
      <Grid RowDefinitions="Auto,*" IsVisible="{Binding Transcript, Converter={x:Static ObjectConverters.IsNotNull}}" ui:NcwMotion.ShowMotion="Fade">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="4" Margin="8,0,8,4" Height="32">
          <ui:NcwButton Classes="icon" Variant="Ghost" Command="{Binding CloseTranscriptCommand}" AutomationProperties.Name="{l:NcwText SubagentBack}" arc:Tooltip.Tip="{l:NcwText SubagentBack}">
            <lucide:LucideIcon Kind="ArrowLeft" Size="15" />
          </ui:NcwButton>
          <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Transcript.Title}" TextTrimming="CharacterEllipsis" />
        </Grid>
        <Panel Grid.Row="1" DataContext="{Binding Transcript}" x:DataType="vm:SubagentTranscriptViewModel">
          <StackPanel IsVisible="{Binding IsLoading}" ui:NcwMotion.ShowMotion="Fade" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0">
            <lucide:LucideIcon Classes="spin" Kind="LoaderCircle" Size="14" Foreground="{arc:ArcDesignTokenResource TextMuted}" />
            <TextBlock Classes="hint" Text="{l:NcwText SubagentTranscriptLoading}" />
          </StackPanel>
          <StackPanel IsVisible="{Binding IsUnknown}" ui:NcwMotion.ShowMotion="Fade" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0">
            <lucide:LucideIcon Classes="spin" Kind="LoaderCircle" Size="14" Foreground="{arc:ArcDesignTokenResource Warning}" />
            <TextBlock Classes="hint" Text="{l:NcwText DeviceConnecting}" />
          </StackPanel>
          <TextBlock Classes="hint" IsVisible="{Binding IsEmpty}" ui:NcwMotion.ShowMotion="Fade" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0" Text="{l:NcwText SubagentTranscriptEmpty}" />
          <conv:TranscriptList ItemsSource="{Binding Rows}" IsReadOnly="True" ContentMargin="10,4,10,12" />
        </Panel>
      </Grid>
    </Panel>
  </Grid>
</UserControl>
