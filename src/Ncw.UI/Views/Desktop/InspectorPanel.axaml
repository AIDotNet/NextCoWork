<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Ncw.UI.Localization"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:ui="using:Ncw.UI.Controls"
             xmlns:cv="using:Ncw.UI.Converters"
             xmlns:vm="using:Ncw.Client.ViewModels"
             xmlns:insp="using:Ncw.UI.Views.Desktop.Inspector"
             xmlns:themes="using:Ncw.UI.Themes"
             x:Class="Ncw.UI.Views.Desktop.InspectorPanel"
             x:DataType="vm:InspectorViewModel">
  <!--
    右侧面板(docs/design/03 §1):默认是文件管理器;Git、上下文、历史通过「+」添加;
    当前会话有子代理时自动出现「子代理」页签。页签行就是窗口顶部这一行的右段。
  -->
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <themes:NcwTheme />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <UserControl.Styles>
    <themes:NcwStyles />
    <Style Selector="Border.card">
      <Setter Property="Padding" Value="12" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderSubtle}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="40,*">
    <!-- 页签行 -->
    <Grid x:Name="HeaderRow" ColumnDefinitions="Auto,Auto,*" Margin="8,0">
      <ItemsControl ItemsSource="{Binding Tabs}" VerticalAlignment="Center">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="2" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:InspectorTabViewModel">
            <ui:PlainButton Height="28" Padding="7,0" MinWidth="28"
                            Classes.active="{Binding IsActive}"
                            Command="{Binding $parent[ItemsControl].((vm:InspectorViewModel)DataContext).ActivateCommand}"
                            CommandParameter="{Binding Kind}"
                            AutomationProperties.Name="{Binding Kind, Converter={x:Static cv:InspectorTabTitleConverter.Instance}}"
                            arc:Tooltip.Tip="{Binding Kind, Converter={x:Static cv:InspectorTabTitleConverter.Instance}}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Panel Width="14" VerticalAlignment="Center">
                  <lucide:LucideIcon Kind="Files" Size="14" IsVisible="{Binding IsFiles}" />
                  <lucide:LucideIcon Kind="GitCompare" Size="14" IsVisible="{Binding IsGit}" />
                  <lucide:LucideIcon Kind="FileDiff" Size="14" IsVisible="{Binding IsReview}" />
                  <lucide:LucideIcon Kind="SquareTerminal" Size="14" IsVisible="{Binding IsTerminal}" />
                  <lucide:LucideIcon Kind="Gauge" Size="14" IsVisible="{Binding IsContext}" />
                  <lucide:LucideIcon Kind="History" Size="14" IsVisible="{Binding IsHistory}" />
                  <lucide:LucideIcon Kind="Bot" Size="14" IsVisible="{Binding IsSubagents}" />
                </Panel>
                <!-- 选中的页签显示名称;其余只显示图标 -->
                <TextBlock Text="{Binding Kind, Converter={x:Static cv:InspectorTabTitleConverter.Instance}}" VerticalAlignment="Center" IsVisible="{Binding IsActive}" />
                <Border MinWidth="16" Height="16" Padding="4,0" CornerRadius="8" VerticalAlignment="Center"
                        Background="{arc:ArcDesignTokenResource AccentSubtle}" IsVisible="{Binding HasCount}">
                  <TextBlock Text="{Binding Count}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"
                             VerticalAlignment="Center" Foreground="{arc:ArcDesignTokenResource Accent}" />
                </Border>
                <ui:PlainButton Width="16" Height="16" CornerRadius="4" IsVisible="{Binding ShowsClose}"
                                Command="{Binding $parent[ItemsControl].((vm:InspectorViewModel)DataContext).CloseCommand}"
                                CommandParameter="{Binding Kind}"
                                AutomationProperties.Name="{l:NcwText CloseTabShort}">
                  <lucide:LucideIcon Kind="X" Size="10" HorizontalAlignment="Center" />
                </ui:PlainButton>
              </StackPanel>
            </ui:PlainButton>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <!-- 「+」:添加 Git、审查、终端、上下文、历史 -->
      <ui:NcwDropdownMenu x:Name="AddMenu" Grid.Column="1" Margin="2,0,0,0" VerticalAlignment="Center"
                          IsVisible="{Binding HasAddable}">
        <ui:NcwDropdownMenu.Trigger>
          <ui:NcwButton Classes="icon" Variant="Ghost" AutomationProperties.Name="{l:NcwText AddTab}" arc:Tooltip.Tip="{l:NcwText AddTab}">
            <lucide:LucideIcon Kind="Plus" Size="15" />
          </ui:NcwButton>
        </ui:NcwDropdownMenu.Trigger>
      </ui:NcwDropdownMenu>
    </Grid>

    <!-- 文件管理器(默认) -->
    <Panel Grid.Row="1" IsVisible="{Binding IsFiles}">
      <insp:FilesPane DataContext="{Binding Files}" />
    </Panel>

    <!-- Git -->
    <Panel Grid.Row="1" IsVisible="{Binding IsGit}">
      <insp:GitPane DataContext="{Binding Git}" />
    </Panel>

    <!-- 改动审查 -->
    <Panel Grid.Row="1" IsVisible="{Binding IsReview}">
      <insp:ReviewPane DataContext="{Binding Review}" />
    </Panel>

    <!-- 终端 -->
    <Panel Grid.Row="1" IsVisible="{Binding IsTerminal}">
      <insp:TerminalPane DataContext="{Binding Terminals}" />
    </Panel>

    <!-- 上下文 -->
    <ScrollViewer Grid.Row="1" IsVisible="{Binding IsContext}">
      <StackPanel Margin="14,6,14,14" Spacing="14">
        <StackPanel Spacing="8">
          <TextBlock Classes="section" Text="{l:NcwText TabContext}" />
          <Border Classes="card">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="102K / 200K" />
                <TextBlock Grid.Column="1" Classes="hint" Text="51%" />
              </Grid>
              <Grid ColumnDefinitions="51*,49*" Height="6">
                <Border CornerRadius="3,0,0,3" Background="{arc:ArcDesignTokenResource Accent}" />
                <Border Grid.Column="1" CornerRadius="0,3,3,0" Background="{arc:ArcDesignTokenResource SurfaceMuted}" />
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel Spacing="8">
          <TextBlock Classes="section" Text="{l:NcwText Todos}" />
          <Border Classes="card">
            <TextBlock Classes="hint" TextWrapping="Wrap" Text="{l:NcwText TodosPlaceholder}" />
          </Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- 历史(M4 接入) -->
    <StackPanel Grid.Row="1" Margin="14,16" Spacing="6" IsVisible="{Binding IsHistory}">
      <TextBlock Text="{l:NcwText TabHistory}" FontWeight="SemiBold" />
      <TextBlock Classes="hint" Text="{l:NcwText HistoryPlaceholder}" TextWrapping="Wrap" />
    </StackPanel>

    <!-- 子代理:状态文案、计时、能否停止都来自 SubagentView.Of;点开看只读转录 -->
    <Panel Grid.Row="1" IsVisible="{Binding IsSubagents}">
      <insp:SubagentsPane />
    </Panel>
  </Grid>
</UserControl>
