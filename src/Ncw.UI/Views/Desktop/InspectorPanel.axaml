<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:ui="using:Ncw.UI.Controls"
             xmlns:vm="using:Ncw.Client.ViewModels"
             x:Class="Ncw.UI.Views.Desktop.InspectorPanel"
             x:DataType="vm:ShellViewModel">
  <!-- 右侧检查器(可选的第四栏)。内容跟随当前标签页;M1 是占位。 -->
  <UserControl.Styles>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Padding" Value="12" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderSubtle}" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="40,*">
  <!-- 页签行 = 窗口顶部这一行的右段;右端给常驻的检查器开关和窗口按钮让位 -->
  <Grid x:Name="HeaderRow" ColumnDefinitions="Auto,*" Margin="8,0">
    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
      <ui:PlainButton Classes="active" Height="28" Padding="8,0">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <lucide:LucideIcon Kind="LayoutDashboard" Size="14" VerticalAlignment="Center" />
          <TextBlock x:Name="OverviewLabel" Text="概览" VerticalAlignment="Center" />
        </StackPanel>
      </ui:PlainButton>
      <ui:PlainButton Width="28" Height="28" AutomationProperties.Name="变更" arc:Tooltip.Tip="变更">
        <lucide:LucideIcon Kind="GitCompare" Size="14" HorizontalAlignment="Center" />
      </ui:PlainButton>
      <ui:PlainButton Width="28" Height="28" AutomationProperties.Name="子代理" arc:Tooltip.Tip="子代理">
        <lucide:LucideIcon Kind="Bot" Size="14" HorizontalAlignment="Center" />
      </ui:PlainButton>
      <ui:PlainButton Width="28" Height="28" AutomationProperties.Name="历史" arc:Tooltip.Tip="历史">
        <lucide:LucideIcon Kind="History" Size="14" HorizontalAlignment="Center" />
      </ui:PlainButton>
    </StackPanel>
  </Grid>
  <ScrollViewer Grid.Row="1">
    <StackPanel Margin="14,6,14,14" Spacing="14">
      <StackPanel Spacing="8">
        <TextBlock Classes="section" Text="上下文" />
        <Border Classes="card">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="已用 102K / 200K" />
              <TextBlock Grid.Column="1" Foreground="{arc:ArcDesignTokenResource TextMuted}">
                <Run Text="{Binding Workspace.ContextPercent}" /><Run Text="%" />
              </TextBlock>
            </Grid>
            <Grid ColumnDefinitions="51*,49*" Height="6">
              <Border CornerRadius="3,0,0,3" Background="{arc:ArcDesignTokenResource Accent}" />
              <Border Grid.Column="1" CornerRadius="0,3,3,0" Background="{arc:ArcDesignTokenResource SurfaceMuted}" />
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
      <StackPanel Spacing="8">
        <TextBlock Classes="section" Text="待办" />
        <Border Classes="card">
          <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <lucide:LucideIcon Kind="CircleCheck" Size="14" Foreground="{arc:ArcDesignTokenResource Success}" />
              <TextBlock Text="搭建解决方案骨架" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <lucide:LucideIcon Kind="LoaderCircle" Size="14" Foreground="{arc:ArcDesignTokenResource Accent}" />
              <TextBlock Text="三栏外壳与项目分组" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <lucide:LucideIcon Kind="Circle" Size="14" Foreground="{arc:ArcDesignTokenResource TextMuted}" />
              <TextBlock Text="设备协议骨架" />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
      <StackPanel Spacing="8">
        <TextBlock Classes="section" Text="子代理 (2)" />
        <Border Classes="card">
          <StackPanel Spacing="6">
            <TextBlock Text="code-analyst · 阅读 kernel/upstream" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="general-purpose · 调研 pi 设计" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Border>
      </StackPanel>
      <StackPanel Spacing="8">
        <TextBlock Classes="section" Text="变更文件 (3)" />
        <Border Classes="card">
          <StackPanel Spacing="6">
            <TextBlock FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}" Text="src/Ncw.Core/Layout/RailLayout.cs" TextTrimming="CharacterEllipsis" />
            <TextBlock FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}" Text="src/Ncw.UI/Views/Desktop/DesktopShell.axaml" TextTrimming="CharacterEllipsis" />
            <TextBlock FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}" Text="docs/design/03-ui-layout.md" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Border>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
  </Grid>
</UserControl>
