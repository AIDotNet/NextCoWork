<Project Sdk="Microsoft.NET.Sdk">
  <!-- Avalonia 视图 + 对 Arc 的薄封装(Ncw.UI.Controls)。业务视图只引用封装,不直接写 arc: 控件(AGENTS.md §2)。 -->
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <!-- 内联可视化的 WebView 外壳(只有 Controls/NcwWidgetSurface.cs 引用它)。 -->
    <PackageReference Include="Avalonia.Controls.WebView" />
    <PackageReference Include="TKCode.Arc" />
    <PackageReference Include="TKCode.Arc.Fonts" />
    <PackageReference Include="TKCode.Arc.Markdown" />
    <PackageReference Include="TKCode.Arc.Highlighting" />
    <PackageReference Include="TKCode.Arc.Icons.Lucide" />
    <PackageReference Include="TKCode.Arc.Mobile" />
    <PackageReference Include="TKCode.Arc.Special" />
    <PackageReference Include="TKCode.Arc.Terminal" />
    <PackageReference Include="TKCode.Arc.Workflow" />
    <PackageReference Include="TKCode.Arc.Video" />
    <PackageReference Include="TKCode.Arc.Video.Native" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Ncw.Client/Ncw.Client.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- 品牌标识(2.x 的 NextCoWork 图标,256 px,圆角方块自带透明边距);启动加载界面用。 -->
    <AvaloniaResource Include="Assets/nextcowork-mark.png" />
    <!-- 窗口图标(Windows / Linux 标题栏、任务栏、Alt+Tab 使用)。 -->
    <AvaloniaResource Include="..\Ncw.Desktop\Assets\AppIcon.ico" Link="Assets\AppIcon.ico" />
    <!-- 供应商 logo(models.dev 的单色 logo,MIT,许可证在同目录):NcwProviderLogo 按服务 id 读,颜色跟随 Arc token。 -->
    <AvaloniaResource Include="Assets/ProviderLogos/*.svg" />
  </ItemGroup>
  <ItemGroup>
    <!-- 运行时才确定的 Lucide 图标必须在这里声明,否则画不出来(ARCL002)。 -->
    <LucideIcon Include="Cloud;Link;Monitor;Bot;SquareTerminal;MessageSquare;FolderPlus;Folder;FolderOpen;File;GitCompare;Gauge;History;Pin;PinOff;FilePlus;CalendarClock" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Ncw.UI.Tests" />
  </ItemGroup>
</Project>
