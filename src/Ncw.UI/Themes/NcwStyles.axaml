<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
        xmlns:ui="using:Ncw.UI.Controls"
        x:Class="Ncw.UI.Themes.NcwStyles">
  <!-- 顶部这一行和工具栏里的小方形图标按钮。NcwButton 的样式键是 Arc 的 Button,所以选择器写 arc|Button。 -->
  <Style Selector="arc|Button.icon">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="IsPressScaleEnabled" Value="False" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
    <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
</Styles>
