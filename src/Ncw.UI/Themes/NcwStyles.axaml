<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
        xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
        xmlns:ui="using:Ncw.UI.Controls"
        x:Class="Ncw.UI.Themes.NcwStyles">
  <!-- 顶部这一行和工具栏里的小方形图标按钮。NcwButton 的样式键是 Arc 的 Button,所以选择器写 arc|Button。 -->
  <Style Selector="arc|Button.icon">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="IsPressScaleEnabled" Value="False" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
    <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- 对话区和设置页共用的几个小样式:卡片、说明文字、等宽字、小标签、旋转的加载图标。颜色全部来自 Arc token。 -->
  <Style Selector="Border.card">
    <Setter Property="arc:ArcMotion.Tracks" Value="True" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderSubtle}" />
  </Style>
  <!-- 卡片的状态描边(等待审批 / 失败)渐变,不是闪一下 -->
  <Style Selector="Border.card:motion-full, Border.card:motion-reduced">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="{arc:ArcDesignTokenResource DurationStandard}" Easing="{arc:ArcDesignTokenResource EaseStandard}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.card.attention">
    <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Warning}" />
  </Style>
  <Style Selector="Border.card.danger">
    <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Danger}" />
  </Style>
  <!-- 供应商 logo 的底板(列表栏、详情页头、发现候选、添加供应商弹窗共用);标志本身跟随前景色 -->
  <Style Selector="ui|NcwProviderLogo.tile">
    <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
    <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
  </Style>
  <!-- 停用的供应商:logo 变淡 -->
  <Style Selector="ui|NcwProviderLogo.tile.off">
    <Setter Property="Opacity" Value="0.45" />
  </Style>
  <Style Selector="Border.chip">
    <Setter Property="Padding" Value="6,1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.hint">
    <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
    <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <!-- 工具调用行的工具名;失败的工具名和目标变红(结果仍默认收起)。失败写在后面,同样特异度时后者胜出 -->
  <Style Selector="TextBlock.hint.toolName">
    <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
  </Style>
  <Style Selector="TextBlock.hint.toolTarget">
    <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
  </Style>
  <Style Selector="TextBlock.hint.failed">
    <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Danger}" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
  </Style>
  <Style Selector="TextBlock.sectionTitle">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,18,0,6" />
  </Style>
  <!-- 运行中图标:旋转由 NcwMotion.Busy 驱动(Arc 的 LiveLoop:离开界面 / 隐藏 / 滚出视口自动暂停;减弱级别换成明暗呼吸,关闭级别静止)。
       以前是一条无限循环的样式动画,不看动效级别,而且对看不见的图标也在跑。 -->
  <Style Selector="lucide|LucideIcon.spin">
    <Setter Property="ui:NcwMotion.Busy" Value="Spin" />
  </Style>
  <!-- 展开 / 收起的箭头:同一个图标旋转(右箭头 .chevron 展开时转 90° 朝下;下箭头 .chevronDown 展开时转 180° 朝上),
       不再是两个图标按 IsVisible 互换。只有完整级别转动(减弱 / 关闭级别下位置直接跳到终态,Arc 的 :motion-full 伪类)。 -->
  <Style Selector="lucide|LucideIcon.chevron, lucide|LucideIcon.chevronDown">
    <Setter Property="arc:ArcMotion.Tracks" Value="True" />
    <Setter Property="RenderTransform" Value="rotate(0deg)" />
  </Style>
  <Style Selector="lucide|LucideIcon.chevron.open"><Setter Property="RenderTransform" Value="rotate(90deg)" /></Style>
  <Style Selector="lucide|LucideIcon.chevronDown.open"><Setter Property="RenderTransform" Value="rotate(180deg)" /></Style>
  <Style Selector="lucide|LucideIcon.chevron:motion-full, lucide|LucideIcon.chevronDown:motion-full">
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="{arc:ArcDesignTokenResource DurationFast}" Easing="{arc:ArcDesignTokenResource EaseStandard}" />
      </Transitions>
    </Setter>
  </Style>
  <!-- 右侧检查器各页签共用:分节标题、状态字母、diff 行、等宽小字。颜色全部来自 Arc token。 -->
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
  </Style>
  <Style Selector="TextBlock.hint.sel">
    <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.dim">
    <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
  </Style>
  <Style Selector="TextBlock.letter">
    <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource MonoFontFamily}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.letter.modified">
    <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Warning}" />
  </Style>
  <Style Selector="TextBlock.letter.added">
    <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Success}" />
  </Style>
  <Style Selector="TextBlock.letter.deleted">
    <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Danger}" />
  </Style>
  <Style Selector="TextBlock.letter.conflicted">
    <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Danger}" />
  </Style>
  <Style Selector="TextBlock.diffText">
    <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.lineNo">
    <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
    <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
    <Setter Property="TextAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.diffRow.added">
    <Setter Property="Background" Value="{arc:ArcDesignTokenResource SuccessSubtle}" />
  </Style>
  <Style Selector="Border.diffRow.removed">
    <Setter Property="Background" Value="{arc:ArcDesignTokenResource DangerSubtle}" />
  </Style>
  <Style Selector="Border.diffRow.fold">
    <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
  </Style>
  <!-- 管理页的状态小圆点:ok / warn / bad / mute(NcwStatusDot) -->
  <Style Selector="Border.dot">
    <Setter Property="arc:ArcMotion.Tracks" Value="True" />
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{arc:ArcDesignTokenResource TextMuted}" />
  </Style>
  <!-- 状态点的颜色渐变(ok / warn / bad / mute 之间)。「未知」不用这些点表达:设备断开时是旋转的加载图标(规则 7),
       所以颜色渐变不会在「运行中 → 未知」之间经过任何像「已结束」的中间色。 -->
  <Style Selector="Border.dot:motion-full, Border.dot:motion-reduced">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="{arc:ArcDesignTokenResource DurationStandard}" Easing="{arc:ArcDesignTokenResource EaseStandard}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.dot.ok"><Setter Property="Background" Value="{arc:ArcDesignTokenResource Success}" /></Style>
  <Style Selector="Border.dot.warn"><Setter Property="Background" Value="{arc:ArcDesignTokenResource Warning}" /></Style>
  <Style Selector="Border.dot.bad"><Setter Property="Background" Value="{arc:ArcDesignTokenResource Danger}" /></Style>
  <!-- 强度刻度条(NcwLevelMeter):暗格是边框色,亮格是次要文字色;「自动」的亮格用强调色 -->
  <Style Selector="ui|NcwLevelMeter > Border.bar">
    <Setter Property="Background" Value="{arc:ArcDesignTokenResource BorderStrong}" />
  </Style>
  <Style Selector="ui|NcwLevelMeter > Border.bar.on">
    <Setter Property="Background" Value="{arc:ArcDesignTokenResource TextSecondary}" />
  </Style>
  <Style Selector="ui|NcwLevelMeter.auto > Border.bar.on">
    <Setter Property="Background" Value="{arc:ArcDesignTokenResource Accent}" />
  </Style>
  <Style Selector="Border.problem">
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{arc:ArcDesignTokenResource DangerSubtle}" />
  </Style>
  <Style Selector="Border.notice">
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{arc:ArcDesignTokenResource WarningSubtle}" />
  </Style>
</Styles>
