{
  "name": "nextcowork",
  "version": "2.2.4",
  "description": "NextCoWork — 编码型 Agent 桌面端",
  "main": "./out/main/index.js",
  "author": "NextCoWork",
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "npm run build:plugin-runtime && electron-vite dev --watch",
    "start": "electron-vite preview",
    "build": "npm run typecheck && npm run build:plugin-runtime && electron-vite build",
    "build:plugin-runtime": "node scripts/build-plugin-runtime.mjs",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:release": "node --test scripts/upload-client-release.test.mjs",
    "release:upload": "node scripts/upload-client-release.mjs",
    "e2e": "npm run build && node scripts/e2e-probe.mjs",
    "e2e:theme": "npm run build && node scripts/theme-probe.mjs",
    "e2e:import": "npm run build && node scripts/import-probe.mjs",
    "shot": "npm run build && node scripts/screenshot.mjs",
    "review": "node scripts/inline-shots.mjs docs/design-review.standalone.html",
    "test:watch": "vitest",
    "dist": "npm run build && electron-builder",
    "dist:ci": "npm run build && electron-builder --publish never",
    "dist:dir": "npm run build && electron-builder --dir",
    "postinstall": "patch-package --error-on-fail && electron-builder install-app-deps"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "electron-updater": "^6.8.9",
    "node-pty": "^1.1.0",
    "playwright-core": "^1.59.1",
    "smol-toml": "^1.8.0",
    "ssh2-streams": "npm:ssh2-streams-classic@0.4.14",
    "undici": "7.29.1",
    "unzipper": "^0.12.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@codemirror/language-data": "^6.5.2",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^10.0.1",
    "@lobehub/icons-static-svg": "^1.94.0",
    "@lobehub/streamdown": "^1.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.9.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.7",
    "@types/ssh2-streams": "^0.1.13",
    "@types/unzipper": "^0.10.11",
    "@uiw/react-codemirror": "^4.25.11",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.1",
    "katex": "^0.16.47",
    "lucide-react": "^1.40.0",
    "mermaid": "^11.17.2",
    "motion": "^13.3.0",
    "patch-package": "8.0.1",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "swagger-ui-dist": "^5.34.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.0",
    "zustand": "^5.0.15"
  }
}
