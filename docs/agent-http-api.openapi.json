{
  "openapi": "3.0.3",
  "info": { "title": "NextCoWork Agent HTTP API", "version": "1.0.0", "description": "Stateful desktop Agent API. Enable the gateway in Settings; enable remote connections for LAN access. All endpoints require a Bearer key. The desktop application must remain running. This is not an OpenAI-compatible proxy. See agent-http-api.md for SSE and interaction semantics." },
  "servers": [{ "url": "/", "description": "Current gateway origin (including its actual port or HTTPS reverse proxy)" }],
  "security": [{ "BearerKey": [] }],
  "paths": {
    "/v1/status": { "get": { "operationId": "getStatus", "summary": "Read listener and upstream health", "responses": { "200": { "description": "Current gateway status", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GatewayStatus" } } } }, "default": { "$ref": "#/components/responses/Error" } } } },
    "/v1/workspaces": { "get": { "operationId": "listWorkspaces", "summary": "List current account workspaces", "responses": { "200": { "description": "Workspace list", "content": { "application/json": { "schema": { "type": "object", "required": ["data"], "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/Workspace" } } } } } } }, "default": { "$ref": "#/components/responses/Error" } } } },
    "/v1/models": { "get": { "operationId": "listModels", "summary": "List callable model aliases and provider IDs", "responses": { "200": { "description": "Model list; pass id as run.model", "content": { "application/json": { "schema": { "type": "object", "required": ["data"], "properties": { "data": { "type": "array", "items": { "type": "object", "required": ["id", "providerId"], "properties": { "id": { "type": "string" }, "providerId": { "type": "string" } } } } } } } } }, "default": { "$ref": "#/components/responses/Error" } } } },
    "/v1/sessions": {
      "get": { "operationId": "listSessions", "summary": "List workspace sessions", "parameters": [{ "name": "workspaceId", "in": "query", "required": true, "schema": { "$ref": "#/components/schemas/Id" } }], "responses": { "200": { "description": "Session list with running state", "content": { "application/json": { "schema": { "type": "object", "required": ["data"], "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/SessionListItem" } } } } } } }, "default": { "$ref": "#/components/responses/Error" } } },
      "post": { "operationId": "createSession", "summary": "Create a persistent conversation", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "additionalProperties": false, "required": ["workspaceId"], "properties": { "workspaceId": { "$ref": "#/components/schemas/Id" }, "title": { "type": "string", "maxLength": 256 } } }, "example": { "workspaceId": "workspace-id", "title": "API conversation" } } } }, "responses": { "201": { "description": "Created session", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Session" } } } }, "default": { "$ref": "#/components/responses/Error" } } }
    },
    "/v1/sessions/{sessionId}": { "parameters": [{ "$ref": "#/components/parameters/SessionId" }], "get": { "operationId": "getSession", "summary": "Read persisted conversation and messages", "responses": { "200": { "description": "Session detail; remains available after application restart", "content": { "application/json": { "schema": { "type": "object", "required": ["session", "messages"], "properties": { "session": { "$ref": "#/components/schemas/Session" }, "messages": { "type": "array", "items": { "$ref": "#/components/schemas/AgentMessage" } } } } } } }, "default": { "$ref": "#/components/responses/Error" } } } },
    "/v1/runs": { "post": { "operationId": "startRun", "summary": "Send a message through the complete Agent runtime", "description": "Uses the existing session transcript and workspace Skills, tools and MCP. Options inherit session/workspace defaults. Only one top-level run per session; conflicts return 409. A 202 is acceptance, not successful completion. Retrying may send the message twice. Read the session before retrying after a timeout.", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RunInput" }, "example": { "sessionId": "session-id", "text": "Explain this project", "permissionMode": "ask" } } } }, "responses": { "202": { "description": "Run accepted; subscribe to eventsUrl for completion and interactions", "content": { "application/json": { "schema": { "type": "object", "required": ["runId", "sessionId", "eventsUrl"], "properties": { "runId": { "type": "string" }, "sessionId": { "type": "string" }, "eventsUrl": { "type": "string", "example": "/v1/runs/run-id/events" } } } } } }, "409": { "$ref": "#/components/responses/Error" }, "default": { "$ref": "#/components/responses/Error" } } } },
    "/v1/runs/{runId}": { "parameters": [{ "$ref": "#/components/parameters/RunId" }], "get": { "operationId": "getRun", "summary": "Read the current run snapshot", "parameters": [{ "$ref": "#/components/parameters/SinceSeq" }], "responses": { "200": { "description": "In-process snapshot. After application restart read the persisted session instead.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RunSnapshot" } } } }, "default": { "$ref": "#/components/responses/Error" } } } },
    "/v1/runs/{runId}/events": { "parameters": [{ "$ref": "#/components/parameters/RunId" }], "get": { "operationId": "streamRun", "summary": "Stream an initial snapshot followed by live Agent events", "description": "SSE snapshot data is RunSnapshot; event data is {seq, event: AgentEvent}. SSE id equals seq. Replay may compact deltas into message_commit; snapshot sequences need not be contiguous. Apply snapshot then set cursor to snapshot.seq. The connection closes after run_end or a completed snapshot. Disconnecting does not abort. Heartbeats are comments. Slow clients are disconnected and can resume. Subscribe to childRunId separately for detailed child events.", "parameters": [{ "$ref": "#/components/parameters/SinceSeq" }, { "name": "Last-Event-ID", "in": "header", "schema": { "type": "integer", "minimum": 0 }, "description": "Resume cursor; sinceSeq takes precedence" }], "responses": { "200": { "description": "SSE stream", "content": { "text/event-stream": { "schema": { "type": "string" }, "example": "id: 0\nevent: snapshot\ndata: {\"runId\":\"run-id\",\"seq\":0,\"status\":\"running\",\"events\":[]}\n\n" } } }, "default": { "$ref": "#/components/responses/Error" } } } },
    "/v1/runs/{runId}/abort": { "parameters": [{ "$ref": "#/components/parameters/RunId" }], "post": { "operationId": "abortRun", "summary": "Abort the run and its child agents", "description": "Requests cancellation and pauses any session goal. Wait for run_end for final status and durable partial output.", "responses": { "204": { "description": "Cancellation requested; already ended runs are unchanged" }, "default": { "$ref": "#/components/responses/Error" } } } },
    "/v1/runs/{runId}/interactions": { "parameters": [{ "$ref": "#/components/parameters/RunId" }], "get": { "operationId": "listInteractions", "summary": "Read pending interactions for a run and its descendants", "responses": { "200": { "description": "Pending permissions, questions, plans and goal proposals", "content": { "application/json": { "schema": { "type": "object", "required": ["data"], "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/PendingInteraction" } } } } } } }, "default": { "$ref": "#/components/responses/Error" } } } },
    "/v1/interactions/{interactionId}/response": { "parameters": [{ "name": "interactionId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Id" } }], "post": { "operationId": "respondInteraction", "summary": "Answer an Agent permission, question, plan or goal proposal", "description": "The response kind must match the pending interaction. Answers must match the pending question count and options. request_revision requires nonempty feedback. Completed or already answered interactions return 409.", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/InteractionResponse" }, "example": { "kind": "tool_permission", "decision": { "kind": "allow_once" } } } } }, "responses": { "204": { "description": "Answer accepted" }, "400": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" }, "default": { "$ref": "#/components/responses/Error" } } } }
  },
  "components": {
    "securitySchemes": { "BearerKey": { "type": "http", "scheme": "bearer", "description": "Copy the API key from Settings > Connection > Open gateway. Paste only the key into Authorize (without the Bearer prefix). All operations require it. Only same-origin browser requests are accepted." } },
    "parameters": {
      "RunId": { "name": "runId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Id" } },
      "SessionId": { "name": "sessionId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Id" } },
      "SinceSeq": { "name": "sinceSeq", "in": "query", "schema": { "type": "integer", "minimum": 0, "maximum": 9007199254740991, "default": 0 }, "description": "Replay events after this cursor; overrides Last-Event-ID" }
    },
    "responses": { "Error": { "description": "400 invalid input or interaction answer; 401 invalid Bearer key; 403 forbidden Origin/Host; 404 missing resource; 409 session busy or expired interaction; 413 body over 1 MiB; 415 unsupported content type; 500 internal failure; 503 gateway/update unavailable. Body contains error.code and error.message.", "content": { "application/json": { "schema": { "type": "object", "required": ["error"], "properties": { "error": { "type": "object", "required": ["code", "message"], "properties": { "code": { "type": "string" }, "message": { "type": "string" } } } } }, "example": { "error": { "code": "session_busy", "message": "Session already has an active run" } } } } } },
    "schemas": {
      "Id": { "type": "string", "minLength": 1, "maxLength": 256 },
      "RunInput": { "type": "object", "additionalProperties": false, "required": ["sessionId", "text"], "properties": {
        "sessionId": { "$ref": "#/components/schemas/Id" }, "text": { "type": "string", "minLength": 1, "maxLength": 128000, "description": "Must contain non-whitespace text" }, "model": { "$ref": "#/components/schemas/Id" }, "modelProviderId": { "$ref": "#/components/schemas/Id" }, "mode": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" }, "thinking": { "type": "string", "enum": ["auto", "off", "minimal", "low", "medium", "high", "higher", "max"] }, "permissionMode": { "type": "string", "enum": ["ask", "auto", "full"] }, "webSearch": { "type": "boolean" }
      } },
      "Workspace": { "type": "object", "required": ["id", "name", "rootPath", "settings"], "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "rootPath": { "type": "string" }, "settings": { "type": "object", "additionalProperties": true } } },
      "SessionListItem": { "type": "object", "required": ["id", "title", "running", "updatedAt"], "properties": { "id": { "type": "string" }, "title": { "type": "string" }, "running": { "type": "boolean" }, "updatedAt": { "type": "integer" } } },
      "Session": { "type": "object", "required": ["id", "workspaceId", "title", "model", "mode", "thinking"], "properties": { "id": { "type": "string" }, "workspaceId": { "type": "string" }, "title": { "type": "string" }, "model": { "type": "string" }, "modelProviderId": { "type": "string" }, "mode": { "type": "string" }, "thinking": { "type": "string" } } },
      "AgentMessage": { "type": "object", "required": ["id", "role", "parts"], "properties": { "id": { "type": "string" }, "role": { "type": "string", "enum": ["user", "assistant", "system"] }, "parts": { "type": "array", "items": { "type": "object", "required": ["type"], "properties": { "type": { "type": "string" }, "text": { "type": "string" } }, "additionalProperties": true }, "description": "ContentPart union from src/shared/agent/message.ts; includes text, thinking, images, files and tool calls/results" } } },
      "GatewayStatus": { "type": "object", "required": ["enabled", "port", "host", "hasKey", "failover", "health"], "properties": { "enabled": { "type": "boolean" }, "port": { "type": "integer", "nullable": true }, "host": { "type": "string", "enum": ["127.0.0.1", "0.0.0.0"] }, "hasKey": { "type": "boolean" }, "failover": { "type": "boolean" }, "health": { "type": "array", "items": { "type": "object", "additionalProperties": true } }, "error": { "type": "string" } } },
      "RunSnapshot": { "type": "object", "required": ["runId", "sessionId", "workspaceId", "status", "seq", "events", "pendingInteractions", "children"], "properties": { "runId": { "type": "string" }, "sessionId": { "type": "string" }, "workspaceId": { "type": "string" }, "status": { "type": "string", "enum": ["running", "done", "error", "aborted"] }, "seq": { "type": "integer" }, "events": { "type": "array", "items": { "type": "object", "required": ["type"], "properties": { "type": { "type": "string" } }, "additionalProperties": true }, "description": "AgentEvent union from src/shared/agent/event.ts, including stream, message_commit, tool_start/end, interaction_request/resolved, subagent_start/end and run_end" }, "pendingInteractions": { "type": "array", "items": { "$ref": "#/components/schemas/PendingInteraction" } }, "children": { "type": "array", "items": { "type": "string" } } } },
      "PendingInteraction": { "type": "object", "required": ["id", "runId", "kind", "createdAt"], "properties": { "id": { "type": "string" }, "runId": { "type": "string" }, "kind": { "type": "string", "enum": ["tool_permission", "ask_user", "plan_approval", "goal_proposal"] }, "createdAt": { "type": "integer" }, "questions": { "type": "array", "items": { "type": "object", "additionalProperties": true } } }, "additionalProperties": true },
      "InteractionResponse": { "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind", "decision"], "properties": { "kind": { "type": "string", "enum": ["tool_permission"] }, "decision": { "oneOf": [
          { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "type": "string", "enum": ["allow_once"] } } },
          { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "type": "string", "enum": ["deny"] }, "reason": { "type": "string", "maxLength": 32768 } } },
          { "type": "object", "additionalProperties": false, "required": ["kind", "scope"], "properties": { "kind": { "type": "string", "enum": ["allow_always"] }, "scope": { "type": "string", "enum": ["workspace"] } } }
        ] } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "answers"], "properties": { "kind": { "type": "string", "enum": ["ask_user"] }, "answers": { "type": "array", "nullable": true, "maxItems": 100, "items": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 32768 } } } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "action"], "properties": { "kind": { "type": "string", "enum": ["plan_approval"] }, "action": { "type": "string", "enum": ["approve_current", "approve_new_session", "request_revision", "reject"] }, "feedback": { "type": "string", "maxLength": 32768 } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "approved"], "properties": { "kind": { "type": "string", "enum": ["goal_proposal"] }, "approved": { "type": "boolean" } } }
      ] }
    }
  }
}
